<!-- Modal Thanh toán QR -->
<div class="modal fade" id="modalQrPayment" tabindex="-1" role="dialog" aria-labelledby="modalQrPaymentLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 500px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <!-- Custom Styles for Glassmorphism & Tabs -->
            <style>
                .qr-modal-header {
                    background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
                    color: white;
                    border: none;
                    position: relative;
                }
                .qr-modal-header .close {
                    color: white;
                    text-shadow: none;
                    opacity: 0.8;
                }
                .qr-modal-header .close:hover {
                    opacity: 1;
                }
                .qr-tab-nav {
                    border-bottom: 2px solid #eaecf4;
                }
                .qr-tab-link {
                    border: none !important;
                    font-weight: 700;
                    color: #858796;
                    padding: 12px 20px;
                    position: relative;
                    transition: all 0.2s ease;
                }
                .qr-tab-link.active {
                    color: #1cc88a !important;
                    background: transparent !important;
                }
                .qr-tab-link.active::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    left: 0;
                    right: 0;
                    height: 2px;
                    background-color: #1cc88a;
                    border-radius: 2px;
                }
                .qr-box {
                    border: 1px solid #e3e6f0;
                    border-radius: 15px;
                    padding: 15px;
                    background: #f8f9fc;
                    box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
                }
                .qr-info-item {
                    display: flex;
                    justify-content: space-between;
                    margin-bottom: 8px;
                    font-size: 0.9rem;
                    border-bottom: 1px dashed #e3e6f0;
                    padding-bottom: 6px;
                }
                .qr-info-item:last-child {
                    border-bottom: none;
                    margin-bottom: 0;
                    padding-bottom: 0;
                }
                .qr-info-label {
                    color: #858796;
                    font-weight: 500;
                }
                .qr-info-value {
                    color: #2e59d9;
                    font-weight: 700;
                }
                .pulse-green {
                    box-shadow: 0 0 0 0 rgba(28, 200, 138, 0.7);
                    animation: pulse 1.5s infinite;
                }
                @@keyframes pulse {
                    0% {
                        transform: scale(0.98);
                        box-shadow: 0 0 0 0 rgba(28, 200, 138, 0.4);
                    }
                    70% {
                        transform: scale(1);
                        box-shadow: 0 0 0 10px rgba(28, 200, 138, 0);
                    }
                    100% {
                        transform: scale(0.98);
                        box-shadow: 0 0 0 0 rgba(28, 200, 138, 0);
                    }
                }
                /* Success Screen overlay */
                .payment-success-overlay {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: white;
                    display: none;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    z-index: 1051;
                    animation: fadeIn 0.4s ease forwards;
                }
                .success-checkmark {
                    width: 80px;
                    height: 80px;
                    margin: 0 auto;
                }
                .check-icon {
                    width: 80px;
                    height: 80px;
                    position: relative;
                    border-radius: 50%;
                    box-sizing: content-box;
                    border: 4px solid #4CAF50;
                }
                .check-icon::before {
                    top: 3px;
                    left: -2px;
                    width: 30px;
                    transform-origin: 100% 50%;
                    border-radius: 100px 0 0 100px;
                }
                .check-icon::after {
                    top: 0;
                    left: 30px;
                    width: 60px;
                    transform-origin: 0 50%;
                    border-radius: 0 100px 100px 0;
                    animation: rotate-circle 4.25s ease-in;
                }
                .check-icon::before, .check-icon::after {
                    content: '';
                    height: 100px;
                    position: absolute;
                    background: #FFFFFF;
                    transform: rotate(-45deg);
                }
                .icon-line {
                    height: 5px;
                    background-color: #4CAF50;
                    display: block;
                    border-radius: 2px;
                    position: absolute;
                    z-index: 10;
                }
                .icon-line.line-tip {
                    top: 46px;
                    left: 14px;
                    width: 25px;
                    transform: rotate(45deg);
                    animation: icon-line-tip 0.75s;
                }
                .icon-line.line-long {
                    top: 38px;
                    right: 8px;
                    width: 47px;
                    transform: rotate(-45deg);
                    animation: icon-line-long 0.75s;
                }
                .icon-circle {
                    top: -4px;
                    left: -4px;
                    z-index: 10;
                    width: 80px;
                    height: 80px;
                    border-radius: 50%;
                    border: 4px solid rgba(76, 175, 80, 0.5);
                    box-sizing: content-box;
                    position: absolute;
                }
                .icon-fix {
                    top: 8px;
                    left: 28px;
                    z-index: 1;
                    width: 5px;
                    height: 85px;
                    position: absolute;
                    transform: rotate(-45deg);
                    background-color: #FFFFFF;
                }
                @@keyframes rotate-circle {
                    0% { transform: rotate(-45deg); }
                    5% { transform: rotate(-45deg); }
                    12% { transform: rotate(-405deg); }
                    100% { transform: rotate(-405deg); }
                }
                @@keyframes icon-line-tip {
                    0% { width: 0; left: 1px; top: 19px; }
                    54% { width: 0; left: 1px; top: 19px; }
                    70% { width: 50px; left: -8px; top: 37px; }
                    84% { width: 17px; left: 21px; top: 48px; }
                    100% { width: 25px; left: 14px; top: 46px; }
                }
                @@keyframes icon-line-long {
                    0% { width: 0; right: 46px; top: 54px; }
                    65% { width: 0; right: 46px; top: 54px; }
                    84% { width: 55px; right: 0px; top: 35px; }
                    100% { width: 47px; right: 8px; top: 38px; }
                }
                @@keyframes fadeIn {
                    from { opacity: 0; }
                    to { opacity: 1; }
                }
            </style>

            <div class="qr-modal-header modal-header py-3 px-4 d-flex align-items-center">
                <h5 class="modal-title font-weight-bold text-white" id="modalQrPaymentLabel">
                    <i class="fas fa-qrcode mr-2"></i>Thanh toán QR Phòng khám
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" id="btn-close-qr-modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body p-0 position-relative">
                <!-- Success screen overlay -->
                <div class="payment-success-overlay" id="paymentSuccessScreen">
                    <div class="success-checkmark">
                        <div class="check-icon">
                            <span class="icon-line line-tip"></span>
                            <span class="icon-line line-long"></span>
                            <div class="icon-circle"></div>
                            <div class="icon-fix"></div>
                        </div>
                    </div>
                    <h4 class="font-weight-bold text-success mt-4 mb-2">Thanh toán thành công!</h4>
                    <p class="text-muted text-center px-4" id="successScreenMessage">Hóa đơn đã được xác nhận. Đang đồng bộ hóa dịch vụ cận lâm sàng...</p>
                </div>

                <!-- Tabs header -->
                <ul class="nav nav-tabs qr-tab-nav d-flex justify-content-center bg-light" id="qrTabs" role="tablist">
                    <li class="nav-item flex-fill text-center m-0" role="presentation">
                        <a class="nav-link qr-tab-link active" id="bank-tab" data-toggle="tab" href="#bankPay" role="tab" aria-controls="bankPay" aria-selected="true">
                            <i class="fas fa-university mr-2"></i>VietQR Chuyển khoản
                        </a>
                    </li>
                    <li class="nav-item flex-fill text-center m-0" role="presentation">
                        <a class="nav-link qr-tab-link" id="vnpay-tab" data-toggle="tab" href="#vnpayPay" role="tab" aria-controls="vnpayPay" aria-selected="false">
                            <i class="fas fa-wallet mr-2"></i>VNPay QR
                        </a>
                    </li>
                </ul>

                <!-- Tabs content -->
                <div class="tab-content p-4" id="qrTabsContent">
                    <!-- Tab 1: VietQR -->
                    <div class="tab-pane fade show active" id="bankPay" role="tabpanel" aria-labelledby="bank-tab">
                        <div class="text-center mb-4">
                            <div class="d-inline-block p-2 bg-white rounded shadow-sm border mb-2">
                                <img id="vietqr-image" src="" alt="Mã QR Chuyển khoản" style="max-width: 220px; height: auto;" class="img-fluid">
                            </div>
                            <p class="text-muted small mb-0"><i class="fas fa-mobile-alt mr-1"></i> Quét bằng ứng dụng ngân hàng của bệnh nhân</p>
                        </div>

                        <div class="qr-box mb-4">
                            <div class="qr-info-item">
                                <span class="qr-info-label">Ngân hàng:</span>
                                <span class="qr-info-value" style="color: #4e73df;">MB Bank (Ngân hàng Quân Đội)</span>
                            </div>
                            <div class="qr-info-item">
                                <span class="qr-info-label">Số tài khoản:</span>
                                <span class="qr-info-value" style="color: #2c9faf;">0305040266666</span>
                            </div>
                            <div class="qr-info-item">
                                <span class="qr-info-label">Tên thụ hưởng:</span>
                                <span class="qr-info-value text-uppercase" style="color: #36b9cc;">Bệnh viện Đại học VinhUni</span>
                            </div>
                            <div class="qr-info-item">
                                <span class="qr-info-label">Số tiền:</span>
                                <span class="qr-info-value text-danger" id="vietqr-amount-text">0 VNĐ</span>
                            </div>
                            <div class="qr-info-item">
                                <span class="qr-info-label">Nội dung chuyển khoản:</span>
                                <span class="qr-info-value text-dark" id="vietqr-memo-text">THANH TOAN HOA DON #</span>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="button" class="btn btn-success font-weight-bold btn-block py-2.5 shadow-sm pulse-green" id="btnConfirmBankTransfer">
                                <i class="fas fa-check-circle mr-1"></i> Bác sĩ xác nhận đã nhận tiền
                            </button>
                        </div>
                    </div>

                    <!-- Tab 2: VNPay -->
                    <div class="tab-pane fade" id="vnpayPay" role="tabpanel" aria-labelledby="vnpay-tab">
                        <div class="text-center mb-4">
                            <div id="vnpay-loading" class="my-5 text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="sr-only">Đang tạo liên kết thanh toán...</span>
                                </div>
                                <p class="text-muted mt-2 small">Đang tạo mã thanh toán VNPay...</p>
                            </div>
                            <div id="vnpay-qr-container" style="display: none;">
                                <div class="d-inline-block p-2 bg-white rounded shadow-sm border mb-2">
                                    <img id="vnpay-qr-image" src="" alt="Mã QR VNPay" style="max-width: 220px; height: auto;" class="img-fluid">
                                </div>
                                <p class="text-muted small mb-0"><i class="fas fa-qrcode mr-1"></i> Quét bằng ứng dụng Ngân hàng hoặc Ví VNPay</p>
                            </div>
                        </div>

                        <div class="qr-box mb-3 text-center py-3 bg-light border-0">
                            <span class="d-block text-muted small font-weight-bold uppercase mb-1">Tổng tiền thanh toán</span>
                            <h3 class="text-danger font-weight-bold mb-0" id="vnpay-amount-text">0 VNĐ</h3>
                        </div>
                        
                        <div class="alert alert-info py-2.5 px-3 mb-0" style="border-radius: 10px; border-left: 4px solid #36b9cc;">
                            <small class="d-block font-weight-bold text-info"><i class="fas fa-info-circle mr-1"></i> Hệ thống tự động đồng bộ</small>
                            <small class="text-muted d-block mt-0.5" style="line-height: 1.4;">Hệ thống đang kiểm tra trạng thái thanh toán tự động mỗi 3 giây. Sau khi bệnh nhân quét và thanh toán thành công, màn hình này sẽ tự động đóng và kích hoạt cận lâm sàng.</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer bg-light py-2 px-4 border-top" id="qr-modal-footer">
                <button type="button" class="btn btn-secondary font-weight-bold btn-sm shadow-sm" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                placeholder: "-- Tìm mã ICD-10 --",
                allowClear: true,
                width: '100%'
            });
            
            $('.select2-modal').each(function() {
                $(this).select2({
                    width: '100%',
                    dropdownParent: $(this).closest('.modal')
                });
            });

            // Logic for Inpatient Admission Fields toggle
            function toggleInpatientFields() {
                var selectedVal = $('#RecordType').val();
                if (selectedVal === 'Nhập viện') {
                    $('#inpatientAdmissionContainer').slideDown(300);
                    $('#TargetDeptId').prop('required', true);
                    $('#btn-submit-record').html('<i class="fas fa-paper-plane mr-2"></i> Gửi Yêu Cầu Nhập Viện');
                    $('#btn-submit-record').removeClass('btn-primary').addClass('btn-info');
                    $('#btn-print-admission').show();
                } else {
                    $('#inpatientAdmissionContainer').slideUp(300);
                    $('#TargetDeptId').prop('required', false);
                    $('#btn-submit-record').html('<i class="fas fa-save mr-2"></i> Lưu Bệnh Án');
                    $('#btn-submit-record').removeClass('btn-info').addClass('btn-primary');
                    $('#btn-print-admission').hide();
                }
            }

            // Run on load to set initial state
            toggleInpatientFields();

            // Run on change
            $('#RecordType').on('change', function() {
                toggleInpatientFields();
            });

            // JavaScript for Edit Record Service Modal
            $('.btn-edit-rs').on('click', function() {
                var rsId = $(this).data('rsid');
                var serviceId = $(this).data('serviceid');
                var note = $(this).data('note');

                $('#edit-rsId').val(rsId);
                $('#edit-ServiceId').val(serviceId).trigger('change');
                $('#edit-Note').val(note);
            });

            // JavaScript for QR Payment Modal
            var paymentPollInterval = null;
            var currentInvoiceId = null;

            $('.btn-qr-payment').on('click', function() {
                var invoiceId = $(this).data('invoice-id');
                var amount = $(this).data('patient-amount');
                var patientName = $(this).data('patient-name');
                currentInvoiceId = invoiceId;

                // Format amount to currency
                var formattedAmount = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);

                // Set text fields
                $('#vietqr-amount-text').text(formattedAmount);
                $('#vnpay-amount-text').text(formattedAmount);
                $('#vietqr-memo-text').text('THANH TOAN HOA DON #' + invoiceId);

                // Set VietQR image
                var vietQrUrl = 'https://img.vietqr.io/image/MBBank-0305040266666-compact.png?amount=' + amount + '&addInfo=THANH%20TOAN%20HOA%20DON%20' + invoiceId + '&accountName=BENH%20VIEN%20DAI%20HOC%20VINHUNI';
                $('#vietqr-image').attr('src', vietQrUrl);

                // Reset VNPay tab
                $('#vnpay-qr-container').hide();
                $('#vnpay-loading').show();
                $('#vnpay-qr-image').attr('src', '');

                // Reset success screen
                $('#paymentSuccessScreen').hide();
                $('#btn-close-qr-modal').show();
                $('#qr-modal-footer').show();

                // Open Modal
                $('#modalQrPayment').modal('show');
            });

            // Handle VNPay tab active to load VNPay QR Code
            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var targetTabId = $(e.target).attr('id');
                if (targetTabId === 'vnpay-tab' && currentInvoiceId) {
                    if ($('#vnpay-qr-image').attr('src') === '') {
                        $.ajax({
                            url: '/Admin/DoctorWorkspace/GenerateVnpayQrCode',
                            type: 'GET',
                            data: { invoiceId: currentInvoiceId },
                            success: function(data) {
                                if (data.success) {
                                    var vnpayQrUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=' + encodeURIComponent(data.paymentUrl);
                                    $('#vnpay-qr-image').attr('src', vnpayQrUrl);
                                    $('#vnpay-loading').hide();
                                    $('#vnpay-qr-container').show();
                                } else {
                                    alert('Lỗi tạo mã VNPay: ' + data.message);
                                }
                            },
                            error: function() {
                                alert('Không thể kết nối đến máy chủ để tạo mã VNPay.');
                            }
                        });
                    }
                }
            });

            // Start Polling when modal is opened
            $('#modalQrPayment').on('shown.bs.modal', function () {
                if (currentInvoiceId) {
                    startPaymentPolling(currentInvoiceId);
                }
            });

            // Stop Polling when modal is closed
            $('#modalQrPayment').on('hidden.bs.modal', function () {
                stopPaymentPolling();
            });

            // Confirm Bank Transfer manually
            $('#btnConfirmBankTransfer').on('click', function() {
                if (!currentInvoiceId) return;
                
                if (confirm('Bác sĩ xác nhận đã nhận được tiền chuyển khoản ngân hàng của bệnh nhân qua màn hình điện thoại?')) {
                    $('#btnConfirmBankTransfer').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang xác nhận...');
                    
                    $.ajax({
                        url: '/Admin/DoctorWorkspace/ConfirmBankTransferPayment',
                        type: 'POST',
                        data: { invoiceId: currentInvoiceId },
                        success: function(data) {
                            if (data.success) {
                                showPaymentSuccessScreen("Xác nhận chuyển khoản thành công! Trang sẽ tự động tải lại...");
                            } else {
                                alert('Lỗi xác nhận: ' + data.message);
                                $('#btnConfirmBankTransfer').prop('disabled', false).html('<i class="fas fa-check-circle mr-1"></i> Bác sĩ xác nhận đã nhận tiền');
                            }
                        },
                        error: function() {
                            alert('Không thể kết nối đến máy chủ.');
                            $('#btnConfirmBankTransfer').prop('disabled', false).html('<i class="fas fa-check-circle mr-1"></i> Bác sĩ xác nhận đã nhận tiền');
                        }
                    });
                }
            });

            function startPaymentPolling(invoiceId) {
                stopPaymentPolling(); // Clear existing
                
                paymentPollInterval = setInterval(function() {
                    $.ajax({
                        url: '/Admin/DoctorWorkspace/CheckPaymentStatus',
                        type: 'GET',
                        data: { invoiceId: invoiceId },
                        success: function(data) {
                            if (data.isPaid) {
                                stopPaymentPolling();
                                var methodText = data.method ? " qua " + data.method : "";
                                showPaymentSuccessScreen("🎉 Đã nhận thanh toán thành công" + methodText + "! Đang tải lại bàn khám...");
                            }
                        }
                    });
                }, 3000); // Poll every 3 seconds
            }

            function stopPaymentPolling() {
                if (paymentPollInterval) {
                    clearInterval(paymentPollInterval);
                    paymentPollInterval = null;
                }
            }

            function showPaymentSuccessScreen(message) {
                $('#successScreenMessage').text(message);
                $('#paymentSuccessScreen').css('display', 'flex');
                $('#btn-close-qr-modal').hide();
                $('#qr-modal-footer').hide();
                
                setTimeout(function() {
                    location.reload();
                }, 2000);
            }

            // Xóa Đơn Thuốc
            $('.btn-delete-prescription').on('click', function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                if (confirm('Bạn có chắc chắn muốn xóa đơn thuốc này không? Số tiền thuốc sẽ được tự động hoàn trả trong hóa đơn.')) {
                    $('#delete-prescription-id').val(id);
                    $('#formDeletePrescription').submit();
                }
            });

            // Mở Modal Sửa Đơn Thuốc
            $('.btn-edit-prescription').on('click', function() {
                var prescriptionId = $(this).data('id');
                var details = $(this).data('details');
                
                $('#edit-PrescriptionId').val(prescriptionId);
                $('#medicine-list-edit').empty();
                
                if (details && details.length > 0) {
                    details.forEach(function(d) {
                        addEditMedicineRow(d.MedicineId, d.Quantity, d.Dosage);
                    });
                } else {
                    addEditMedicineRow();
                }
                
                $('#modalEditPrescription').modal('show');
            });
        });

        function addMedicineRow() {
            var firstRow = $('#medicine-list .medicine-row:first').clone();
            firstRow.find('input[type="number"]').val('1');
            firstRow.find('input[type="text"]').val('');
            
            // Remove select2 artifacts from clone
            var sel = firstRow.find('select');
            sel.removeClass('select2-hidden-accessible');
            sel.find('option:selected').removeAttr("selected");
            firstRow.find('.select2-container').remove();
            
            $('#medicine-list').append(firstRow);
            
            // Re-init select2 on the new row
            firstRow.find('select').select2({
                width: '100%',
                dropdownParent: $('#modalPrescription')
            });
        }

        function addEditMedicineRow(medicineId, quantity, dosage) {
            var template = $('#medicine-row-template').html();
            var newRow = $(template);
            
            if (medicineId) {
                newRow.find('.select-medicine-edit').val(medicineId);
            }
            if (quantity) {
                newRow.find('.input-quantity').val(quantity);
            }
            if (dosage) {
                newRow.find('.input-dosage').val(dosage);
            }
            
            $('#medicine-list-edit').append(newRow);
            
            // Khởi tạo Select2 cho dòng thuốc mới trong Modal Sửa
            newRow.find('.select-medicine-edit').select2({
                width: '100%',
                dropdownParent: $('#modalEditPrescription')
            });
        }

        function removeMedicineRow(btn) {
            var container = $(btn).closest('#medicine-list-edit');
            var rowCount = container.find('.medicine-row').length;
            if (rowCount > 1) {
                $(btn).closest('.medicine-row').remove();
            } else {
                alert('Phải có ít nhất một loại thuốc trong đơn!');
            }
        }

        function submitPatientHistory() {
            document.getElementById('hiddenPersonalHistory').value = document.getElementById('tempPersonalHistory').value;
            document.getElementById('hiddenFamilyHistory').value = document.getElementById('tempFamilyHistory').value;
            document.getElementById('formPatientHistory').submit();
        }
    </script>
}
