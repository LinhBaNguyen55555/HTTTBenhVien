@model HTTTBenhVien.Models.MedicalRecord
@{
    ViewData["Title"] = "Hồ sơ khám bệnh";
    var icdCodes = ViewBag.IcdCodes as List<HTTTBenhVien.Models.IcdDictionary>;
}

<!-- Select2 CSS for searchable dropdown -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .emr-container { font-family: 'Inter', sans-serif; }
    .panel-header {
        background-color: #4e73df;
        color: white;
        padding: 10px 15px;
        border-radius: 5px 5px 0 0;
        font-weight: bold;
    }
    .panel-body {
        border: 1px solid #e3e6f0;
        border-top: none;
        padding: 15px;
        border-radius: 0 0 5px 5px;
        background: #fff;
    }
    .vital-sign-input { width: 80px; display: inline-block; }
    .input-group-text { background-color: #f8f9fc; }
    .form-control:focus { border-color: #4e73df; box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25); }
    .select2-container .select2-selection--single { height: 38px !important; }
    .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 38px !important; }
    .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px !important; }
    .select2-container--open { z-index: 9999999 !important; }
    .select2-dropdown { z-index: 9999999 !important; }
</style>

<div class="container-fluid emr-container mb-5">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-medical text-primary mr-2"></i> Hồ sơ khám bệnh</h1>
        <a href="@Url.Action("Index", "DoctorWorkspace", new { area = "Admin" })" class="btn btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại Danh sách
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <form asp-action="SaveRecord" asp-controller="DoctorWorkspace" asp-area="Admin" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RecordId" />
        <input type="hidden" asp-for="PatientId" />
        <input type="hidden" asp-for="DoctorId" />
        <input type="hidden" asp-for="AppointmentId" />

        <div class="row">
            <!-- Cột trái: Thông tin hành chính & Sinh hiệu -->
            <div class="col-xl-3 col-lg-4">
                <div class="card shadow mb-4">
                    <div class="panel-header bg-gradient-primary">
                        <i class="fas fa-user-injured mr-1"></i> Thông tin Bệnh nhân
                    </div>
                    <div class="panel-body">
                        <div class="text-center mb-3">
                            <i class="fas fa-user-circle fa-4x text-gray-300"></i>
                            <h5 class="mt-2 font-weight-bold text-primary">@Model.Patient?.FullName</h5>
                            <span class="badge @(Model.Patient?.Gender == true ? "badge-info" : "badge-danger") p-2">
                                @(Model.Patient?.Gender == true ? "Nam" : "Nữ")
                            </span>
                        </div>
                        <hr />
                        <div class="mb-2"><strong>Mã BN:</strong> @Model.PatientId</div>
                        <div class="mb-2"><strong>Ngày sinh:</strong> @(Model.Patient?.Dob?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                        <div class="mb-2"><strong>SĐT:</strong> @Model.Patient?.Phone</div>
                        <div class="mb-2"><strong>Địa chỉ:</strong> @(string.IsNullOrEmpty(Model.Patient?.Address) ? "Chưa cập nhật" : Model.Patient.Address)</div>
                        <div class="mb-2"><strong>CCCD:</strong> @(string.IsNullOrEmpty(Model.Patient?.CitizenId) ? "Chưa cập nhật" : Model.Patient.CitizenId)</div>
                        <div class="mb-2"><strong>Nghề nghiệp:</strong> @(string.IsNullOrEmpty(Model.Patient?.Occupation) ? "Chưa cập nhật" : Model.Patient.Occupation)</div>
                        <div class="mb-2"><strong>BHYT:</strong> @(string.IsNullOrEmpty(Model.Patient?.BhytCode) ? "Không có" : Model.Patient.BhytCode)</div>
                    </div>
                </div>

                <!-- Tiền sử bệnh (Bác sĩ khai thác & chỉnh sửa) -->
                <div class="card shadow mb-4">
                    <div class="panel-header" style="background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%);">
                        <i class="fas fa-history mr-1"></i> Tiền sử bệnh
                    </div>
                    <div class="panel-body">
                        <div class="form-group mb-3">
                            <label class="text-xs font-weight-bold text-danger text-uppercase">Tiền sử bệnh bản thân</label>
                            <textarea id="tempPersonalHistory" class="form-control form-control-sm" rows="3" 
                                placeholder="VD: Tăng huyết áp 5 năm, tiểu đường type 2...">@Model.Patient?.PersonalMedicalHistory</textarea>
                        </div>
                        <div class="form-group mb-3">
                            <label class="text-xs font-weight-bold text-danger text-uppercase">Tiền sử bệnh gia đình</label>
                            <textarea id="tempFamilyHistory" class="form-control form-control-sm" rows="3" 
                                placeholder="VD: Cha bị tiểu đường, Mẹ bị cao huyết áp...">@Model.Patient?.FamilyMedicalHistory</textarea>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-block shadow-sm" onclick="submitPatientHistory()">
                            <i class="fas fa-save mr-1"></i> Lưu tiền sử bệnh
                        </button>
                    </div>
                </div>

                <div class="card shadow mb-4">
                    <div class="panel-header bg-info">
                        <i class="fas fa-heartbeat mr-1"></i> Sinh hiệu (Vitals)
                    </div>
                    <div class="panel-body">
                        <div class="form-group mb-3">
                            <label class="text-xs font-weight-bold text-gray-800">Huyết áp (mmHg)</label>
                            <input asp-for="BloodPressure" class="form-control form-control-sm" placeholder="VD: 120/80" />
                        </div>
                        <div class="form-row">
                            <div class="form-group col-6 mb-3">
                                <label class="text-xs font-weight-bold text-gray-800">Mạch (lần/p)</label>
                                <input asp-for="PulseRate" class="form-control form-control-sm" placeholder="VD: 80" />
                            </div>
                            <div class="form-group col-6 mb-3">
                                <label class="text-xs font-weight-bold text-gray-800">Nhiệt độ (°C)</label>
                                <input asp-for="Temperature" class="form-control form-control-sm" placeholder="VD: 37.0" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-6 mb-3">
                                <label class="text-xs font-weight-bold text-gray-800">Chiều cao (cm)</label>
                                <input asp-for="Height" class="form-control form-control-sm" placeholder="VD: 170" />
                            </div>
                            <div class="form-group col-6 mb-3">
                                <label class="text-xs font-weight-bold text-gray-800">Cân nặng (kg)</label>
                                <input asp-for="Weight" class="form-control form-control-sm" placeholder="VD: 65" />
                            </div>
                        </div>
                        <div class="form-group mb-0">
                            <label class="text-xs font-weight-bold text-gray-800">SpO2 (%)</label>
                            <input asp-for="SpO2" class="form-control form-control-sm" placeholder="VD: 98" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột giữa: Ghi nhận Lâm sàng (SOAP) -->
            <div class="col-xl-9 col-lg-8">
                <div class="card shadow mb-4">
                    <div class="panel-header bg-dark">
                        <i class="fas fa-notes-medical mr-1"></i> Khám Lâm sàng & Chẩn đoán
                    </div>
                    <div class="panel-body p-4">
                        
                        <div class="form-group">
                            <label class="font-weight-bold text-dark">Lý do vào viện / Triệu chứng (Subjective)</label>
                            <textarea asp-for="Symptoms" class="form-control" rows="3" placeholder="Ghi nhận lời kể của bệnh nhân..."></textarea>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold text-dark">Khám thực thể (Objective)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi nhận quá trình thăm khám..."></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label class="font-weight-bold text-dark"><i class="fas fa-stethoscope text-primary mr-1"></i>Chẩn đoán (Diagnosis)</label>
                                    <input asp-for="Diagnosis" class="form-control" placeholder="Chẩn đoán bệnh..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="font-weight-bold text-dark"><i class="fas fa-book-medical text-primary mr-1"></i>Mã ICD-10</label>
                                    <select asp-for="IcdCode" class="form-control select2">
                                        <option value="">-- Chọn mã ICD --</option>
                                        @if (icdCodes != null)
                                        {
                                            foreach (var icd in icdCodes)
                                            {
                                                <option value="@icd.IcdCode">[@icd.IcdCode] @icd.DiseaseName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="font-weight-bold text-dark"><i class="fas fa-procedures text-primary mr-1"></i>Hướng xử lý / Loại bệnh án</label>
                                    <select asp-for="RecordType" class="form-control font-weight-bold text-primary">
                                        <option value="Khám ngoại trú">Khám ngoại trú (Cho về kê đơn)</option>
                                        <option value="Nhập viện">Nhập viện (Điều trị nội trú)</option>
                                        <option value="Tái khám">Hẹn tái khám</option>
                                        <option value="Cấp cứu">Cấp cứu chuyển khoa</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Khối phụ khi chọn Nhập viện -->
                        <div id="inpatientAdmissionContainer" class="card p-3 mb-3 border-left-info shadow-sm" style="display: none; background-color: #f0f9ff; border-radius: 8px;">
                            <h6 class="font-weight-bold text-info"><i class="fas fa-hospital-user mr-2"></i> Chỉ định nhập viện điều trị nội trú</h6>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-dark"><i class="fas fa-hospital mr-1"></i>Khoa nội trú tiếp nhận</label>
                                        <select asp-for="TargetDeptId" class="form-control font-weight-bold text-info" asp-items="@(new SelectList(ViewBag.ClinicalDepartments, "DeptId", "DeptName"))">
                                            <option value="">-- Chọn khoa tiếp nhận --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-dark"><i class="fas fa-comment-medical mr-1"></i>Lý do nhập viện / Lời dặn chi tiết</label>
                                        <input asp-for="AdmissionNotes" class="form-control" placeholder="Ví dụ: Theo dõi suy ruột thừa cấp, nghỉ ngơi tĩnh dưỡng..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold text-dark">Kết luận / Hướng xử lý (Plan)</label>
                            <textarea asp-for="Conclusion" class="form-control" rows="2" placeholder="Kê đơn, cho về, hoặc nhập viện..."></textarea>
                        </div>

                        <hr class="mt-4 mb-4" />

                        <div class="d-flex justify-content-end align-items-center">
                            @if (Model.RecordId > 0)
                            {
                                <a id="btn-print-admission" href="@Url.Action("PrintAdmissionSlip", "DoctorWorkspace", new { recordId = Model.RecordId })" target="_blank" class="btn btn-info btn-lg shadow-sm mr-3 px-4" style="border-radius: 30px; @(Model.RecordType == "Nhập viện" ? "" : "display: none;")">
                                    <i class="fas fa-print mr-2"></i> In Giấy Nhập Viện
                                </a>
                            }
                            <button type="submit" id="btn-submit-record" class="btn btn-primary btn-lg shadow-sm px-5" style="border-radius: 30px;">
                                <i class="fas fa-save mr-2"></i> Lưu Bệnh Án
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Bảng Kê đơn / Dịch vụ -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="card shadow mb-4 border-left-success">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-prescription-bottle-alt mr-2"></i>Đơn thuốc</h6>
                                @if (Model.RecordId > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success shadow-sm" data-toggle="modal" data-target="#modalPrescription"><i class="fas fa-plus"></i> Kê đơn</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Lưu bệnh án trước khi kê đơn"><i class="fas fa-plus"></i> Kê đơn</button>
                                }
                            </div>
                            <div class="card-body p-0">
                                @if (Model.RecordId > 0 && Model.Prescriptions != null && Model.Prescriptions.Any())
                                {
                                    <div class="list-group list-group-flush">
                                    @foreach (var p in Model.Prescriptions)
                                    {
                                        var detailsJson = Newtonsoft.Json.JsonConvert.SerializeObject(p.PrescriptionDetails.Select(d => new {
                                            d.MedicineId,
                                            MedicineName = d.Medicine != null ? d.Medicine.MedicineName : "",
                                            d.Quantity,
                                            d.Dosage
                                        }));
                                        <div class="list-group-item">
                                            <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="mb-0 font-weight-bold text-dark"><i class="fas fa-file-prescription text-success mr-1"></i>Đơn thuốc #@p.PrescriptionId</h6>
                                                    <small class="text-muted"><i class="far fa-clock mr-1"></i>@p.CreateDate?.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                                <div class="btn-group shadow-sm">
                                                    <a href="@Url.Action("PrintPrescription", "PharmacyWorkspace", new { id = p.PrescriptionId, area = "Admin" })" target="_blank" class="btn btn-sm btn-outline-primary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" title="In đơn thuốc">
                                                        <i class="fas fa-print mr-1"></i>In
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-warning btn-edit-prescription" 
                                                            data-id="@p.PrescriptionId" 
                                                            data-details='@Html.Raw(detailsJson)' 
                                                            style="padding: 0.25rem 0.5rem; font-size: 0.75rem;"
                                                            title="Sửa đơn thuốc">
                                                        <i class="fas fa-edit mr-1"></i>Sửa
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete-prescription" 
                                                            data-id="@p.PrescriptionId" 
                                                            style="padding: 0.25rem 0.5rem; font-size: 0.75rem;"
                                                            title="Xóa đơn thuốc">
                                                        <i class="fas fa-trash mr-1"></i>Xóa
                                                    </button>
                                                </div>
                                            </div>
                                            <ul class="pl-3 mb-0 text-sm text-secondary">
                                            @if (p.PrescriptionDetails != null)
                                            {
                                                foreach (var d in p.PrescriptionDetails)
                                                {
                                                    <li><strong>@d.Medicine?.MedicineName</strong> - SL: @d.Quantity - Liều: @d.Dosage</li>
                                                }
                                            }
                                            </ul>
                                        </div>
                                    }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center p-4">
                                        <p class="text-muted mb-0">Chưa có đơn thuốc nào.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow mb-4 border-left-warning">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white border-bottom">
                                <h6 class="m-0 font-weight-bold text-warning"><i class="fas fa-vials mr-2"></i>Chỉ định Cận lâm sàng</h6>
                                <div>
                                    @if (Model.RecordId > 0)
                                    {
                                        var isDraft = Model.Invoice == null || Model.Invoice.Status == "ChuaChot";
                                        var isConfirmed = Model.Invoice != null && (Model.Invoice.Status == "ChuaThanhToan" || Model.Invoice.Status == "Chưa thanh toán" || Model.Invoice.Status == "Pending" || Model.Invoice.Status == "Mới" || Model.Invoice.Status == "New" || Model.Invoice.Status == "Unpaid");
                                        var isPaid = Model.Invoice != null && (Model.Invoice.Status == "DaThanhToan" || Model.Invoice.Status == "Đã thanh toán" || Model.Invoice.Status == "Paid" || Model.Invoice.Status == "Hoàn thành" || Model.Invoice.Status == "Completed");

                                        if (isDraft)
                                        {
                                            <button type="button" class="btn btn-sm btn-warning font-weight-bold shadow-sm" data-toggle="modal" data-target="#modalRecordService">
                                                <i class="fas fa-plus-circle mr-1"></i> Chỉ định
                                            </button>
                                            
                                            @if (Model.RecordServices != null && Model.RecordServices.Any())
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success font-weight-bold shadow-sm ml-1" onclick="if(confirm('Bạn có chắc chắn muốn chốt chỉ định cận lâm sàng? Sau khi chốt, bác sĩ không thể tự chỉnh sửa/xóa và hóa đơn sẽ hiển thị ở quầy thu ngân.')) { document.getElementById('formConfirmRecordServices').submit(); }"><i class="fas fa-lock mr-1"></i> Chốt chỉ định</button>
                                            }
                                        }
                                        else if (isConfirmed)
                                        {
                                            <span class="badge badge-info px-2.5 py-1.5 mr-1 text-uppercase font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-lock mr-1"></i> Đã chốt chỉ định</span>
                                            
                                            <button type="button" class="btn btn-sm btn-outline-secondary font-weight-bold shadow-sm mr-1" title="Mở khóa chốt chỉ định" onclick="if(confirm('Bạn có chắc chắn muốn mở chốt chỉ định cận lâm sàng? Hóa đơn sẽ tạm thời bị ẩn khỏi quầy thu ngân để bạn chỉnh sửa.')) { document.getElementById('formUnlockRecordServices').submit(); }"><i class="fas fa-unlock-alt mr-1"></i> Mở chốt</button>
                                            
                                            <button type="button" class="btn btn-sm btn-success font-weight-bold shadow-sm mr-1 btn-qr-payment" 
                                                    data-invoice-id="@Model.Invoice.InvoiceId" 
                                                    data-patient-amount="@(Model.Invoice.PatientAmount ?? Model.Invoice.TotalAmount ?? 0)" 
                                                    data-patient-name="@Model.Patient?.FullName"
                                                    title="Thanh toán QR Code (VietQR / VNPay)">
                                                <i class="fas fa-qrcode mr-1"></i> Thanh toán QR
                                            </button>
                                            
                                            <a href="@Url.Action("PrintRequisition", "DoctorWorkspace", new { recordId = Model.RecordId })" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm mr-1" title="In phiếu chỉ định"><i class="fas fa-print mr-1"></i> In phiếu chỉ định</a>
                                            
                                            <a href="@Url.Action("PrintInvoice", "CashierWorkspace", new { id = Model.Invoice.InvoiceId, area = "Admin" })" target="_blank" class="btn btn-sm btn-outline-success shadow-sm" title="In hóa đơn báo thu tiền"><i class="fas fa-file-invoice-dollar mr-1"></i> In hóa đơn</a>
                                        }
                                        else if (isPaid)
                                        {
                                            <span class="badge badge-success px-2.5 py-1.5 mr-1 text-uppercase font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-check-double mr-1"></i> Đã thanh toán</span>
                                            
                                            <a href="@Url.Action("PrintRequisition", "DoctorWorkspace", new { recordId = Model.RecordId })" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm" title="In phiếu chỉ định"><i class="fas fa-print mr-1"></i> In phiếu chỉ định</a>
                                            
                                            <a href="@Url.Action("PrintInvoice", "CashierWorkspace", new { id = Model.Invoice.InvoiceId, area = "Admin" })" target="_blank" class="btn btn-sm btn-outline-success shadow-sm ml-1" title="In biên lai thanh toán"><i class="fas fa-receipt mr-1"></i> In biên lai</a>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Lưu bệnh án trước khi chỉ định"><i class="fas fa-plus-circle mr-1"></i> Chỉ định</button>
                                    }
                                </div>
                            </div>
                            <div class="card-body p-0">
                                @if (Model.RecordId > 0 && Model.RecordServices != null && Model.RecordServices.Any())
                                {
                                    <div class="list-group list-group-flush">
                                    @foreach (var rs in Model.RecordServices)
                                    {
                                        bool isDone = rs.Status == "HoanThanh" || rs.Status == "Hoàn thành" || rs.Status == "Completed" || rs.Status == "Done";
                                        bool isProcessing = rs.Status == "DangThucHien" || rs.Status == "Đang thực hiện";
                                        <div class="list-group-item p-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-0 font-weight-bold text-dark" style="font-size: 0.95rem;"><i class="fas fa-microscope text-warning mr-2"></i>@rs.Service?.ServiceName</h6>
                                                    <small class="text-muted"><i class="far fa-clock mr-1"></i>Chỉ định: @(rs.ExecuteDate?.ToString("dd/MM/yyyy HH:mm") ?? "Hôm nay")</small>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    @if (isDone)
                                                    {
                                                        <span class="badge badge-success px-2.5 py-1.5 rounded"><i class="fas fa-check-circle mr-1"></i>Đã có kết quả</span>
                                                    }
                                                    else if (isProcessing)
                                                    {
                                                        <span class="badge badge-info px-2.5 py-1.5 rounded"><i class="fas fa-spinner fa-spin mr-1"></i>Đang làm...</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning px-2.5 py-1.5 rounded mr-2"><i class="fas fa-hourglass-half mr-1"></i>Chờ thực hiện</span>
                                                        @if (Model.Invoice == null || Model.Invoice.Status == "ChuaChot")
                                                        {
                                                            <!-- Nút Sửa -->
                                                            <button type="button" class="btn btn-sm btn-outline-primary mr-1 btn-edit-rs" 
                                                                    style="padding: 2px 6px;" 
                                                                    title="Sửa chỉ định cận lâm sàng"
                                                                    data-toggle="modal" 
                                                                    data-target="#modalEditRecordService"
                                                                    data-rsid="@rs.RsId" 
                                                                    data-serviceid="@rs.ServiceId" 
                                                                    data-note="@rs.ResultValue">
                                                                <i class="fas fa-pencil-alt"></i>
                                                            </button>

                                                            <!-- Nút Xóa -->
                                                            <button type="button" class="btn btn-sm btn-outline-danger" style="padding: 2px 6px;" title="Xóa chỉ định cận lâm sàng" onclick="if(confirm('Bạn có chắc chắn muốn xóa chỉ định này?')) { document.getElementById('delete-rsId').value = '@rs.RsId'; document.getElementById('formDeleteRecordService').submit(); }">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            
                                            @if (isDone)
                                            {
                                                <div class="mt-3 p-3 bg-light rounded border-left-success" style="border-left: 4px solid #1cc88a; font-size: 0.9rem;">
                                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1"><i class="fas fa-poll-h mr-1"></i>Kết quả cận lâm sàng:</div>
                                                    <div class="text-dark font-weight-bold" style="white-space: pre-line;">@rs.ResultValue</div>
                                                    
                                                    @if (!string.IsNullOrEmpty(rs.ResultImages))
                                                    {
                                                        <div class="mt-2">
                                                            <div class="text-xs font-weight-bold text-muted mb-1"><i class="far fa-image mr-1"></i>Hình ảnh/File đính kèm:</div>
                                                            @if (rs.ResultImages.StartsWith("http") || rs.ResultImages.Contains("/") || rs.ResultImages.Contains("\\"))
                                                            {
                                                                <a href="@rs.ResultImages" target="_blank" class="btn btn-xs btn-outline-primary"><i class="fas fa-external-link-alt mr-1"></i>Xem ảnh kết quả</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-dark font-weight-bold">@rs.ResultImages</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-2 text-xs text-muted bg-light p-2 rounded">
                                                    <i class="far fa-sticky-note mr-1"></i><strong>Yêu cầu khám/Ghi chú:</strong> <em>@(string.IsNullOrEmpty(rs.ResultValue) ? "Không có ghi chú thêm" : rs.ResultValue)</em>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center p-5 text-muted">
                                        <i class="fas fa-vial fa-2x mb-2 text-gray-300"></i>
                                        <p class="mb-0">Chưa có chỉ định cận lâm sàng nào.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
    </form>
</div>

