@model HTTTBenhVien.Models.MedicalSupply
@{
    ViewData["Title"] = "Thêm Vật tư Y tế";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
        <div class="card-header py-3" style="background: linear-gradient(135deg, #36d1dc 0%, #5b86e5 100%); color: white;">
            <h6 class="m-0 font-weight-bold"><i class="fas fa-plus-circle mr-2"></i>Thêm vật tư y tế mới</h6>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5 class="border-bottom pb-2 mb-4" style="color: #5b86e5;"><i class="fas fa-info-circle mr-2"></i>Thông tin vật tư</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="SupplyName" class="font-weight-bold">Tên vật tư <span class="text-danger">*</span></label>
                            <input asp-for="SupplyName" class="form-control" placeholder="VD: Bông gạc, Kim tiêm, Găng tay y tế..." required />
                            <span asp-validation-for="SupplyName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="Unit" class="font-weight-bold">Đơn vị tính</label>
                            <select asp-for="Unit" class="form-control">
                                <option value="">-- Chọn --</option>
                                <option value="Cái">Cái</option>
                                <option value="Hộp">Hộp</option>
                                <option value="Gói">Gói</option>
                                <option value="Cuộn">Cuộn</option>
                                <option value="Bộ">Bộ</option>
                                <option value="Chai">Chai</option>
                                <option value="Đôi">Đôi</option>
                                <option value="Chiếc">Chiếc</option>
                                <option value="Túi">Túi</option>
                                <option value="Thùng">Thùng</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="IsActive" class="font-weight-bold">Trạng thái</label>
                            <select asp-for="IsActive" class="form-control">
                                <option value="true">Còn sử dụng</option>
                                <option value="false">Ngừng nhập</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="UnitPrice" class="font-weight-bold">Đơn giá (VNĐ)</label>
                            <input asp-for="UnitPrice" type="number" step="100" min="0" class="form-control" placeholder="VD: 5000" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="StockQuantity" class="font-weight-bold">Số lượng tồn</label>
                            <input asp-for="StockQuantity" type="number" min="0" class="form-control" placeholder="VD: 100" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="ExpiryDate" class="font-weight-bold">Hạn sử dụng</label>
                            <input asp-for="ExpiryDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="Supplier" class="font-weight-bold">Nhà cung cấp</label>
                            <input asp-for="Supplier" class="form-control" placeholder="VD: Mediplantex..." />
                        </div>
                    </div>
                </div>

                <hr class="mt-4 mb-4" />
                <div class="text-center">
                    <button type="submit" class="btn px-5 py-2 mr-3" style="background: linear-gradient(135deg, #36d1dc 0%, #5b86e5 100%); border: none; color: white; font-weight: 600;">
                        <i class="fas fa-save mr-2"></i> Lưu vật tư
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-5 py-2">
                        <i class="fas fa-arrow-left mr-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
