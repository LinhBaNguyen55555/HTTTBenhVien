@model IEnumerable<HTTTBenhVien.Models.MedicalSupply>
@{
    ViewData["Title"] = "Quản lý Vật tư Y tế";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
        .card-ajax { border: none; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); overflow: hidden; }
    .card-header-ajax { background: white; border-bottom: 2px solid #f8f9fe; padding: 1.25rem 1.5rem; font-weight: 600; color: #5b86e5; }
    .btn-gradient { background: linear-gradient(135deg, #36d1dc 0%, #5b86e5 100%); border: none; color: white; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 0.5rem; transition: all 0.3s ease; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(91, 134, 229, 0.4); color: white; }
    .btn-gradient-info { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none; color: white; }
    .btn-gradient-danger { background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none; color: white; }
    .btn-sm-gradient { padding: 0.375rem 0.75rem; font-size: 0.875rem; border-radius: 0.375rem; }
    .table-ajax thead th { background: #f8f9fc; color: #5b86e5; font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; border: none; padding: 0.9rem; }
    .table-ajax tbody td { vertical-align: middle; padding: 0.9rem; border-color: #f0f2f8; }
    .table-ajax tbody tr:hover { background: #f0f7ff; }
    .empty-state { padding: 3rem; text-align: center; }
    .empty-state-icon { font-size: 4rem; color: #d1d3e0; margin-bottom: 1rem; }
    .stat-card { background: white; border-radius: 1rem; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1); }
    .stat-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-info h4 { font-weight: 700; margin: 0; color: #2d3748; font-size: 1.5rem; }
    .stat-info p { margin: 0; color: #a0aec0; font-size: 0.85rem; }
    .badge-stock { padding: 0.35rem 0.6rem; border-radius: 0.35rem; font-size: 0.75rem; font-weight: 600; }
    .price-tag { font-weight: 700; color: #5b86e5; }
    .supply-icon { width: 36px; height: 36px; border-radius: 0.5rem; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(54, 209, 220, 0.15) 0%, rgba(91, 134, 229, 0.15) 100%); color: #5b86e5; font-size: 0.9rem; }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <h1 class="h3 mb-4 text-gray-800 font-weight-bold">Danh sách vật tư y tế</h1>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(54, 209, 220, 0.15) 0%, rgba(91, 134, 229, 0.15) 100%); color: #5b86e5;"><i class="fas fa-boxes"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count()</h4>
                    <p>Tổng loại vật tư</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(17, 153, 142, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%); color: #11998e;"><i class="fas fa-check-circle"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(s => s.IsActive == true)</h4>
                    <p>Đang sử dụng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(246, 211, 101, 0.15) 0%, rgba(253, 160, 133, 0.15) 100%); color: #fda085;"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(s => s.StockQuantity > 0 && s.StockQuantity <= 20)</h4>
                    <p>Sắp hết</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(235, 51, 73, 0.15) 0%, rgba(244, 92, 67, 0.15) 100%); color: #eb3349;"><i class="fas fa-times-circle"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(s => s.StockQuantity == 0)</h4>
                    <p>Hết hàng</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ajax mb-4">
        <div class="card-header card-header-ajax d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list mr-2"></i>Danh sách vật tư</span>
            <div class="d-flex align-items-center">
                <form asp-action="Index" method="get" class="form-inline mr-3 mb-0">
                    <select name="stockFilter" class="form-control form-control-sm mr-2" style="border-radius: 20px;">
                        <option value="">Tất cả</option>
                        <option value="low" selected="@(ViewData["StockFilter"]?.ToString() == "low")">Sắp hết</option>
                        <option value="out" selected="@(ViewData["StockFilter"]?.ToString() == "out")">Hết hàng</option>
                        <option value="expired" selected="@(ViewData["StockFilter"]?.ToString() == "expired")">Hết hạn</option>
                    </select>
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tên vật tư, NCC..." style="border-radius: 20px 0 0 20px;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn" style="border-radius: 0 20px 20px 0; background: linear-gradient(135deg, #36d1dc 0%, #5b86e5 100%); border: none; color: white;"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </form>
                <a asp-action="Create" class="btn btn-sm btn-gradient">
                    <i class="fas fa-plus mr-1"></i> Thêm vật tư
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-ajax mb-0">
                        <thead>
                            <tr>
                                <th width="25%"><i class="fas fa-box mr-1"></i> Vật tư</th>
                                <th width="8%"><i class="fas fa-ruler mr-1"></i> ĐVT</th>
                                <th width="12%"><i class="fas fa-money-bill mr-1"></i> Đơn giá</th>
                                <th width="10%"><i class="fas fa-warehouse mr-1"></i> Tồn kho</th>
                                <th width="12%"><i class="fas fa-calendar mr-1"></i> Hạn SD</th>
                                <th width="13%"><i class="fas fa-truck mr-1"></i> NCC</th>
                                <th width="8%" class="text-center"><i class="fas fa-toggle-on mr-1"></i> TT</th>
                                <th width="12%" class="text-center"><i class="fas fa-cog mr-1"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="supply-icon mr-2"><i class="fas fa-box-open"></i></div>
                                            <strong class="text-dark" style="font-size: 0.88rem;">@item.SupplyName</strong>
                                        </div>
                                    </td>
                                    <td><span class="badge badge-light border font-weight-bold">@(string.IsNullOrEmpty(item.Unit) ? "—" : item.Unit)</span></td>
                                    <td><span class="price-tag">@((item.UnitPrice ?? 0).ToString("N0"))<small> đ</small></span></td>
                                    <td>
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="badge badge-danger badge-stock"><i class="fas fa-times-circle mr-1"></i>Hết</span>
                                        }
                                        else if (item.StockQuantity <= 20)
                                        {
                                            <span class="badge badge-warning badge-stock text-dark"><i class="fas fa-exclamation mr-1"></i>@item.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success badge-stock text-white"><i class="fas fa-check mr-1"></i>@item.StockQuantity</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ExpiryDate.HasValue)
                                        {
                                            var isExpired = item.ExpiryDate < DateTime.Now;
                                            <span class="@(isExpired ? "text-danger font-weight-bold" : "text-dark")" style="font-size: 0.85rem;">
                                                @(isExpired ? "⚠️ " : "")@item.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td><span class="text-muted" style="font-size: 0.85rem;">@(string.IsNullOrEmpty(item.Supplier) ? "—" : item.Supplier)</span></td>
                                    <td class="text-center">
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge badge-success badge-stock text-white">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary badge-stock">Ngừng</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Details" asp-route-id="@item.SupplyId" class="btn btn-sm btn-gradient-info btn-sm-gradient text-white" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                            <a asp-action="Edit" asp-route-id="@item.SupplyId" class="btn btn-sm btn-gradient btn-sm-gradient text-white" title="Sửa"><i class="fas fa-edit"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.SupplyId" class="btn btn-sm btn-gradient-danger btn-sm-gradient text-white" title="Xóa"><i class="fas fa-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-boxes empty-state-icon"></i>
                    <h5 class="text-muted font-weight-bold">Chưa có vật tư nào</h5>
                    <p class="text-muted mb-4">Thêm vật tư mới vào kho</p>
                    <a asp-action="Create" class="btn btn-gradient px-4"><i class="fas fa-plus mr-2"></i>Thêm vật tư</a>
                </div>
            }
        </div>
    </div>
</div>
