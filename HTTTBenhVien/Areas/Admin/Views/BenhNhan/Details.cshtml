@model HTTTBenhVien.Models.Patient
@{
    ViewData["Title"] = "Chi tiết bệnh nhân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Chi tiết bệnh nhân: @Model.FullName</h1>
    <div>
        <a href="@Url.Action("Edit", new { id = Model.PatientId })" class="btn btn-warning btn-sm shadow-sm">
            <i class="fas fa-edit fa-sm text-white-50"></i> Sửa
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Thông tin bệnh nhân</h6>
            </div>
            <div class="card-body text-center">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:100px;height:100px;font-size:36px;font-weight:700;">
                    @Model.FullName?.Substring(0, 1).ToUpper()
                </div>
                <h5 class="font-weight-bold">@Model.FullName</h5>
                <p class="text-muted">@Model.PatientCode</p>
                <hr />
                <div class="text-left">
                    <p><i class="fas fa-venus-mars mr-2 text-primary"></i> @(Model.Gender ?? "Chưa cập nhật")</p>
                    <p><i class="fas fa-birthday-cake mr-2 text-primary"></i> @(Model.Dob?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</p>
                    <p><i class="fas fa-phone mr-2 text-primary"></i> @(Model.Phone ?? "Chưa cập nhật")</p>
                    <p><i class="fas fa-envelope mr-2 text-primary"></i> @(Model.Email ?? "Chưa cập nhật")</p>
                    <p><i class="fas fa-map-marker-alt mr-2 text-primary"></i> @(Model.Address ?? "Chưa cập nhật")</p>
                    <p><i class="fas fa-shield-alt mr-2 text-primary"></i> @(Model.BhytCode ?? "Không có BHYT")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-calendar-check mr-1"></i> Lịch sử lịch hẹn</h6>
            </div>
            <div class="card-body">
                @{
                    var appointments = Model.Appointments?.OrderByDescending(a => a.AppDate).Take(10).ToList();
                    if (appointments != null && appointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Ngày khám</th>
                                        <th>Bác sĩ</th>
                                        <th>Giờ</th>
                                        <th>Lý do</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in appointments)
                                    {
                                        var statusClass = a.Status switch
                                        {
                                            "New" => "badge-secondary",
                                            "DaXacNhan" => "badge-info",
                                            "DangKham" => "badge-primary",
                                            "HoanThanh" => "badge-success",
                                            "Huy" => "badge-danger",
                                            _ => "badge-secondary"
                                        };
                                        var statusText = a.Status switch
                                        {
                                            "New" => "Mới",
                                            "DaXacNhan" => "Đã xác nhận",
                                            "DangKham" => "Đang khám",
                                            "HoanThanh" => "Hoàn thành",
                                            "Huy" => "Hủy",
                                            _ => a.Status
                                        };
                                        <tr>
                                            <td>@a.AppDate?.ToString("dd/MM/yyyy")</td>
                                            <td>@a.Doctor?.FullName</td>
                                            <td>@a.TimeSlot</td>
                                            <td class="text-truncate" style="max-width:150px;">@a.Reason</td>
                                            <td><span class="badge @statusClass">@statusText</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Chưa có lịch hẹn nào</p>
                    }
                }
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-file-medical mr-1"></i> Hồ sơ bệnh án</h6>
            </div>
            <div class="card-body">
                @{
                    var records = Model.MedicalRecords?.OrderByDescending(m => m.VisitDate).Take(10).ToList();
                    if (records != null && records.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Ngày khám</th>
                                        <th>Bác sĩ</th>
                                        <th>Chẩn đoán</th>
                                        <th>Loại</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in records)
                                    {
                                        <tr>
                                            <td>@r.VisitDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@r.Doctor?.FullName</td>
                                            <td>@r.IcdCodeNavigation?.DiseaseName</td>
                                            <td>@r.RecordType</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Chưa có hồ sơ bệnh án</p>
                    }
                }
            </div>
        </div>
    </div>
</div>
