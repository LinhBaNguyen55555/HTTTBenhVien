@model IEnumerable<HTTTBenhVien.Models.Appointment>
@{
    ViewData["Title"] = "Tiếp nhận khám";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <div>
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Tiếp nhận mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Lịch hẹn hôm nay</div>
                        <div class="h5 mb-0 font-weight-bold">@ViewBag.TodayCount</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-calendar-check fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Đã xác nhận</div>
                        <div class="h5 mb-0 font-weight-bold">@ViewBag.Confirmed</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-check-circle fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Hoàn thành</div>
                        <div class="h5 mb-0 font-weight-bold">@ViewBag.Completed</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-clipboard-check fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lịch hẹn hôm nay (@DateTime.Today.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN")))</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Giờ</th>
                        <th>Bệnh nhân</th>
                        <th>Bác sĩ</th>
                        <th>Lý do khám</th>
                        <th>Trạng thái</th>
                        <th width="140">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var a in Model)
                        {
                            var statusClass = a.Status switch
                            {
                                "New" => "badge-secondary",
                                "DaXacNhan" => "badge-info",
                                "DangKham" => "badge-primary",
                                "HoanThanh" => "badge-success",
                                "Huy" => "badge-danger",
                                _ => "badge-secondary"
                            };
                            var statusText = a.Status switch
                            {
                                "New" => "Mới",
                                "DaXacNhan" => "Đã xác nhận",
                                "DangKham" => "Đang khám",
                                "HoanThanh" => "Hoàn thành",
                                "Huy" => "Hủy",
                                _ => a.Status
                            };
                            <tr>
                                <td>@i</td>
                                <td><strong>@a.TimeSlot</strong></td>
                                <td><strong>@a.Patient?.FullName</strong><br><small class="text-muted">@a.Patient?.Phone</small></td>
                                <td>@a.Doctor?.FullName<br><small class="text-muted">@a.Doctor?.Dept?.DeptName</small></td>
                                <td class="text-truncate" style="max-width:150px;">@a.Reason</td>
                                <td><span class="badge @statusClass">@statusText</span></td>
                                <td>
                                    @if (a.Status == "DaXacNhan")
                                    {
                                        <a href="@Url.Action("Confirm", new { id = a.AppId })" class="btn btn-success btn-sm" title="Bắt đầu khám">
                                            <i class="fas fa-play fa-xs"></i>
                                        </a>
                                    }
                                    @if (a.Status == "DangKham")
                                    {
                                        <a href="@Url.Action("Index", "KhamBenh", new { area = "Admin", id = a.AppId })" class="btn btn-primary btn-sm" title="Khám bệnh">
                                            <i class="fas fa-stethoscope fa-xs"></i>
                                        </a>
                                    }
                                    <a href="@Url.Action("Edit", new { id = a.AppId })" class="btn btn-warning btn-sm" title="Sửa">
                                        <i class="fas fa-edit fa-xs"></i>
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                        if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">Không có lịch hẹn nào hôm nay</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
