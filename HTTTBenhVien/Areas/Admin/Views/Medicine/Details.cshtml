@model HTTTBenhVien.Models.Medicine
@{
    ViewData["Title"] = "Chi tiết Thuốc";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card { border-radius: 1rem; box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08); border: none; overflow: hidden; }
    .detail-header { background: linear-gradient(135deg, #2af598 0%, #009efd 100%); color: white; padding: 2rem; position: relative; }
    .detail-body { padding: 2rem; }
    .detail-row { display: flex; padding: 0.85rem 0; border-bottom: 1px solid #f0f2f5; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 35%; color: #6c757d; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .detail-value { width: 65%; color: #2d3748; font-weight: 500; }
    .bg-icon { position: absolute; right: 2rem; top: 50%; transform: translateY(-50%); font-size: 8rem; opacity: 0.1; }
    .medicine-img-lg { width: 100px; height: 100px; border-radius: 1rem; object-fit: cover; border: 3px solid white; box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
    .stock-bar { height: 8px; border-radius: 4px; background: #e9ecef; overflow: hidden; margin-top: 0.5rem; }
    .stock-fill { height: 100%; border-radius: 4px; transition: width 0.5s ease; }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card detail-card">
                <div class="detail-header">
                    <i class="fas fa-capsules bg-icon"></i>
                    <div class="d-flex align-items-center" style="position: relative; z-index: 1;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="medicine-img-lg mr-4" alt="Thuốc">
                        }
                        else
                        {
                            <div class="medicine-img-lg mr-4 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.2);">
                                <i class="fas fa-pills" style="font-size: 2.5rem;"></i>
                            </div>
                        }
                        <div>
                            <h2 class="mb-1 font-weight-bold">@Model.MedicineName</h2>
                            <p class="mb-0" style="opacity: 0.9;">
                                @if (!string.IsNullOrEmpty(Model.MedicineCode))
                                {
                                    <span class="badge badge-light text-primary px-3 py-1 mr-2">@Model.MedicineCode</span>
                                }
                                @if (Model.IsActive == true)
                                {
                                    <span class="badge badge-success px-3 py-1"><i class="fas fa-check-circle mr-1"></i>Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-3 py-1">Ngừng KD</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="detail-body">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="text-center p-3" style="background: #f0faf8; border-radius: 0.75rem;">
                                <p class="mb-1 text-muted font-weight-bold" style="font-size: 0.8rem;">GIÁ BÁN</p>
                                <div style="font-size: 1.8rem; font-weight: 800; color: #009efd;">@Model.Price.ToString("N0") <small style="font-size: 0.9rem;">đ/@Model.Unit</small></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3" style="background: @(Model.StockQuantity == 0 ? "#fdeaea" : Model.StockQuantity <= 20 ? "#fff3e6" : "#e6f7f1"); border-radius: 0.75rem;">
                                <p class="mb-1 text-muted font-weight-bold" style="font-size: 0.8rem;">TỒN KHO</p>
                                <div style="font-size: 1.8rem; font-weight: 800; color: @(Model.StockQuantity == 0 ? "#eb3349" : Model.StockQuantity <= 20 ? "#e67e22" : "#27ae60");">@Model.StockQuantity <small style="font-size: 0.9rem;">@Model.Unit</small></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3" style="background: @(Model.ExpiryDate.HasValue && Model.ExpiryDate < DateTime.Now ? "#fdeaea" : "#f8f9fe"); border-radius: 0.75rem;">
                                <p class="mb-1 text-muted font-weight-bold" style="font-size: 0.8rem;">HẠN SỬ DỤNG</p>
                                @if (Model.ExpiryDate.HasValue)
                                {
                                    var isExpired = Model.ExpiryDate < DateTime.Now;
                                    <div style="font-size: 1.3rem; font-weight: 700; color: @(isExpired ? "#eb3349" : "#2d3748");">
                                        @(isExpired ? "⚠️ HẾT HẠN" : "")
                                        @Model.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size: 1.3rem; font-weight: 700; color: #a0aec0;">Không xác định</div>
                                }
                            </div>
                        </div>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3" style="color: #009efd;"><i class="fas fa-info-circle mr-2"></i>Thông tin chi tiết</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-atom text-info"></i> Hoạt chất</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.ActiveIngredient) ? "Chưa cập nhật" : Model.ActiveIngredient)</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-box text-warning"></i> Đơn vị tính</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Unit) ? "Chưa cập nhật" : Model.Unit)</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-clipboard-list text-success"></i> Mô tả / Chỉ định</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Description) ? "Chưa có" : Model.Description)</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-chart-bar text-primary"></i> Đã kê trong đơn thuốc</div>
                        <div class="detail-value">
                            <span class="badge badge-primary px-3 py-2" style="font-size: 0.9rem;">@Model.PrescriptionDetails.Count lần</span>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.MedicineId" class="btn px-4 py-2 mr-2" style="background: linear-gradient(135deg, #2af598 0%, #009efd 100%); border: none; color: white; font-weight: 600;">
                            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
