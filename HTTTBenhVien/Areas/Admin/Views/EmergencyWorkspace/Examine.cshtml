<!-- ========================================== -->
<!-- JS LOGIC - SVG DYNAMIC TREND CHART         -->
<!-- ========================================== -->
<script>
    // Add row to Medicine Prescription form
    function addNewMedicineRow() {
        var container = document.getElementById("medicineRowsContainer");
        var firstRow = container.querySelector(".medicine-row");
        var newRow = firstRow.cloneNode(true);
        
        // Reset inputs
        newRow.querySelector(".medicine-select").value = "";
        newRow.querySelector('input[name="Quantities"]').value = "1";
        newRow.querySelector('input[name="Dosages"]').value = "";
        
        container.appendChild(newRow);
    }

    // Dynamic SVG Trend Chart logic
    document.addEventListener("DOMContentLoaded", function() {
        var recordId = @Model.RecordId;
        
        $.ajax({
            url: '/Admin/EmergencyWorkspace/GetVitalSignsHistory?recordId=' + recordId,
            type: 'GET',
            success: function(data) {
                if (data && data.length > 0) {
                    renderVitalsChart(data);
                    renderTrendList(data);
                } else {
                    document.getElementById("vitalsChartContainer").innerHTML = '<p class="text-muted small py-5">Chưa có đủ chỉ số sinh hiệu lịch sử để lập đồ thị xu hướng.</p>';
                }
            },
            error: function() {
                console.error("Lỗi khi tải lịch sử sinh hiệu.");
            }
        });
    });

    function renderTrendList(data) {
        var trendList = document.getElementById("trendList");
        trendList.innerHTML = "";
        
        // Reverse array to show latest first
        var reversedData = [...data].reverse();
        reversedData.forEach(function(item) {
            var time = new Date(item.time);
            var timeStr = time.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' ' + time.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
            
            var isCrit = false;
            var spo2 = parseInt(item.spO2);
            var pulse = parseInt(item.pulseRate);
            if (spo2 < 93 || pulse > 100 || pulse < 60) isCrit = true;
            
            var div = document.createElement("div");
            div.className = "trend-item " + (isCrit ? "critical" : "");
            div.innerHTML = '<strong>' + timeStr + '</strong><br>' + 
                            '🩺 HA: <strong>' + (item.bloodPressure || '--') + '</strong> | ' +
                            '💓 Mạch: <strong>' + (item.pulseRate || '--') + '</strong> bpm | ' + 
                            '🌡️ Nhiệt: <strong>' + (item.temperature || '--') + '</strong>°C | ' + 
                            '🩸 SpO2: <strong>' + (item.spO2 || '--') + '</strong>%';
            trendList.appendChild(div);
        });
    }

    function renderVitalsChart(data) {
        var svg = document.getElementById("vitalsSvg");
        if (!svg) return;
        
        var width = svg.clientWidth || 240;
        var height = svg.clientHeight || 170;
        var padding = 25;
        
        var pulsePoints = [];
        var spo2Points = [];
        
        // Find min/max for scaling
        var pulseMax = 120;
        var pulseMin = 50;
        var spo2Max = 100;
        var spo2Min = 85;
        
        var pointsCount = data.length;
        var xInterval = (width - padding * 2) / Math.max(1, pointsCount - 1);
        
        // Draw grid lines
        var gridHtml = '';
        for (var i = 0; i <= 4; i++) {
            var y = padding + (height - padding * 2) * (i / 4);
            gridHtml += '<line x1="' + padding + '" y1="' + y + '" x2="' + (width - padding) + '" y2="' + y + '" stroke="#e9ecef" stroke-width="1"></line>';
        }
        
        var pulsePath = "M ";
        var spo2Path = "M ";
        
        var pulseDots = "";
        var spo2Dots = "";
        
        data.forEach(function(item, index) {
            var x = padding + index * xInterval;
            
            // Pulse y position (Scale 50 - 120 bpm)
            var pulse = parseInt(item.pulseRate) || 80;
            pulse = Math.max(pulseMin, Math.min(pulseMax, pulse));
            var pulseY = height - padding - ((pulse - pulseMin) / (pulseMax - pulseMin)) * (height - padding * 2);
            pulsePoints.push({x: x, y: pulseY, val: pulse});
            
            // SpO2 y position (Scale 85 - 100 %)
            var spo2 = parseInt(item.spO2) || 98;
            spo2 = Math.max(spo2Min, Math.min(spo2Max, spo2));
            var spo2Y = height - padding - ((spo2 - spo2Min) / (spo2Max - spo2Min)) * (height - padding * 2);
            spo2Points.push({x: x, y: spo2Y, val: spo2});
            
            if (index === 0) {
                pulsePath += x + ' ' + pulseY;
                spo2Path += x + ' ' + spo2Y;
            } else {
                pulsePath += ' L ' + x + ' ' + pulseY;
                spo2Path += ' L ' + x + ' ' + spo2Y;
            }
            
            // Add dots
            pulseDots += '<circle cx="' + x + '" cy="' + pulseY + '" r="4" fill="#dc3545" class="chart-dot" title="Mạch: ' + pulse + '"></circle>';
            spo2Dots += '<circle cx="' + x + '" cy="' + spo2Y + '" r="4" fill="#007bff" class="chart-dot" title="SpO2: ' + spo2 + '%"></circle>';
        });
        
        var svgContent = gridHtml;
        if (pointsCount > 1) {
            svgContent += '<path d="' + pulsePath + '" fill="none" stroke="#dc3545" stroke-width="2.5"></path>';
            svgContent += '<path d="' + spo2Path + '" fill="none" stroke="#007bff" stroke-width="2.5"></path>';
        }
        svgContent += pulseDots + spo2Dots;
        
        svg.innerHTML = svgContent;
    }

    // Xử lý Xóa Đơn Thuốc Cấp cứu
    $(document).on('click', '.btn-delete-prescription', function(e) {
        e.preventDefault();
        var id = $(this).data('id');
        if (confirm('Bạn có chắc chắn muốn xóa đơn thuốc này không? Chi phí sẽ được tự động trừ khỏi nợ cấp cứu của bệnh nhân.')) {
            $('#delete-prescription-id').val(id);
            $('#formDeletePrescription').submit();
        }
    });

    // Mở Modal Sửa Đơn Thuốc Cấp cứu
    $(document).on('click', '.btn-edit-prescription', function() {
        var prescriptionId = $(this).data('id');
        var details = $(this).data('details');
        
        $('#edit-PrescriptionId').val(prescriptionId);
        $('#medicine-list-edit').empty();
        
        if (details && details.length > 0) {
            details.forEach(function(d) {
                addEditMedicineRow(d.MedicineId, d.Quantity, d.Dosage);
            });
        } else {
            addEditMedicineRow();
        }
        
        $('#modalEditPrescription').modal('show');
    });

    function addEditMedicineRow(medicineId, quantity, dosage) {
        var template = $('#medicine-row-template').html();
        var newRow = $(template);
        
        if (medicineId) {
            newRow.find('.select-medicine-edit').val(medicineId);
        }
        if (quantity) {
            newRow.find('.input-quantity').val(quantity);
        }
        if (dosage) {
            newRow.find('.input-dosage').val(dosage);
        }
        
        $('#medicine-list-edit').append(newRow);
        
        // Khởi tạo Select2 cho dòng thuốc mới trong Modal Sửa
        newRow.find('.select-medicine-edit').select2({
            width: '100%',
            dropdownParent: $('#modalEditPrescription')
        });
    }

    function removeMedicineRow(btn) {
        var container = $(btn).closest('#medicine-list-edit');
        var rowCount = container.find('.medicine-row').length;
        if (rowCount > 1) {
            $(btn).closest('.medicine-row').remove();
        } else {
            alert('Phải có ít nhất một loại thuốc trong đơn!');
        }
    }
</script>
