@model HTTTBenhVien.Models.MedicalRecord
@using HTTTBenhVien.Models

@{
    ViewData["Title"] = "Khám Cấp Cứu Chi Tiết - VinhUni";
    var icdCodes = ViewBag.IcdCodes as List<IcdDictionary> ?? new List<IcdDictionary>();
    var medicines = ViewBag.Medicines as List<Medicine> ?? new List<Medicine>();
    var medicalServices = ViewBag.MedicalServices as List<MedicalService> ?? new List<MedicalService>();
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();

    var age = DateTime.Today.Year - (Model.Patient.Dob?.Year ?? (DateTime.Today.Year - 30));
    var isTriageHigh = Model.TriageLevel == 1 || Model.TriageLevel == 2;
}

<style>
    .examine-container {
        font-family: 'Inter', 'Outfit', sans-serif;
        background-color: #f4f6f9;
        min-height: 100vh;
        padding-bottom: 80px; /* space for sticky footer */
    }

    .er-badge-pulse {
        background: linear-gradient(135deg, #dc3545, #ff6b6b);
        color: white;
        font-weight: 800;
        letter-spacing: 1px;
        border-radius: 8px;
        animation: erPulse 1.5s infinite alternate;
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);
    }

    @@keyframes erPulse {
        0% { box-shadow: 0 0 5px rgba(220, 53, 69, 0.4); transform: scale(1); }
        100% { box-shadow: 0 0 15px rgba(220, 53, 69, 0.7); transform: scale(1.03); }
    }

    .card-premium {
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        background: white;
        margin-bottom: 20px;
    }

    .card-premium .card-header {
        background-color: transparent;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.88rem;
        padding: 16px 20px;
    }

    /* Sticky Bottom Actions Bar */
    .sticky-actions-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
        z-index: 1030;
        padding: 15px 30px;
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    .form-control-premium {
        border-radius: 8px;
        border: 1px solid #ced4da;
        background: #f8f9fa;
        padding: 10px 12px;
        transition: all 0.2s;
    }
    .form-control-premium:focus {
        background: #fff;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15);
        border-color: #dc3545;
    }

    /* Vitals trend items */
    .trend-list {
        max-height: 250px;
        overflow-y: auto;
    }
    .trend-item {
        border-left: 3px solid #dee2e6;
        padding: 6px 12px;
        margin-bottom: 8px;
        font-size: 0.8rem;
    }
    .trend-item.critical {
        border-left-color: #dc3545;
        background: #fff5f5;
    }
</style>

<div class="container-fluid examine-container mt-4">
    
    <!-- Top Patient Info Banner -->
    <div class="card-premium p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <div class="mr-3">
                    <span class="h3 fw-bold text-dark mb-0">@Model.Patient.FullName</span>
                    <span class="badge badge-secondary ml-2" style="font-size: 0.85rem;">MS: @Model.Patient.PatientCode</span>
                </div>
                
                @if (isTriageHigh)
                {
                    <div class="er-badge-pulse py-1 px-3 mr-2 text-uppercase small">
                        🚑 CẤP CỨU ƯU TIÊN (MỨC @Model.TriageLevel)
                    </div>
                }
                else
                {
                    <div class="badge badge-info py-1 px-3 mr-2 text-uppercase small">
                        🚑 CẤP CỨU (MỨC @Model.TriageLevel)
                    </div>
                }
            </div>
            
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm rounded-pill font-weight-bold" data-toggle="modal" data-target="#identifyPatientModal">
                    <i class="fas fa-id-card mr-1"></i> Cập nhật danh tính
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill font-weight-bold">
                    <i class="fas fa-arrow-left mr-1"></i> Bàn Triage
                </a>
            </div>
        </div>

        <div class="row mt-3 border-top pt-3 small text-muted">
            <div class="col-md-3">Giới tính: <strong>@(Model.Patient.Gender ? "Nam" : "Nữ")</strong></div>
            <div class="col-md-3">Tuổi: <strong>@age tuổi</strong> (@Model.Patient.Dob?.ToString("dd/MM/yyyy"))</div>
            <div class="col-md-3">Số ĐT: <strong>@(string.IsNullOrEmpty(Model.Patient.Phone) ? "Chưa có" : Model.Patient.Phone)</strong></div>
            <div class="col-md-3">Địa chỉ: <strong>@Model.Patient.Address</strong></div>
        </div>
    </div>

    <!-- Alert Messaging -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @Html.Raw(TempData["Success"])
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi!</strong> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- 3-Column Workspace Grid -->
    <div class="row">
        
        <!-- ======================================= -->
        <!-- COLUMN LEFT: Vitals Tracking & Charts   -->
        <!-- ======================================= -->
        <div class="col-xl-3 col-lg-4">
            <!-- Latest Vitals Panel -->
            <div class="card-premium">
                <div class="card-header text-danger"><i class="fas fa-heartbeat mr-2"></i> Sinh hiệu hiện tại</div>
                <div class="card-body p-3">
                    <div class="row text-center mb-3">
                        <div class="col-6 mb-2">
                            <div class="small text-muted">Huyết áp</div>
                            <h5 class="font-weight-bold mb-0 text-dark">@(string.IsNullOrEmpty(Model.BloodPressure) ? "--" : Model.BloodPressure)</h5>
                            <span class="text-xs text-muted">mmHg</span>
                        </div>
                        <div class="col-6 mb-2">
                            <div class="small text-muted">Mạch</div>
                            <h5 class="font-weight-bold mb-0 text-danger">@(Model.PulseRate?.ToString() ?? "--")</h5>
                            <span class="text-xs text-muted">lần/phút</span>
                        </div>
                        <div class="col-6 mb-2">
                            <div class="small text-muted">Nhiệt độ</div>
                            <h5 class="font-weight-bold mb-0 text-warning">@(Model.Temperature?.ToString() ?? "--")</h5>
                            <span class="text-xs text-muted">°C</span>
                        </div>
                        <div class="col-6 mb-2">
                            <div class="small text-muted">SpO2</div>
                            <h5 class="font-weight-bold mb-0 text-primary">@(Model.SpO2?.ToString() ?? "--")%</h5>
                            <span class="text-xs text-muted">oxi máu</span>
                        </div>
                    </div>

                    <!-- Add new vital reading form -->
                    <button class="btn btn-outline-danger btn-block btn-sm" data-toggle="collapse" data-target="#addVitalsForm">
                        <i class="fas fa-plus mr-1"></i> Ghi sinh hiệu mới
                    </button>

                    <div class="collapse mt-3" id="addVitalsForm">
                        <form asp-action="SaveRecord" method="post" class="border-top pt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RecordId" value="@Model.RecordId">
                            <input type="hidden" name="Symptoms" value="@Model.Symptoms">
                            <input type="hidden" name="Diagnosis" value="@Model.Diagnosis">
                            <input type="hidden" name="Conclusion" value="@Model.Conclusion">
                            <input type="hidden" name="IcdCode" value="@Model.IcdCode">
                            <input type="hidden" name="Notes" value="@Model.Notes">
                            <input type="hidden" name="Height" value="@Model.Height">
                            <input type="hidden" name="Weight" value="@Model.Weight">

                            <div class="row">
                                <div class="col-6 mb-2">
                                    <label class="small font-weight-bold">HA (mmHg)</label>
                                    <input type="text" class="form-control form-control-sm" name="BloodPressure" value="@Model.BloodPressure" placeholder="120/80">
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="small font-weight-bold">Mạch (bpm)</label>
                                    <input type="number" class="form-control form-control-sm" name="PulseRate" value="@Model.PulseRate" placeholder="80">
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="small font-weight-bold">Nhiệt (°C)</label>
                                    <input type="number" step="0.1" class="form-control form-control-sm" name="Temperature" value="@Model.Temperature" placeholder="37.0">
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="small font-weight-bold">SpO2 (%)</label>
                                    <input type="number" class="form-control form-control-sm" name="SpO2" value="@Model.SpO2" placeholder="98">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm btn-block mt-2">Lưu chỉ số</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Vitals Trend Chart Card -->
            <div class="card-premium">
                <div class="card-header text-primary"><i class="fas fa-chart-line mr-2"></i> Xu hướng sinh hiệu</div>
                <div class="card-body p-2 text-center">
                    <!-- SVG Trend Chart Rendering -->
                    <div id="vitalsChartContainer" style="height: 180px; width: 100%; position: relative;" class="my-2">
                        <svg id="vitalsSvg" style="width:100%; height:100%; min-height: 170px;"></svg>
                    </div>
                    <div class="d-flex justify-content-center gap-3 small mt-1">
                        <span class="text-danger"><i class="fas fa-circle"></i> Mạch</span>
                        <span class="text-primary"><i class="fas fa-circle"></i> SpO2</span>
                    </div>

                    <!-- Trend List -->
                    <div class="trend-list border-top pt-2 mt-2 text-left" id="trendList">
                        <!-- Filled by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- ======================================= -->
        <!-- COLUMN MIDDLE: Bệnh Án Lâm Sàng        -->
        <!-- ======================================= -->
        <div class="col-xl-5 col-lg-8">
            <div class="card-premium">
                <div class="card-header text-dark d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-file-medical mr-2 text-danger"></i> Hồ sơ khám cấp cứu lâm sàng</span>
                    <span class="badge badge-danger">CẤP CỨU KHẨN</span>
                </div>
                <div class="card-body">
                    <form asp-action="SaveRecord" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RecordId" value="@Model.RecordId">
                        
                        <!-- Auto-fill values from current sinh hiệu to prevent overwriting them -->
                        <input type="hidden" name="BloodPressure" value="@Model.BloodPressure">
                        <input type="hidden" name="PulseRate" value="@Model.PulseRate">
                        <input type="hidden" name="Temperature" value="@Model.Temperature">
                        <input type="hidden" name="SpO2" value="@Model.SpO2">
                        <input type="hidden" name="Height" value="@Model.Height">
                        <input type="hidden" name="Weight" value="@Model.Weight">

                        <div class="form-group mb-3">
                            <label class="font-weight-bold small text-muted">Triệu chứng tiếp nhận & Lâm sàng ban đầu</label>
                            <textarea class="form-control form-control-premium" name="Symptoms" rows="3" required placeholder="Nhập triệu chứng chi tiết...">@Model.Symptoms</textarea>
                        </div>

                        <div class="form-group mb-3">
                            <label class="font-weight-bold small text-muted">Chẩn đoán cấp cứu sơ bộ / Xác định</label>
                            <textarea class="form-control form-control-premium" name="Diagnosis" rows="3" placeholder="Nhập chẩn đoán ban đầu...">@Model.Diagnosis</textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="font-weight-bold small text-muted">Mã bệnh danh (ICD-10)</label>
                                <select class="form-control select2 border-0 shadow-sm" name="IcdCode" style="background: #f8f9fa;">
                                    <option value="">-- Chọn mã ICD-10 --</option>
                                    @foreach (var icd in icdCodes)
                                    {
                                        <option value="@icd.IcdCode" selected="@(Model.IcdCode == icd.IcdCode)">@icd.IcdCode - @icd.DiseaseName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="font-weight-bold small text-muted">Loại hình bệnh án</label>
                                <input type="text" class="form-control text-danger font-weight-bold" name="RecordType" value="Cấp cứu" readonly style="background: #fff5f5;">
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="font-weight-bold small text-muted">Ý kiến hội chẩn / Ghi chú điều trị cấp cứu</label>
                            <textarea class="form-control form-control-premium" name="Notes" rows="3" placeholder="Các ý kiến hội chẩn chuyên khoa hoặc lưu ý...">@Model.Notes</textarea>
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold small text-muted">Kết luận lâm sàng cấp cứu</label>
                            <input type="text" class="form-control form-control-premium text-primary font-weight-bold" name="Conclusion" value="@Model.Conclusion" placeholder="Kết luận: VD Bệnh nhân tỉnh táo, cơn đau giảm...">
                        </div>

                        <button type="submit" class="btn btn-danger btn-block font-weight-bold py-2 shadow-sm" style="border-radius: 8px;">
                            <i class="fas fa-save mr-2"></i> LƯU HỒ SƠ LÂM SÀNG
                        </button>
                    </form>
                </div>
            </div>

            <!-- Ordered CLS Services list -->
            <div class="card-premium">
                <div class="card-header text-dark"><i class="fas fa-vial mr-2 text-primary"></i> Phiếu chỉ định cận lâm sàng đã kê</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 small">
                            <thead class="bg-light">
                                <tr>
                                    <th>Dịch vụ</th>
                                    <th>Thời điểm</th>
                                    <th>Trạng thái</th>
                                    <th>Kết quả</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecordServices == null || !Model.RecordServices.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-3 text-muted">Chưa có chỉ định cận lâm sàng nào.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var rs in Model.RecordServices)
                                    {
                                        <tr>
                                            <td class="font-weight-bold text-dark">@rs.Service.ServiceName</td>
                                            <td>@rs.ExecuteDate?.ToString("HH:mm dd/MM")</td>
                                            <td>
                                                @if (rs.Status == "HoanThanh" || rs.Status == "Hoàn thành" || rs.Status == "Completed" || rs.Status == "DaCoKetQua")
                                                {
                                                    <span class="badge badge-success">Đã hoàn thành</span>
                                                }
                                                else if (rs.Status == "DangThucHien" || rs.Status == "Đang thực hiện")
                                                {
                                                    <span class="badge badge-warning">Đang thực hiện</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Chờ thực hiện</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(rs.ResultValue))
                                                {
                                                    <strong class="text-success">@rs.ResultValue</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted italic">Đang đợi kết quả...</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ======================================= -->
        <!-- COLUMN RIGHT: Urgent Orders & Billing   -->
        <!-- ======================================= -->
        <div class="col-xl-4">
            
            <!-- Immediate CLS Prescription Widget -->
            <div class="card-premium">
                <div class="card-header text-primary"><i class="fas fa-prescription mr-2"></i> Chỉ định dịch vụ cận lâm sàng khẩn</div>
                <div class="card-body p-3">
                    <form asp-action="AddEmergencyService" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RecordId" value="@Model.RecordId">
                        
                        <div class="form-group mb-2">
                            <label class="small font-weight-bold">Dịch vụ CLS</label>
                            <select class="form-control form-control-sm select2" name="ServiceId" required>
                                <option value="">-- Chọn xét nghiệm / Siêu âm --</option>
                                @foreach (var svc in medicalServices)
                                {
                                    <option value="@svc.ServiceId">@svc.ServiceName (@svc.BasePrice.ToString("N0") VNĐ)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="small font-weight-bold">Lưu ý / Chỉ dẫn khẩn cấp</label>
                            <input type="text" class="form-control form-control-sm" name="Note" placeholder="Ví dụ: Làm cấp cứu gấp, lấy máu tại giường...">
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary btn-block font-weight-bold">
                            <i class="fas fa-plus mr-1"></i> Chỉ định CLS gấp
                        </button>
                    </form>
                </div>
            </div>

            <!-- Urgent Medicine Prescription Widget -->
            <div class="card-premium">
                <div class="card-header text-warning" style="color: #d4ac0d !important;"><i class="fas fa-capsules mr-2"></i> Kê đơn thuốc cấp cứu khẩn</div>
                <div class="card-body p-3">
                    <form asp-action="AddPrescription" method="post" id="medicinePrescriptionForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="RecordId" value="@Model.RecordId">

                        <div id="medicineRowsContainer">
                            <div class="row medicine-row mb-2">
                                <div class="col-7 pr-1">
                                    <select class="form-control form-control-sm medicine-select" name="MedicineIds" style="width:100%;">
                                        <option value="">-- Chọn thuốc --</option>
                                        @foreach (var med in medicines)
                                        {
                                            <option value="@med.MedicineId">@med.MedicineName (@med.Price.ToString("N0") đ)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-2 px-1">
                                    <input type="number" class="form-control form-control-sm" name="Quantities" placeholder="SL" min="1" value="1">
                                </div>
                                <div class="col-3 pl-1">
                                    <input type="text" class="form-control form-control-sm" name="Dosages" placeholder="Liều lượng">
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-xs btn-outline-warning mb-3 mt-1" onclick="addNewMedicineRow()">
                            <i class="fas fa-plus mr-1"></i> Thêm dòng thuốc
                        </button>

                        <button type="submit" class="btn btn-sm btn-warning btn-block font-weight-bold text-dark">
                            <i class="fas fa-pills mr-1"></i> Kê đơn khẩn cấp
                        </button>
                    </form>
                </div>
            </div>

            <!-- Đơn thuốc đã kê Widget -->
            <div class="card-premium mt-3">
                <div class="card-header text-success" style="color: #27ae60 !important;"><i class="fas fa-prescription-bottle-alt mr-2"></i> Đơn thuốc cấp cứu đã kê</div>
                <div class="card-body p-3">
                    @if (Model.Prescriptions != null && Model.Prescriptions.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var p in Model.Prescriptions)
                            {
                                var detailsJson = Newtonsoft.Json.JsonConvert.SerializeObject(p.PrescriptionDetails.Select(d => new {
                                    d.MedicineId,
                                    MedicineName = d.Medicine != null ? d.Medicine.MedicineName : "",
                                    d.Quantity,
                                    d.Dosage
                                }));
                                <div class="list-group-item px-0 py-2 border-bottom" style="background: transparent;">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <h6 class="mb-0 font-weight-bold text-dark text-sm">Đơn thuốc #@p.PrescriptionId</h6>
                                            <small class="text-muted"><i class="far fa-clock mr-1"></i>@p.CreateDate?.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <div class="btn-group shadow-sm">
                                            <a href="@Url.Action("PrintPrescription", "PharmacyWorkspace", new { id = p.PrescriptionId, area = "Admin" })" target="_blank" class="btn btn-xs btn-outline-primary" style="padding: 0.15rem 0.3rem; font-size: 0.7rem;" title="In đơn thuốc">
                                                <i class="fas fa-print"></i>
                                            </a>
                                            <button type="button" class="btn btn-xs btn-outline-warning btn-edit-prescription" 
                                                    data-id="@p.PrescriptionId" 
                                                    data-details='@Html.Raw(detailsJson)' 
                                                    style="padding: 0.15rem 0.3rem; font-size: 0.7rem;"
                                                    title="Sửa đơn thuốc">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-danger btn-delete-prescription" 
                                                    data-id="@p.PrescriptionId" 
                                                    style="padding: 0.15rem 0.3rem; font-size: 0.7rem;"
                                                    title="Xóa đơn thuốc">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <ul class="pl-3 mb-0 text-xs text-secondary">
                                        @if (p.PrescriptionDetails != null)
                                        {
                                            foreach (var d in p.PrescriptionDetails)
                                            {
                                                <li><strong>@d.Medicine?.MedicineName</strong> - SL: @d.Quantity - @d.Dosage</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-3">
                            <p class="text-muted mb-0 small">Chưa có đơn thuốc nào được kê.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Accumulated Bill Widget -->
            <div class="card-premium">
                <div class="card-header text-success"><i class="fas fa-file-invoice-dollar mr-2"></i> Tạm tính hóa đơn gộp (Nợ cấp cứu)</div>
