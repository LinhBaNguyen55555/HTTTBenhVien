@model IEnumerable<HTTTBenhVien.Models.Patient>
@{
    ViewData["Title"] = "Quản lý Hồ sơ Bệnh nhân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-gradient {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white; padding: 2rem; border-radius: 1rem; margin-bottom: 1.5rem;
        box-shadow: 0 10px 30px rgba(79, 172, 254, 0.3);
    }
    .card-ajax { border: none; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); transition: transform 0.2s, box-shadow 0.2s; overflow: hidden; }
    .card-ajax:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.25); }
    .card-header-ajax { background: white; border-bottom: 2px solid #f8f9fe; padding: 1.25rem 1.5rem; font-weight: 600; color: #4facfe; }
    .btn-gradient { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none; color: white; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 0.5rem; transition: all 0.3s ease; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(79, 172, 254, 0.4); color: white; }
    .btn-gradient-info { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border: none; color: white; }
    .btn-gradient-danger { background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none; color: white; }
    .btn-sm-gradient { padding: 0.375rem 0.75rem; font-size: 0.875rem; border-radius: 0.375rem; }
    .table-ajax thead th { background: #f8f9fc; color: #4facfe; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; border: none; padding: 1rem; }
    .table-ajax tbody td { vertical-align: middle; padding: 1rem; border-color: #f0f2f8; }
    .table-ajax tbody tr:hover { background: #f8f9fe; }
    .badge-loai { padding: 0.35rem 0.65rem; border-radius: 0.35rem; font-size: 0.75rem; font-weight: 600; }
    .avatar-circle { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; }
    .empty-state { padding: 3rem; text-align: center; }
    .empty-state-icon { font-size: 4rem; color: #d1d3e0; margin-bottom: 1rem; }
    .stat-card { background: white; border-radius: 1rem; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1); }
    .stat-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(0, 242, 254, 0.15) 100%); color: #4facfe; }
    .stat-info h4 { font-weight: 700; margin: 0; color: #2d3748; font-size: 1.5rem; }
    .stat-info p { margin: 0; color: #a0aec0; font-size: 0.85rem; }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #dc3545;">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="page-header-gradient">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="fas fa-procedures"></i> Quản lý Bệnh nhân</h1>
                <p>Tra cứu và quản lý hồ sơ khám bệnh</p>
            </div>
            <div class="d-none d-md-block">
                <i class="fas fa-procedures" style="font-size: 4rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count()</h4>
                    <p>Tổng hồ sơ</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(17, 153, 142, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%); color: #11998e;"><i class="fas fa-male"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(p => p.Gender == true)</h4>
                    <p>Bệnh nhân Nam</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(235, 51, 73, 0.15) 0%, rgba(244, 92, 67, 0.15) 100%); color: #eb3349;"><i class="fas fa-female"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(p => p.Gender == false)</h4>
                    <p>Bệnh nhân Nữ</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ajax mb-4">
        <div class="card-header card-header-ajax d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list mr-2"></i>Danh sách bệnh nhân</span>
            <div class="d-flex align-items-center">
                <form asp-action="Index" method="get" class="form-inline mr-3 mb-0">
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tên, Mã BN, CCCD..." style="border-radius: 20px 0 0 20px; outline: none; box-shadow: none;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary" style="border-radius: 0 20px 20px 0; background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none;"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </form>
                <a asp-action="Create" class="btn btn-sm btn-gradient">
                    <i class="fas fa-plus mr-1"></i> Thêm hồ sơ mới
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-ajax mb-0">
                        <thead>
                            <tr>
                                <th width="20%"><i class="fas fa-user mr-1"></i> Bệnh nhân</th>
                                <th width="15%"><i class="fas fa-id-card mr-1"></i> CCCD</th>
                                <th width="25%"><i class="fas fa-info-circle mr-1"></i> Thông tin cơ bản</th>
                                <th width="25%"><i class="fas fa-phone mr-1"></i> Liên hệ</th>
                                <th width="15%" class="text-center"><i class="fas fa-cog mr-1"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.AvatarUrlFull" class="avatar-circle mr-3" alt="Avatar">
                                            <div>
                                                <strong class="text-dark d-block">@item.FullName</strong>
                                                <span class="badge badge-primary badge-loai mt-1">@item.PatientCode</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="font-weight-bold">@(string.IsNullOrEmpty(item.CitizenId) ? "N/A" : item.CitizenId)</span>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.85rem;">
                                            <div><strong>Ngày sinh:</strong> @(item.Dob?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                                            <div><strong>Giới tính:</strong> 
                                                @if (item.Gender)
                                                {
                                                    <span class="text-primary"><i class="fas fa-mars mr-1"></i>Nam</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger"><i class="fas fa-venus mr-1"></i>Nữ</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.85rem;">
                                            <div><i class="fas fa-phone-alt text-success mr-1"></i> @(string.IsNullOrEmpty(item.Phone) ? "N/A" : item.Phone)</div>
                                            <div class="text-truncate" style="max-width: 200px;" title="@item.Address"><i class="fas fa-map-marker-alt text-danger mr-1"></i> @(string.IsNullOrEmpty(item.Address) ? "N/A" : item.Address)</div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.PatientId" class="btn btn-sm btn-gradient btn-sm-gradient text-white" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.PatientId" class="btn btn-sm btn-gradient-info btn-sm-gradient text-white" title="Chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.PatientId" class="btn btn-sm btn-gradient-danger btn-sm-gradient text-white" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-folder-open empty-state-icon"></i>
                    <h5 class="text-muted font-weight-bold">Chưa có hồ sơ bệnh nhân nào</h5>
                    <p class="text-muted mb-4">Hãy thêm hồ sơ mới để bắt đầu quản lý</p>
                    <a asp-action="Create" class="btn btn-gradient px-4">
                        <i class="fas fa-plus mr-2"></i>Thêm hồ sơ
                    </a>
                </div>
            }
        </div>
    </div>
</div>
