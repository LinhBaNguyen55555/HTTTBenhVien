@model HTTTBenhVien.Models.Patient
@{
    ViewData["Title"] = "Xóa Bệnh nhân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white;">
                    <h6 class="m-0 font-weight-bold text-center"><i class="fas fa-exclamation-triangle mr-2"></i>Xác nhận xóa hồ sơ bệnh nhân</h6>
                </div>
                <div class="card-body p-5 text-center">
                    <img src="@Model.AvatarUrlFull" class="rounded-circle mb-4" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #f8f9fc; box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.1);" alt="Avatar" />
                    
                    <h3 class="font-weight-bold text-gray-800 mb-1">@Model.FullName</h3>
                    <p class="text-muted mb-4">Mã BN: @Model.PatientCode | CCCD: @(string.IsNullOrEmpty(Model.CitizenId) ? "N/A" : Model.CitizenId)</p>

                    <div class="alert alert-danger" role="alert">
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa bệnh nhân này không? Hành động này không thể hoàn tác. 
                        Nếu bệnh nhân đã có hóa đơn hoặc lịch hẹn khám, hệ thống sẽ từ chối xóa để đảm bảo toàn vẹn dữ liệu.
                    </div>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="PatientId" />
                        <button type="submit" class="btn btn-danger px-4 py-2 mr-2" style="border-radius: 0.5rem; background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none;">
                            <i class="fas fa-trash-alt mr-2"></i> Xác nhận Xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: 0.5rem;">
                            Hủy bỏ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
