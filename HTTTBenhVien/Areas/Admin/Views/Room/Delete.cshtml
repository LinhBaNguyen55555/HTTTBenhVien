@model HTTTBenhVien.Models.Room
@{
    ViewData["Title"] = "Xóa phòng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .delete-card {
        border-radius: 1rem;
        box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08);
        border: none;
        overflow: hidden;
    }
    .delete-header {
        background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
        color: white;
        padding: 2rem;
        text-align: center;
    }
    .warning-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }
    .detail-row {
        display: flex;
        padding: 1rem 0;
        border-bottom: 1px dashed #e2e8f0;
    }
    .detail-label { width: 35%; color: #64748b; font-weight: 600; }
    .detail-value { width: 65%; color: #1e293b; font-weight: 500; }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card delete-card">
                <div class="delete-header">
                    <i class="fas fa-exclamation-triangle warning-icon"></i>
                    <h3 class="font-weight-bold">Xác nhận xóa phòng</h3>
                    <p class="mb-0">Hành động này không thể hoàn tác!</p>
                </div>
                
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4">
                        <i class="fas fa-info-circle mr-2"></i> Bạn có chắc chắn muốn xóa phòng <strong>@Model.RoomNumber</strong> không?
                    </div>

                    <div class="mb-4">
                        <div class="detail-row">
                            <div class="detail-label">Số phòng:</div>
                            <div class="detail-value">@Model.RoomNumber</div>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label">Thuộc khoa:</div>
                            <div class="detail-value">@Model.Dept?.DeptName</div>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label">Loại phòng:</div>
                            <div class="detail-value">@Model.RoomType?.RoomTypeName</div>
                        </div>
                    </div>

                    <form asp-action="Delete" class="text-center">
                        <input type="hidden" asp-for="RoomId" />
                        <button type="submit" class="btn btn-danger px-4 py-2 mr-2">
                            <i class="fas fa-trash-alt mr-2"></i> Xác nhận xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-times mr-2"></i> Hủy bỏ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
