@model HTTTBenhVien.Models.Room
@{
    ViewData["Title"] = "Chi tiết phòng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card {
        border-radius: 1rem;
        box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08);
        border: none;
        overflow: hidden;
    }
    .detail-header {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        padding: 2rem;
        position: relative;
    }
    .detail-icon {
        position: absolute;
        right: 2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 5rem;
        opacity: 0.2;
    }
    .detail-body { padding: 2rem; }
    .detail-row {
        display: flex;
        padding: 1rem 0;
        border-bottom: 1px solid #f0f2f5;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label {
        width: 30%;
        color: #6c757d;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .detail-value {
        width: 70%;
        color: #2d3748;
        font-weight: 500;
    }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card detail-card">
                <div class="detail-header">
                    <h2 class="mb-1 font-weight-bold">@Model.RoomNumber</h2>
                    <p class="mb-0 opacity-75">Thông tin chi tiết phòng</p>
                    <i class="fas fa-door-open detail-icon"></i>
                </div>
                
                <div class="detail-body">
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-hashtag text-primary"></i> Số phòng</div>
                        <div class="detail-value">@Model.RoomNumber</div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-hospital text-success"></i> Thuộc khoa</div>
                        <div class="detail-value">
                            <span class="badge badge-success px-3 py-2" style="font-size: 0.9rem;">
                                @Model.Dept?.DeptName
                            </span>
                        </div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-tag text-info"></i> Loại phòng</div>
                        <div class="detail-value">
                            <span class="badge badge-info px-3 py-2" style="font-size: 0.9rem;">
                                @Model.RoomType?.RoomTypeName
                            </span>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-bed text-warning"></i> Số giường</div>
                        <div class="detail-value">@Model.Beds?.Count giường</div>
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-primary px-4 mr-2">
                            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
