@model HTTTBenhVien.Models.Account
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
        <a href="@Url.Action("ChangePassword")" class="btn btn-warning btn-sm shadow-sm">
            <i class="fas fa-key fa-sm text-white-50"></i> Đổi mật khẩu
        </a>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.Emp?.AvatarUrl))
                        {
                            <img src="@Model.Emp.AvatarUrl" class="rounded-circle" width="120" height="120" style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary text-white" style="width:120px;height:120px;font-size:40px;font-weight:700;">
                                @Model.Emp?.FullName?.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>
                    <h5 class="font-weight-bold">@Model.Emp?.FullName</h5>
                    <p class="text-muted mb-1">@Model.Emp?.JobTitle</p>
                    <p class="small text-muted">@Model.Emp?.Dept?.DeptName</p>
                    <hr />
                    <div class="text-left small">
                        <p><i class="fas fa-user mr-2 text-primary"></i> @Model.Username</p>
                        <p><i class="fas fa-envelope mr-2 text-primary"></i> @Model.Emp?.Email</p>
                        <p><i class="fas fa-phone mr-2 text-primary"></i> @Model.Emp?.Phone</p>
                        @{
                            var roleText = Model.RoleName switch
                            {
                                "Admin" => "Admin - Quản trị hệ thống",
                                "BacSi" => "Bác sĩ",
                                "LeTan" => "Lễ tân",
                                "KeToan" => "Kế toán",
                                "DuocSi" => "Dược sĩ",
                                _ => Model.RoleName ?? "Staff"
                            };
                        }
                        <p><i class="fas fa-shield-alt mr-2 text-primary"></i> @roleText</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin chi tiết</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small font-weight-bold text-uppercase">Họ tên đầy đủ</label>
                                <p class="mb-0">@Model.Emp?.FullName</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small font-weight-bold text-uppercase">Ngày sinh</label>
                                <p class="mb-0">@(Model.Emp?.Dob?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</p>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small font-weight-bold text-uppercase">Email</label>
                                <p class="mb-0">@(Model.Emp?.Email ?? "Chưa cập nhật")</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small font-weight-bold text-uppercase">Số điện thoại</label>
                                <p class="mb-0">@(Model.Emp?.Phone ?? "Chưa cập nhật")</p>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small font-weight-bold text-uppercase">Khoa / Phòng ban</label>
                                <p class="mb-0">@(Model.Emp?.Dept?.DeptName ?? "Chưa phân công")</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="text-muted small font-weight-bold text-uppercase">Chức danh</label>
                                <p class="mb-0">@(Model.Emp?.JobTitle ?? "Chưa cập nhật")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
