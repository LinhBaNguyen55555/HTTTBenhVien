@model HTTTBenhVien.Areas.Admin.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-key mr-1"></i> Đổi mật khẩu của bạn</h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="ChangePassword">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label class="font-weight-bold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input type="password" asp-for="CurrentPassword" class="form-control" required />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" asp-for="NewPassword" class="form-control" required minlength="6" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <small class="form-text text-muted">Tối thiểu 6 ký tự</small>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <hr />
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu mật khẩu mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
