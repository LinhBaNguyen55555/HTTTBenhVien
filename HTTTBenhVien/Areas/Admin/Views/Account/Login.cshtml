@model HTTTBenhVien.Areas.Admin.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - VinhuniHIS";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #175cdd 0%, #0d3a9e 50%, #061c64 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            padding: 20px;
        }

        .login-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .login-header {
            background: linear-gradient(135deg, #175cdd, #0d3a9e);
            padding: 40px 30px;
            text-align: center;
            color: white;
        }

        .login-header .hospital-icon {
            width: 70px;
            height: 70px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
        }

        .login-header h1 {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .login-header p {
            font-size: 13px;
            opacity: 0.85;
        }

        .login-body {
            padding: 35px 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            font-weight: 600;
            color: #444;
            font-size: 13px;
            margin-bottom: 6px;
            display: block;
        }

        .input-group {
            position: relative;
        }

        .input-group input {
            width: 100%;
            padding: 12px 15px 12px 42px;
            border: 2px solid #e8edf4;
            border-radius: 10px;
            font-size: 14px;
            font-family: 'Nunito', sans-serif;
            transition: all 0.3s;
        }

        .input-group input:focus {
            outline: none;
            border-color: #175cdd;
            box-shadow: 0 0 0 3px rgba(23, 92, 221, 0.1);
        }

        .input-group i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
            font-size: 16px;
        }

        .input-group input:focus + i,
        .input-group:hover i {
            color: #175cdd;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }

        .form-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #175cdd;
            cursor: pointer;
        }

        .form-check label {
            font-size: 13px;
            color: #666;
            cursor: pointer;
            user-select: none;
        }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #175cdd, #0d3a9e);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 0.3px;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(23, 92, 221, 0.4);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .alert-danger {
            background: #fff5f5;
            border: 1px solid #fed7d7;
            color: #c53030;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .login-footer {
            text-align: center;
            padding: 0 30px 25px;
            font-size: 12px;
            color: #999;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #175cdd;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 20px;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #0d3a9e;
        }
    </style>
</head>

<body>
    <div class="login-container">
        <a href="~/" class="back-link">
            <i class="fas fa-arrow-left"></i> Quay về trang chủ
        </a>

        <div class="login-card">
            <div class="login-header">
                <div class="hospital-icon">
                    <i class="fas fa-hospital-alt fa-lg"></i>
                </div>
                <h1>VinhuniHIS</h1>
                <p>Hệ thống Quản lý Thông tin Bệnh viện</p>
            </div>

            <div class="login-body">
                <form method="post" asp-action="Login" asp-area="Admin" asp-controller="Account">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }

                    <div class="form-group">
                        <label>Tên đăng nhập</label>
                        <div class="input-group">
                            <input type="text" asp-for="Username" placeholder="Nhập tên đăng nhập" required autofocus />
                            <i class="fas fa-user"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Mật khẩu</label>
                        <div class="input-group">
                            <input type="password" asp-for="Password" placeholder="Nhập mật khẩu" required />
                            <i class="fas fa-lock"></i>
                        </div>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" asp-for="RememberMe" />
                        <label>Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fas fa-sign-in-alt"></i> Đăng nhập
                    </button>
                </form>
            </div>
        </div>

        <div class="login-footer">
            &copy; @DateTime.Now.Year VinhuniHIS. Tất cả quyền được bảo lưu.
        </div>
    </div>
</body>

</html>
