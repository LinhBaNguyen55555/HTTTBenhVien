@model IEnumerable<HTTTBenhVien.Models.Account>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
        <a href="@Url.Action("Register")" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Tạo tài khoản mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách tài khoản (@Model.Count())</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>STT</th>
                            <th>Họ tên</th>
                            <th>Tên đăng nhập</th>
                            <th>Vai trò</th>
                            <th>Khoa / Phòng</th>
                            <th>Trạng thái</th>
                            <th width="160">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        <strong>@item.Emp?.FullName</strong>
                                    </td>
                                    <td>
                                        <code>@item.Username</code>
                                    </td>
                                    <td>
                                        @{
                                            var roleClass = item.RoleName switch
                                            {
                                                "Admin" => "badge-danger",
                                                "BacSi" => "badge-primary",
                                                "LeTan" => "badge-info",
                                                "KeToan" => "badge-warning",
                                                "DuocSi" => "badge-success",
                                                _ => "badge-secondary"
                                            };
                                            var roleText = item.RoleName switch
                                            {
                                                "Admin" => "Admin",
                                                "BacSi" => "Bác sĩ",
                                                "LeTan" => "Lễ tân",
                                                "KeToan" => "Kế toán",
                                                "DuocSi" => "Dược sĩ",
                                                _ => item.RoleName ?? "Staff"
                                            };
                                        }
                                        <span class="badge @roleClass">@roleText</span>
                                    </td>
                                    <td>@item.Emp?.Dept?.DeptName</td>
                                    <td>
                                        @if (item.IsActive == true)
                                        {
                                            <span class="badge badge-success"><i class="fas fa-check mr-1"></i> Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary"><i class="fas fa-ban mr-1"></i> Bị khóa</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Edit", new { id = item.AccountId })" class="btn btn-warning btn-sm" title="Sửa">
                                            <i class="fas fa-edit fa-xs"></i>
                                        </a>
                                        @if (item.IsActive == true)
                                        {
                                            <a href="@Url.Action("ResetPassword", new { id = item.AccountId })" class="btn btn-info btn-sm" title="Đặt lại mật khẩu" onclick="return confirm('Đặt lại mật khẩu về 123456?')">
                                                <i class="fas fa-key fa-xs"></i>
                                            </a>
                                            <a href="@Url.Action("Delete", new { id = item.AccountId })" class="btn btn-danger btn-sm" title="Khóa tài khoản" onclick="return confirm('Khóa tài khoản này?')">
                                                <i class="fas fa-lock fa-xs"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <form method="get" action="@Url.Action("ToggleActive", new { id = item.AccountId })" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm" title="Mở khóa">
                                                    <i class="fas fa-unlock fa-xs"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
