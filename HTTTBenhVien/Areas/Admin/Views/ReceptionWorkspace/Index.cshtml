@model IEnumerable<HTTTBenhVien.Models.Appointment>
@{
    ViewData["Title"] = "Không gian Lễ tân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var doctors = ViewBag.Doctors as IEnumerable<dynamic>;
    var today = DateTime.Today;
}

<style>
    /* Warm theme cho Lễ tân */
    .reception-bg {
        background-color: #fff9f5;
    }
    .card-reception-gradient {
        background: linear-gradient(135deg, #ff9a44 0%, #fc6076 100%);
        color: white;
    }
    .stat-card-orange {
        background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
        color: white;
        border: none;
        border-radius: 1rem;
        transition: transform 0.2s;
    }
    .stat-card-orange:hover {
        transform: translateY(-5px);
    }
    .stat-card-green {
        background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
        color: #2c3e50;
        border: none;
        border-radius: 1rem;
    }
    .btn-warm {
        background: linear-gradient(135deg, #ff9a44 0%, #fc6076 100%);
        color: white;
        border: none;
        transition: all 0.3s;
    }
    .btn-warm:hover {
        background: linear-gradient(135deg, #fc6076 0%, #ff9a44 100%);
        color: white;
        box-shadow: 0 5px 15px rgba(252, 96, 118, 0.4);
    }
    .table-hover tbody tr:hover {
        background-color: #fff2eb;
    }
    @@keyframes pulse-late {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.5); transform: scale(1); }
        50% { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); transform: scale(1.03); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); transform: scale(1); }
    }
    .badge-pulse-danger {
        animation: pulse-late 1.8s infinite ease-in-out;
        background-color: #dc3545;
        color: white;
        box-shadow: 0 2px 4px rgba(220, 53, 69, 0.2);
    }
</style>

<div class="container-fluid reception-bg py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-gray-800 font-weight-bold" style="color: #d35400 !important;">
            <i class="fas fa-concierge-bell mr-2"></i>Bàn Tiếp Đón & Điều Phối
        </h3>
        <button class="btn btn-warm btn-lg shadow-sm" data-toggle="modal" data-target="#modalWalkIn">
            <i class="fas fa-user-plus mr-2"></i>Đăng ký khám trực tiếp
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 0.5rem;">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Stats Row -->
    <!-- Stats Row -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card-orange shadow py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Tổng tiếp nhận hôm nay</div>
                            <div class="h5 mb-0 font-weight-bold">@ViewBag.TotalToday</div>
                            <span class="small font-weight-bold" style="opacity: 0.9;">@ViewBag.TotalAppointments Hẹn + @ViewBag.TotalWalkIns Trực tiếp</span>
                        </div>
                        <div class="col-auto"><i class="fas fa-hospital-user fa-2x text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card-orange shadow py-2" style="background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%); color: #2c3e50;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Đang chờ xác nhận</div>
                            <div class="h5 mb-0 font-weight-bold">@ViewBag.TotalPending</div>
                            <span class="small" style="opacity: 0.8;">(Chỉ tính lịch hẹn)</span>
                            @if (ViewBag.TotalPending > 0)
                            {
                                <form asp-action="AutoConfirmAll" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light text-primary font-weight-bold shadow-sm w-100 py-1" style="border-radius: 0.4rem; font-size: 0.75rem;">
                                        <i class="fas fa-magic mr-1 animate-pulse"></i> Tự động xác thực nhanh
                                    </button>
                                </form>
                            }
                        </div>
                        <div class="col-auto"><i class="fas fa-clock fa-2x text-gray-300"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card-green shadow py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Đã vào phòng khám</div>
                            <div class="h5 mb-0 font-weight-bold">@ViewBag.TotalCheckedIn</div>
                            <span class="small" style="opacity: 0.8;">Đang chờ / Đang khám</span>
                        </div>
                        <div class="col-auto"><i class="fas fa-check-double fa-2x text-gray-500"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card-orange shadow py-2" style="background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%); color: #2c3e50;">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Đã hủy</div>
                            <div class="h5 mb-0 font-weight-bold">@ViewBag.TotalCancelled</div>
                            <span class="small" style="opacity: 0.8;">(Yêu cầu hủy hẹn)</span>
                        </div>
                        <div class="col-auto"><i class="fas fa-times-circle fa-2x text-gray-500"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách tiếp nhận có Tabs -->
    <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
        <div class="card-header bg-white py-0 border-0" style="border-bottom: 2px solid #fc6076 !important;">
            <ul class="nav nav-tabs card-header-tabs border-0 mt-2" id="receptionTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active font-weight-bold" id="appointments-tab" data-toggle="tab" href="#appointments" role="tab" aria-controls="appointments" aria-selected="true" style="border-radius: 0.5rem 0.5rem 0 0; color: #fc6076;">
                        <i class="fas fa-calendar-alt mr-2"></i>Lịch Hẹn Đặt Trước (@ViewBag.TotalAppointments)
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link font-weight-bold text-secondary" id="walkins-tab" data-toggle="tab" href="#walkins" role="tab" aria-controls="walkins" aria-selected="false" style="border-radius: 0.5rem 0.5rem 0 0;">
                        <i class="fas fa-walking mr-2"></i>Đăng Ký Khám Trực Tiếp (@ViewBag.TotalWalkIns)
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content" id="receptionTabsContent">
                <!-- Tab Lịch Hẹn Đặt Trước -->
                <div class="tab-pane fade show active" id="appointments" role="tabpanel" aria-labelledby="appointments-tab">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0" id="dataTable" width="100%" cellspacing="0">
                            <thead style="background-color: #fff2eb; color: #d35400;">
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Bệnh nhân</th>
                                    <th>SĐT</th>
                                    <th>Bác sĩ hẹn</th>
                                    <th>Lý do</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    bool isPendingOrConfirmed = item.Status == "Pending" || item.Status == "Chờ xác nhận" || item.Status == "New" || item.Status == "Mới" || item.Status == "Đang chờ" || item.Status == "ChoXacNhan" || item.Status == "Confirmed" || item.Status == "Đã xác nhận" || item.Status == "Xác nhận" || item.Status == "DaXacNhan";
                                    bool isLate = false;
                                    if (isPendingOrConfirmed && item.AppDate.HasValue)
                                    {
                                        if (item.AppDate.Value.Date < today)
                                        {
                                            isLate = true;
                                        }
                                        else if (item.AppDate.Value.Date == today && !string.IsNullOrEmpty(item.TimeSlot))
                                        {
                                            var rawSlot = item.TimeSlot.Split('-')[0].Trim();
                                            if (TimeSpan.TryParse(rawSlot, out var slotTime) && DateTime.Now.TimeOfDay > slotTime)
                                            {
                                                isLate = true;
                                            }
                                        }
                                    }
                                    <tr>
                                        <td class="font-weight-bold text-dark">
                                            @(item.AppDate?.ToString("dd/MM")) <br/>
                                            <span class="text-primary">@item.TimeSlot</span>
                                        </td>
                                        <td>@item.Patient?.FullName</td>
                                        <td>@item.Patient?.Phone</td>
                                        <td>@(item.Doctor != null ? item.Doctor.FullName : "Chưa xếp")</td>
                                        <td>@item.Reason</td>
                                        <td>
                                            @if (item.Status == "Pending" || item.Status == "Chờ xác nhận" || item.Status == "New" || item.Status == "Mới" || item.Status == "Đang chờ" || item.Status == "ChoXacNhan")
                                            {
                                                <span class="badge badge-warning px-3 py-2">Chờ xác nhận</span>
                                            }
                                            else if (item.Status == "Confirmed" || item.Status == "Đã xác nhận" || item.Status == "Xác nhận" || item.Status == "DaXacNhan")
                                            {
                                                <span class="badge badge-info px-3 py-2">Đã xác nhận</span>
                                            }
                                            else if (item.Status == "CheckedIn" || item.Status == "Đã tiếp nhận" || item.Status == "Completed" || item.Status == "Hoàn thành")
                                            {
                                                <span class="badge badge-success px-3 py-2">Đã vào khám</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger px-3 py-2">Đã hủy</span>
                                            }
                                            @if (isLate && item.Status != "Cancelled" && item.Status != "CheckedIn" && item.Status != "Đã tiếp nhận" && item.Status != "Completed" && item.Status != "Hoàn thành")
                                            {
                                                <br/>
                                                <span class="badge badge-pulse-danger px-2 py-1 mt-1 font-weight-bold" style="font-size: 0.72rem; border-radius: 4px; display: inline-block;">
                                                    <i class="fas fa-exclamation-triangle mr-1"></i>Trễ hẹn
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center align-middle">
                                            @if (item.Status == "Pending" || item.Status == "Chờ xác nhận" || item.Status == "New" || item.Status == "Mới" || item.Status == "Đang chờ" || item.Status == "ChoXacNhan")
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.AppId" />
                                                    <input type="hidden" name="status" value="Confirmed" />
                                                    <button type="submit" class="btn btn-sm btn-info shadow-sm font-weight-bold" title="Xác nhận lịch hẹn">
                                                        <i class="fas fa-check mr-1"></i> Xác nhận
                                                    </button>
                                                </form>
                                                <form asp-action="CancelAppointment" method="post" class="d-inline" onsubmit="return confirmCancel(this);">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.AppId" />
                                                    <input type="hidden" name="reason" value="" class="cancel-reason-input" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm ml-1" title="Hủy lịch">
                                                        <i class="fas fa-times"></i> Hủy
                                                    </button>
                                                </form>
                                            }
                                            else if (item.Status == "Confirmed" || item.Status == "Đã xác nhận" || item.Status == "Xác nhận" || item.Status == "DaXacNhan")
                                            {
                                                <button type="button" class="btn btn-sm btn-warm shadow-sm font-weight-bold" onclick="openCheckInModal(@item.AppId, '@item.Patient?.FullName')" title="Check-in & Chuyển phòng">
                                                    <i class="fas fa-sign-in-alt mr-1"></i> Tiếp nhận
                                                </button>
                                                @if (isLate)
                                                {
                                                    <form asp-action="CancelAppointment" method="post" class="d-inline ml-1" onsubmit="return confirmCancelLate(this);">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.AppId" />
                                                        <input type="hidden" name="reason" value="Bệnh nhân trễ giờ hẹn khám - Lễ tân hủy lịch" />
                                                        <button type="submit" class="btn btn-sm btn-danger shadow-sm font-weight-bold" title="Hủy do trễ hẹn">
                                                            <i class="fas fa-calendar-times mr-1"></i> Hủy do trễ
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab Đăng Ký Khám Trực Tiếp -->
                <div class="tab-pane fade" id="walkins" role="tabpanel" aria-labelledby="walkins-tab">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0" width="100%" cellspacing="0">
                            <thead style="background-color: #f0f7ff; color: #004085;">
                                <tr>
                                    <th>Thời gian đ.ký</th>
                                    <th>Bệnh nhân</th>
                                    <th>SĐT</th>
                                    <th>Bác sĩ tiếp nhận</th>
                                    <th>Lý do khám</th>
                                    <th>Trạng thái khám</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.WalkIns != null && ((List<HTTTBenhVien.Models.MedicalRecord>)ViewBag.WalkIns).Any())
                                {
                                    foreach (var record in (List<HTTTBenhVien.Models.MedicalRecord>)ViewBag.WalkIns)
                                    {
                                        bool isExamined = !string.IsNullOrEmpty(record.Diagnosis) || !string.IsNullOrEmpty(record.Conclusion);
                                        <tr>
                                            <td class="font-weight-bold text-dark align-middle">
                                                @(record.VisitDate?.ToString("HH:mm")) <br/>
                                                <span class="text-muted small">@(record.VisitDate?.ToString("dd/MM/yyyy"))</span>
                                            </td>
                                            <td class="align-middle font-weight-bold text-primary">@record.Patient?.FullName</td>
                                            <td class="align-middle">@record.Patient?.Phone</td>
                                            <td class="align-middle"><i class="fas fa-user-md text-info mr-1"></i> @(record.Doctor != null ? record.Doctor.FullName : "Chưa xếp")</td>
                                            <td class="align-middle">@record.Notes</td>
                                            <td class="align-middle text-center">
                                                @if (isExamined)
                                                {
                                                    <span class="badge badge-success px-3 py-2"><i class="fas fa-check-circle mr-1"></i>Đã khám xong</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-primary px-3 py-2 shadow-sm"><i class="fas fa-spinner fa-spin mr-1"></i>Đang chờ khám</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="fas fa-walking fa-3x mb-3 text-gray-300"></i><br/>
                                            Chưa có bệnh nhân nào đăng ký trực tiếp hôm nay.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Check-in Lịch Hẹn -->
<div class="modal fade" id="modalCheckIn" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form asp-action="CheckIn" method="post">
            <div class="modal-content" style="border-radius: 1rem; border: none;">
                <div class="modal-header card-reception-gradient">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-clipboard-check mr-2"></i>Tiếp nhận bệnh nhân</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="checkinAppointmentId" name="appointmentId" />
                    <p class="mb-3">Bệnh nhân: <strong id="checkinPatientName" class="text-primary text-uppercase"></strong></p>
                    <div class="form-group">
                        <label class="font-weight-bold">Chỉ định Bác sĩ / Phòng khám</label>
                        <select name="doctorId" class="form-control" required>
                            <option value="">-- Chọn Bác sĩ --</option>
                            @if (doctors != null)
                            {
                                foreach (var d in doctors)
                                {
                                    <option value="@d.EmpId">@d.FullName</option>
                                }
                            }
                        </select>
                        <small class="form-text text-muted">Hệ thống sẽ tự động tạo Bệnh án và đẩy vào danh sách khám của Bác sĩ này.</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warm"><i class="fas fa-check-circle mr-1"></i> Hoàn tất tiếp nhận</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal Đăng Ký Khám Trực Tiếp (Walk-in) -->
<div class="modal fade" id="modalWalkIn" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <form asp-action="WalkIn" method="post">
            <div class="modal-content" style="border-radius: 1rem; border: none;">
                <div class="modal-header card-reception-gradient">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-user-plus mr-2"></i>Đăng ký khám trực tiếp (Khách vãng lai)</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <!-- PHẦN 1: Thông tin hành chính -->
                    <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-id-card mr-2"></i>Thông tin hành chính</h6>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="font-weight-bold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" class="form-control" required placeholder="Nhập họ tên đầy đủ" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="font-weight-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" name="PhoneNumber" class="form-control" required placeholder="Dùng để tìm kiếm HSBA" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="font-weight-bold">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="email@example.com" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="font-weight-bold">Giới tính</label>
                            <select name="Gender" class="form-control">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="font-weight-bold">Ngày sinh <span class="text-danger">*</span></label>
                            <input type="date" name="DateOfBirth" class="form-control" required />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="font-weight-bold">Số CCCD / CMND</label>
                            <input type="text" name="CitizenId" class="form-control" placeholder="VD: 0123456789xx" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="font-weight-bold">Mã thẻ BHYT</label>
                            <input type="text" name="BhytCode" class="form-control" placeholder="VD: GD4950..." />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold">Địa chỉ thường trú</label>
                            <input type="text" name="Address" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/TP" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="font-weight-bold">Nghề nghiệp</label>
                            <input type="text" name="Occupation" class="form-control" placeholder="VD: Công nhân, Sinh viên..." />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="font-weight-bold">Nơi làm việc / Trường học</label>
                            <input type="text" name="WorkplaceOrSchool" class="form-control" placeholder="Tên cơ quan / trường" />
                        </div>
                    </div>

                    <hr class="my-3"/>

                    <!-- PHẦN 2: Thông tin khám bệnh & Chuyển phòng -->
                    <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-stethoscope mr-2"></i>Thông tin khám bệnh</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold">Lý do khám bệnh</label>
                            <textarea name="Reason" class="form-control" rows="2" placeholder="Sốt, đau bụng, ho kéo dài..."></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="font-weight-bold">Chuyển Bác sĩ / Phòng khám <span class="text-danger">*</span></label>
                            <select name="DoctorId" class="form-control" required>
                                <option value="">-- Chọn Bác sĩ --</option>
                                @if (doctors != null)
                                {
                                    foreach (var d in doctors)
                                    {
                                        <option value="@d.EmpId">@d.FullName</option>
                                    }
                                }
                            </select>
                            <small class="form-text text-danger mt-1"><i class="fas fa-exclamation-circle"></i> Bệnh nhân sẽ xuất hiện ngay lập tức trên Bàn khám của Bác sĩ.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warm"><i class="fas fa-save mr-1"></i> Đăng ký & Chuyển phòng</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCheckInModal(id, name) {
            $('#checkinAppointmentId').val(id);
            $('#checkinPatientName').text(name);
            $('#modalCheckIn').modal('show');
        }

        function confirmCancel(form) {
            var reason = prompt("Nhập lý do hủy lịch hẹn:", "Bệnh nhân yêu cầu hủy");
            if (reason === null) return false; // Bấm Hủy (Cancel)
            if (reason.trim() === "") {
                reason = "Lễ tân hủy lịch";
            }
            $(form).find('.cancel-reason-input').val(reason);
            return true;
        }

        function confirmCancelLate(form) {
            return confirm("Bệnh nhân này đã quá giờ hẹn khám. Bạn có chắc chắn muốn HỦY lịch hẹn này do trễ giờ?");
        }

        $(document).ready(function() {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.20/i18n/Vietnamese.json"
                },
                "order": [[0, "asc"]] // Sắp xếp theo giờ tăng dần
            });
        });
    </script>
}
