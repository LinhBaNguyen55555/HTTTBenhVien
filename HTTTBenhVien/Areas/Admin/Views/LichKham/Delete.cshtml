@model HTTTBenhVien.Models.Appointment
@{
    ViewData["Title"] = "Xóa Lịch hẹn";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white;">
                    <h6 class="m-0 font-weight-bold text-center"><i class="fas fa-exclamation-triangle mr-2"></i>Xác nhận xóa lịch hẹn khám</h6>
                </div>
                <div class="card-body p-5 text-center">
                    <div class="mb-4" style="font-size: 4rem; color: #eb3349;">
                        <i class="fas fa-calendar-times"></i>
                    </div>
                    
                    <h4 class="font-weight-bold text-gray-800 mb-2">Lịch hẹn #@Model.AppId</h4>
                    <p class="text-muted mb-4">
                        <strong>Bệnh nhân:</strong> @(Model.Patient?.FullName ?? "N/A") <br/>
                        <strong>Ngày khám:</strong> @(Model.AppDate?.ToString("dd/MM/yyyy") ?? "N/A")
                    </p>

                    <div class="alert alert-danger" role="alert">
                        <strong>Cảnh báo:</strong> Việc xóa lịch hẹn sẽ làm mất dữ liệu vĩnh viễn. 
                        Nếu khách hàng hủy lịch, khuyến cáo bạn nên <strong>Cập nhật trạng thái</strong> thành "Đã hủy" thay vì xóa hẳn khỏi hệ thống.
                    </div>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="AppId" />
                        <button type="submit" class="btn btn-danger px-4 py-2 mr-2" style="border-radius: 0.5rem; background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none;">
                            <i class="fas fa-trash-alt mr-2"></i> Vẫn Xóa Lịch
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: 0.5rem;">
                            Hủy bỏ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
