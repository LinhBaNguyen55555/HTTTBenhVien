@model IEnumerable<HTTTBenhVien.Models.Appointment>
@{
    ViewData["Title"] = "Quản lý lịch khám";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <form method="get" class="form-inline">
            <h6 class="m-0 font-weight-bold text-primary mr-3">Danh sách lịch khám (@ViewBag.Total)</h6>
            <select name="status" class="form-control form-control-sm mr-2" style="width:140px;">
                <option value="">Tất cả trạng thái</option>
                <option value="New" selected="@(ViewBag.Status == "New")">Mới</option>
                <option value="DaXacNhan" selected="@(ViewBag.Status == "DaXacNhan")">Đã xác nhận</option>
                <option value="DangKham" selected="@(ViewBag.Status == "DangKham")">Đang khám</option>
                <option value="HoanThanh" selected="@(ViewBag.Status == "HoanThanh")">Hoàn thành</option>
                <option value="Huy" selected="@(ViewBag.Status == "Huy")">Hủy</option>
            </select>
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm mr-2" style="width:140px;" placeholder="Từ ngày" />
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm mr-2" style="width:140px;" placeholder="Đến ngày" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-filter"></i> Lọc</button>
            <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary ml-1"><i class="fas fa-redo"></i></a>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Ngày khám</th>
                        <th>Giờ</th>
                        <th>Bệnh nhân</th>
                        <th>Bác sĩ</th>
                        <th>Khoa</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th width="160">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var a in Model)
                        {
                            var statusClass = a.Status switch
                            {
                                "New" => "badge-secondary",
                                "DaXacNhan" => "badge-info",
                                "DangKham" => "badge-primary",
                                "HoanThanh" => "badge-success",
                                "Huy" => "badge-danger",
                                _ => "badge-secondary"
                            };
                            var statusText = a.Status switch
                            {
                                "New" => "Mới",
                                "DaXacNhan" => "Đã xác nhận",
                                "DangKham" => "Đang khám",
                                "HoanThanh" => "Hoàn thành",
                                "Huy" => "Hủy",
                                _ => a.Status
                            };
                            <tr>
                                <td>@i</td>
                                <td>@a.AppDate?.ToString("dd/MM/yyyy")</td>
                                <td>@a.TimeSlot</td>
                                <td><strong>@a.Patient?.FullName</strong><br><small class="text-muted">@a.Patient?.Phone</small></td>
                                <td>@a.Doctor?.FullName</td>
                                <td>@a.Doctor?.Dept?.DeptName</td>
                                <td class="text-truncate" style="max-width:120px;">@a.Reason</td>
                                <td><span class="badge @statusClass">@statusText</span></td>
                                <td>
                                    <a href="@Url.Action("Details", new { id = a.AppId })" class="btn btn-info btn-sm" title="Chi tiết"><i class="fas fa-eye fa-xs"></i></a>
                                    @if (a.Status == "DaXacNhan")
                                    {
                                        <a href="@Url.Action("UpdateStatus", new { id = a.AppId, status = "DangKham" })" class="btn btn-success btn-sm" title="Bắt đầu khám"><i class="fas fa-play fa-xs"></i></a>
                                    }
                                    @if (a.Status == "DangKham")
                                    {
                                        <a href="@Url.Action("Index", "KhamBenh", new { area = "Admin", appointmentId = a.AppId })" class="btn btn-primary btn-sm" title="Khám bệnh"><i class="fas fa-stethoscope fa-xs"></i></a>
                                    }
                                    <a href="@Url.Action("UpdateStatus", new { id = a.AppId, status = "Huy" })" class="btn btn-danger btn-sm" title="Hủy" onclick="return confirm('Hủy lịch hẹn này?')"><i class="fas fa-times fa-xs"></i></a>
                                </td>
                            </tr>
                            i++;
                        }
                        if (!Model.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
