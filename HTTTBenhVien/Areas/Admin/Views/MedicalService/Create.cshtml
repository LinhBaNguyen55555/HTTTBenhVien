@model HTTTBenhVien.Models.MedicalService
@{
    ViewData["Title"] = "Thêm Dịch vụ Y tế";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .card-header-gradient { background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); color: white; }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-plus-circle mr-2"></i>Thêm dịch vụ y tế mới</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="ServiceName" class="font-weight-bold">Tên dịch vụ <span class="text-danger">*</span></label>
                            <input asp-for="ServiceName" class="form-control form-control-lg" placeholder="VD: Xét nghiệm máu, Chụp X-Quang, Siêu âm tim..." required />
                            <span asp-validation-for="ServiceName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="BasePrice" class="font-weight-bold">Giá cơ bản (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="BasePrice" type="number" step="1000" min="0" class="form-control form-control-lg" placeholder="VD: 150000" required />
                                <div class="input-group-append">
                                    <span class="input-group-text font-weight-bold" style="background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); color: white; border: none;">VNĐ</span>
                                </div>
                            </div>
                            <small class="form-text text-muted">Nhập giá niêm yết cơ bản cho dịch vụ (trước BHYT)</small>
                            <span asp-validation-for="BasePrice" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="font-weight-bold">Mô tả dịch vụ</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả chi tiết quy trình, yêu cầu chuẩn bị, thời gian thực hiện..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <hr class="mt-4 mb-4" />
                        <div class="text-center">
                            <button type="submit" class="btn px-5 py-2 mr-3" style="background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); border: none; color: white; font-weight: 600;">
                                <i class="fas fa-save mr-2"></i> Lưu dịch vụ
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-5 py-2">
                                <i class="fas fa-arrow-left mr-2"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
