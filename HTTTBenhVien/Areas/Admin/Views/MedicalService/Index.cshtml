@model IEnumerable<HTTTBenhVien.Models.MedicalService>
@{
    ViewData["Title"] = "Quản lý Dịch vụ Y tế";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
        .card-ajax { border: none; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); transition: transform 0.2s, box-shadow 0.2s; overflow: hidden; }
    .card-ajax:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.25); }
    .card-header-ajax { background: white; border-bottom: 2px solid #f8f9fe; padding: 1.25rem 1.5rem; font-weight: 600; color: #00b09b; }
    .btn-gradient { background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); border: none; color: white; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 0.5rem; transition: all 0.3s ease; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(150, 201, 61, 0.4); color: white; }
    .btn-gradient-info { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none; color: white; }
    .btn-gradient-danger { background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none; color: white; }
    .btn-sm-gradient { padding: 0.375rem 0.75rem; font-size: 0.875rem; border-radius: 0.375rem; }
    .table-ajax thead th { background: #f8f9fc; color: #00b09b; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; border: none; padding: 1rem; }
    .table-ajax tbody td { vertical-align: middle; padding: 1rem; border-color: #f0f2f8; }
    .table-ajax tbody tr:hover { background: #f8f9fe; }
    .empty-state { padding: 3rem; text-align: center; }
    .empty-state-icon { font-size: 4rem; color: #d1d3e0; margin-bottom: 1rem; }
    .stat-card { background: white; border-radius: 1rem; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1); }
    .stat-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-info h4 { font-weight: 700; margin: 0; color: #2d3748; font-size: 1.5rem; }
    .stat-info p { margin: 0; color: #a0aec0; font-size: 0.85rem; }
    .price-tag { font-weight: 700; color: #00b09b; font-size: 1rem; }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #dc3545;">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <h1 class="h3 mb-4 text-gray-800 font-weight-bold">Danh sách dịch vụ y tế</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(0, 176, 155, 0.15) 0%, rgba(150, 201, 61, 0.15) 100%); color: #00b09b;"><i class="fas fa-concierge-bell"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count()</h4>
                    <p>Tổng dịch vụ</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(0, 242, 254, 0.15) 100%); color: #4facfe;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="stat-info">
                    <h4>@(Model.Any() ? Model.Min(s => s.BasePrice).ToString("N0") : "0") đ</h4>
                    <p>Giá thấp nhất</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(235, 51, 73, 0.15) 0%, rgba(244, 92, 67, 0.15) 100%); color: #eb3349;"><i class="fas fa-coins"></i></div>
                <div class="stat-info">
                    <h4>@(Model.Any() ? Model.Max(s => s.BasePrice).ToString("N0") : "0") đ</h4>
                    <p>Giá cao nhất</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ajax mb-4">
        <div class="card-header card-header-ajax d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list mr-2"></i>Danh sách dịch vụ</span>
            <div class="d-flex align-items-center">
                <form asp-action="Index" method="get" class="form-inline mr-3 mb-0">
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tên dịch vụ..." style="border-radius: 20px 0 0 20px; outline: none; box-shadow: none;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary" style="border-radius: 0 20px 20px 0; background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); border: none;"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </form>
                <a asp-action="Create" class="btn btn-sm btn-gradient">
                    <i class="fas fa-plus mr-1"></i> Thêm dịch vụ
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-ajax mb-0">
                        <thead>
                            <tr>
                                <th width="8%"><i class="fas fa-hashtag mr-1"></i> STT</th>
                                <th width="30%"><i class="fas fa-tag mr-1"></i> Tên dịch vụ</th>
                                <th width="15%"><i class="fas fa-money-bill mr-1"></i> Giá cơ bản</th>
                                <th width="32%"><i class="fas fa-info-circle mr-1"></i> Mô tả</th>
                                <th width="15%" class="text-center"><i class="fas fa-cog mr-1"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int stt = 1; }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="badge badge-light font-weight-bold" style="font-size: 0.9rem;">@(stt++)</span></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div style="width: 36px; height: 36px; border-radius: 0.5rem; background: linear-gradient(135deg, rgba(0, 176, 155, 0.15) 0%, rgba(150, 201, 61, 0.15) 100%); display: flex; align-items: center; justify-content: center; margin-right: 0.75rem;">
                                                <i class="fas fa-medkit" style="color: #00b09b;"></i>
                                            </div>
                                            <strong class="text-dark">@item.ServiceName</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="price-tag">@item.BasePrice.ToString("N0") <small>đ</small></span>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;" title="@item.Description">
                                            @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả" : item.Description)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-action-group shadow-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.ServiceId" class="btn btn-action-edit" title="Sửa"><i class="fas fa-edit"></i></a>
                                            <a asp-action="Details" asp-route-id="@item.ServiceId" class="btn btn-action-middle" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.ServiceId" class="btn btn-action-delete" title="Xóa"><i class="fas fa-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-hand-holding-medical empty-state-icon"></i>
                    <h5 class="text-muted font-weight-bold">Chưa có dịch vụ nào</h5>
                    <p class="text-muted mb-4">Thêm dịch vụ y tế mới vào hệ thống</p>
                    <a asp-action="Create" class="btn btn-gradient px-4">
                        <i class="fas fa-plus mr-2"></i>Thêm dịch vụ
                    </a>
                </div>
            }
        </div>
    </div>
</div>
