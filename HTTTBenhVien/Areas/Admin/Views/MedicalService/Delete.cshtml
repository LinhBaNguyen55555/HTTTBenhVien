@model HTTTBenhVien.Models.MedicalService
@{
    ViewData["Title"] = "Xóa Dịch vụ Y tế";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white;">
                    <h6 class="m-0 font-weight-bold text-center"><i class="fas fa-exclamation-triangle mr-2"></i>Xác nhận xóa dịch vụ</h6>
                </div>
                <div class="card-body p-5 text-center">
                    <div class="mb-4" style="font-size: 4rem; color: #eb3349;">
                        <i class="fas fa-hand-holding-medical"></i>
                    </div>

                    <h4 class="font-weight-bold text-gray-800 mb-2">@Model.ServiceName</h4>
                    <p class="text-muted mb-1">Mã: <strong>#DV-@Model.ServiceId</strong></p>
                    <p class="mb-4"><span class="font-weight-bold" style="color: #00b09b; font-size: 1.2rem;">@Model.BasePrice.ToString("N0") VNĐ</span></p>

                    @if (Model.RecordServices.Any())
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>Lưu ý:</strong> Dịch vụ này đã được sử dụng <strong>@Model.RecordServices.Count lần</strong> trong các bệnh án. Việc xóa có thể gây lỗi dữ liệu.
                        </div>
                    }

                    <div class="alert alert-danger" role="alert">
                        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Nếu dịch vụ đã có liên kết với bệnh án, hệ thống sẽ từ chối xóa.
                    </div>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="ServiceId" />
                        <button type="submit" class="btn btn-danger px-4 py-2 mr-2" style="border-radius: 0.5rem; background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none;">
                            <i class="fas fa-trash-alt mr-2"></i> Xác nhận Xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: 0.5rem;">
                            Hủy bỏ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
