@model HTTTBenhVien.Models.Bed
@{
    ViewData["Title"] = "Chi tiết giường bệnh";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card {
        border-radius: 1rem;
        box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08);
        border: none;
        overflow: hidden;
    }
    .detail-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 2rem;
        position: relative;
    }
    .detail-icon {
        position: absolute;
        right: 2rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 5rem;
        opacity: 0.2;
    }
    .detail-body { padding: 2rem; }
    .detail-row {
        display: flex;
        padding: 1rem 0;
        border-bottom: 1px solid #f0f2f5;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label {
        width: 35%;
        color: #6c757d;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .detail-value {
        width: 65%;
        color: #2d3748;
        font-weight: 500;
    }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card detail-card">
                <div class="detail-header">
                    <h2 class="mb-1 font-weight-bold">Giường @Model.BedNumber</h2>
                    <p class="mb-0 opacity-75">Thông tin chi tiết giường bệnh</p>
                    <i class="fas fa-bed detail-icon"></i>
                </div>
                
                <div class="detail-body">
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-hashtag text-primary"></i> Số/Mã giường</div>
                        <div class="detail-value font-weight-bold text-dark" style="font-size: 1.1rem;">@Model.BedNumber</div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-door-open text-info"></i> Thuộc phòng</div>
                        <div class="detail-value">
                            <span class="badge badge-info px-3 py-2" style="font-size: 0.9rem;">
                                Phòng @Model.Room?.RoomNumber
                            </span>
                        </div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-hospital text-primary"></i> Khoa</div>
                        <div class="detail-value">@Model.Room?.Dept?.DeptName</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-money-bill-wave text-success"></i> Giá thuê/ngày</div>
                        <div class="detail-value">
                            <span class="text-success font-weight-bold" style="font-size: 1.1rem;">
                                @(Model.PricePerDay?.ToString("N0") ?? "0") VNĐ
                            </span>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-info-circle text-warning"></i> Trạng thái</div>
                        <div class="detail-value">
                            @if (Model.IsOccupied == true)
                            {
                                <span class="badge badge-danger px-3 py-2" style="font-size: 0.9rem;"><i class="fas fa-user-injured mr-1"></i> Có bệnh nhân</span>
                            }
                            else
                            {
                                <span class="badge badge-success px-3 py-2" style="font-size: 0.9rem;"><i class="fas fa-check-circle mr-1"></i> Trống</span>
                            }
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.BedId" class="btn btn-primary px-4 py-2 mr-2" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border: none;">
                            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
