@model IEnumerable<HTTTBenhVien.Models.DoctorSchedule>
@{
    ViewData["Title"] = "Quản lý Lịch làm việc Bác sĩ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản lý Lịch làm việc</h1>
    @if (User.IsInRole("Admin"))
    {
        <a href="@Url.Action("Create")" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> Thêm lịch trực mới
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách lịch làm việc</h6>
    </div>
    <div class="card-body">
        <form method="get" class="form-inline mb-3">
            <div class="form-group mr-2">
                <label class="mr-2">Ngày làm việc:</label>
                <input type="date" name="filterDate" class="form-control" value="@ViewData["FilterDate"]" />
            </div>
            <div class="form-group mr-2">
                <select name="doctorId" class="form-control" asp-items="ViewBag.DoctorId">
                    <option value="">-- Tất cả Bác sĩ --</option>
                </select>
            </div>
            <button type="submit" class="btn btn-secondary">Lọc</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary ml-2">Xóa bộ lọc</a>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>Bác sĩ</th>
                        <th>Ngày làm việc</th>
                        <th>Ca trực</th>
                        <th>Giới hạn ca khám</th>
                        <th>Trạng thái</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-center">Hành động</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Doctor?.FullName</strong><br/>
                                <small class="text-muted">@item.Doctor?.Specialty</small>
                            </td>
                            <td>@item.WorkDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.ShiftType == "Sáng") { <span class="badge badge-info">Sáng (07:30 - 11:30)</span> }
                                else if (item.ShiftType == "Chiều") { <span class="badge badge-warning text-dark">Chiều (13:30 - 17:30)</span> }
                                else if (item.ShiftType == "Tối") { <span class="badge badge-dark">Tối (18:00 - 21:00)</span> }
                                else { <span class="badge badge-secondary">@item.ShiftType</span> }
                            </td>
                            <td>@item.MaxAppointments</td>
                            <td>
                                @if (item.IsAvailable == true) { <span class="text-success"><i class="fas fa-check-circle"></i> Đang nhận khách</span> }
                                else { <span class="text-danger"><i class="fas fa-times-circle"></i> Tạm ngưng</span> }
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <div class="btn-group btn-action-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.ScheduleId" class="btn btn-action-edit" title="Sửa"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.ScheduleId" class="btn btn-action-delete" title="Xóa"><i class="fas fa-trash"></i></a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Khởi tạo DataTables nếu cần (nếu chưa load file ngôn ngữ tiếng việt)
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                },
                "order": [[1, "desc"]] // Mặc định sắp xếp theo ngày
            });
        });
    </script>
}
