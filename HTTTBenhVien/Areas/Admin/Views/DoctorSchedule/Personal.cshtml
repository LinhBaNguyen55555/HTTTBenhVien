@model IEnumerable<HTTTBenhVien.Models.DoctorSchedule>
@{
    ViewData["Title"] = "Lịch trực của tôi";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Lịch làm việc cá nhân</h1>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Các ca trực sắp tới</h6>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-calendar-times mb-2" style="font-size: 2rem;"></i><br/>
                        Chưa có lịch làm việc nào được phân công trong thời gian tới.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Ngày làm việc</th>
                                    <th>Ca trực</th>
                                    <th>Giới hạn ca khám</th>
                                    <th>Trạng thái</th>
                                    <th>Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-weight-bold text-primary">@item.WorkDate.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td>
                                            @if (item.ShiftType == "Sáng") { <span class="badge badge-info px-3 py-2">Sáng (07:30 - 11:30)</span> }
                                            else if (item.ShiftType == "Chiều") { <span class="badge badge-warning text-dark px-3 py-2">Chiều (13:30 - 17:30)</span> }
                                            else if (item.ShiftType == "Tối") { <span class="badge badge-dark px-3 py-2">Tối (18:00 - 21:00)</span> }
                                            else { <span class="badge badge-secondary px-3 py-2">@item.ShiftType</span> }
                                        </td>
                                        <td class="text-center font-weight-bold text-success">@item.MaxAppointments</td>
                                        <td>
                                            @if (item.IsAvailable == true) { <span class="text-success"><i class="fas fa-check-circle"></i> Đang mở</span> }
                                            else { <span class="text-danger"><i class="fas fa-times-circle"></i> Đã đóng</span> }
                                        </td>
                                        <td>@item.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
