@model HTTTBenhVien.Models.DoctorSchedule

@{
    ViewData["Title"] = "Xóa lịch trực";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Xác nhận xóa</h1>
    <a href="@Url.Action("Index")" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
    </a>
</div>

<div class="card shadow mb-4 border-left-danger">
    <div class="card-body">
        <div class="text-center mb-4">
            <i class="fas fa-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
            <h4 class="mt-3 font-weight-bold text-gray-800">Bạn có chắc chắn muốn xóa lịch trực này?</h4>
            <p class="text-muted">Hành động này không thể hoàn tác.</p>
        </div>

        <table class="table table-bordered">
            <tr>
                <th class="bg-light" width="30%">Bác sĩ</th>
                <td><strong>@Model.Doctor?.FullName</strong> (@Model.Doctor?.Specialty)</td>
            </tr>
            <tr>
                <th class="bg-light">Ngày làm việc</th>
                <td>@Model.WorkDate.ToString("dd/MM/yyyy")</td>
            </tr>
            <tr>
                <th class="bg-light">Ca trực</th>
                <td>@Model.ShiftType</td>
            </tr>
            <tr>
                <th class="bg-light">Trạng thái</th>
                <td>@(Model.IsAvailable == true ? "Đang mở" : "Đã đóng")</td>
            </tr>
        </table>

        <form asp-action="Delete" method="post" class="text-center mt-4">
            <input type="hidden" asp-for="ScheduleId" />
            <button type="submit" class="btn btn-danger px-4"><i class="fas fa-trash mr-2"></i>Xác nhận Xóa</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary px-4 ml-2">Hủy bỏ</a>
        </form>
    </div>
</div>
