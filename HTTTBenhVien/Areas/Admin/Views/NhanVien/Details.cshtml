@model HTTTBenhVien.Models.Employee
@{
    ViewData["Title"] = "Chi tiết nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card { border-radius: 1rem; box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08); border: none; overflow: hidden; }
    .detail-header { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; padding: 2rem; position: relative; }
    .detail-body { padding: 2rem; }
    .detail-row { display: flex; padding: 1rem 0; border-bottom: 1px solid #f0f2f5; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 35%; color: #6c757d; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .detail-value { width: 65%; color: #2d3748; font-weight: 500; }
    .profile-avatar { width: 120px; height: 120px; border-radius: 50%; border: 4px solid white; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15); object-fit: cover; }
    .header-content { display: flex; align-items: center; gap: 2rem; position: relative; z-index: 1; }
    .bg-icon { position: absolute; right: 2rem; top: 50%; transform: translateY(-50%); font-size: 8rem; opacity: 0.1; }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card detail-card">
                <div class="detail-header">
                    <i class="fas fa-user-md bg-icon"></i>
                    <div class="header-content">
                        <img src="@Model.AvatarUrlFull" class="profile-avatar" alt="Profile" />
                        <div>
                            <h2 class="mb-1 font-weight-bold">
                                @if (!string.IsNullOrEmpty(Model.AcademicTitle))
                                {
                                    <span style="font-size: 1.5rem; color: #ffd700;" class="mr-1">@Model.AcademicTitle</span>
                                }
                                @Model.FullName
                            </h2>
                            <p class="mb-0 font-weight-bold text-white-50" style="font-size: 1.1rem;">
                                @Model.JobTitle 
                                @if (!string.IsNullOrEmpty(Model.Specialty))
                                {
                                    <span>- @Model.Specialty</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="detail-body">
                    <h5 class="text-success border-bottom pb-2 mb-3"><i class="fas fa-info-circle mr-2"></i>Thông tin chuyên môn</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-hospital text-info"></i> Khoa trực thuộc</div>
                        <div class="detail-value">
                            @if (Model.Dept != null)
                            {
                                <span class="badge badge-success px-3 py-2" style="font-size: 0.9rem;">@Model.Dept.DeptName</span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa xếp khoa</span>
                            }
                        </div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-stethoscope text-primary"></i> Chuyên khoa chính</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Specialty) ? "Đa khoa / Không có" : Model.Specialty)</div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-venus-mars" style="color: #e83e8c;"></i> Giới tính</div>
                        <div class="detail-value">
                            @if (Model.Gender.HasValue)
                            {
                                @(Model.Gender.Value ? "Nam" : "Nữ")
                            }
                            else
                            {
                                <span class="text-muted">Chưa cập nhật</span>
                            }
                        </div>
                    </div>

                    <h5 class="text-success border-bottom pb-2 mt-4 mb-3"><i class="fas fa-address-book mr-2"></i>Thông tin liên hệ</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-phone-alt text-success"></i> Số điện thoại</div>
                        <div class="detail-value font-weight-bold">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-envelope text-warning"></i> Email</div>
                        <div class="detail-value text-primary">@(string.IsNullOrEmpty(Model.Email) ? "Chưa cập nhật" : Model.Email)</div>
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.EmpId" class="btn btn-primary px-4 py-2 mr-2" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border: none;">
                            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
