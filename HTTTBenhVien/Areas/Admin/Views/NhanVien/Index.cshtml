@model IEnumerable<HTTTBenhVien.Models.Employee>
@{
    ViewData["Title"] = "Quản lý Nhân Viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-gradient {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white; padding: 2rem; border-radius: 1rem; margin-bottom: 1.5rem;
        box-shadow: 0 10px 30px rgba(56, 239, 125, 0.3);
    }
    .card-ajax { border: none; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); transition: transform 0.2s, box-shadow 0.2s; overflow: hidden; }
    .card-ajax:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 2rem 0 rgba(58, 59, 69, 0.25); }
    .card-header-ajax { background: white; border-bottom: 2px solid #f8f9fe; padding: 1.25rem 1.5rem; font-weight: 600; color: #11998e; }
    .btn-gradient { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border: none; color: white; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 0.5rem; transition: all 0.3s ease; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(56, 239, 125, 0.4); color: white; }
    .btn-gradient-info { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none; color: white; }
    .btn-gradient-danger { background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none; color: white; }
    .btn-sm-gradient { padding: 0.375rem 0.75rem; font-size: 0.875rem; border-radius: 0.375rem; }
    .table-ajax thead th { background: #f8f9fc; color: #11998e; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; border: none; padding: 1rem; }
    .table-ajax tbody td { vertical-align: middle; padding: 1rem; border-color: #f0f2f8; }
    .table-ajax tbody tr:hover { background: #f8f9fe; }
    .badge-loai { padding: 0.35rem 0.65rem; border-radius: 0.35rem; font-size: 0.75rem; font-weight: 600; }
    .badge-primary { background: #e8edfc; color: #4e54c8; }
    .badge-success { background: #e6f7f1; color: #27ae60; }
    .avatar-circle { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0; }
    .empty-state { padding: 3rem; text-align: center; }
    .empty-state-icon { font-size: 4rem; color: #d1d3e0; margin-bottom: 1rem; }
    .stat-card { background: white; border-radius: 1rem; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1); }
    .stat-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; background: linear-gradient(135deg, rgba(17, 153, 142, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%); color: #11998e; }
    .stat-info h4 { font-weight: 700; margin: 0; color: #2d3748; font-size: 1.5rem; }
    .stat-info p { margin: 0; color: #a0aec0; font-size: 0.85rem; }
    .toast-custom { position: fixed; top: 20px; right: 20px; z-index: 9999; animation: slideIn 0.3s ease-out; }
    @@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
</style>

<div class="container-fluid">
    <div class="page-header-gradient">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="fas fa-user-md"></i> Quản lý Nhân viên</h1>
                <p>Danh sách y bác sĩ, y tá, nhân viên bệnh viện</p>
            </div>
            <div class="d-none d-md-block">
                <i class="fas fa-user-md" style="font-size: 4rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count()</h4>
                    <p>Tổng nhân sự</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(0, 242, 254, 0.15) 100%); color: #4facfe;"><i class="fas fa-user-tie"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(e => e.JobTitle == "Bác sĩ")</h4>
                    <p>Bác sĩ</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(235, 51, 73, 0.15) 0%, rgba(244, 92, 67, 0.15) 100%); color: #eb3349;"><i class="fas fa-user-nurse"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(e => e.JobTitle == "Y tá" || e.JobTitle == "Điều dưỡng")</h4>
                    <p>Y tá / Điều dưỡng</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ajax mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list mr-2"></i>Danh sách nhân viên</span>
            <div class="d-flex align-items-center">
                <form asp-action="Index" method="get" class="form-inline mr-3 mb-0">
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tên hoặc chức vụ..." style="border-radius: 20px 0 0 20px; outline: none; box-shadow: none;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-primary" style="border-radius: 0 20px 20px 0; background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); border: none;"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </form>
                <a asp-action="Create" class="btn btn-sm btn-gradient">
                    <i class="fas fa-plus mr-1"></i> Thêm nhân viên
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-ajax">
                        <thead>
                            <tr>
                                <th width="25%"><i class="fas fa-user mr-1"></i> Nhân viên</th>
                                <th width="15%"><i class="fas fa-hospital mr-1"></i> Khoa</th>
                                <th width="15%"><i class="fas fa-id-badge mr-1"></i> Chức vụ</th>
                                <th width="15%"><i class="fas fa-stethoscope mr-1"></i> Chuyên khoa</th>
                                <th width="15%"><i class="fas fa-phone mr-1"></i> Liên hệ</th>
                                <th width="15%" class="text-center"><i class="fas fa-cog mr-1"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.AvatarUrlFull" class="avatar-circle mr-3" alt="Avatar">
                                            <div>
                                                <strong class="text-dark">@item.FullName</strong>
                                                @if (!string.IsNullOrEmpty(item.AcademicTitle))
                                                {
                                                    <span class="badge badge-warning badge-loai ml-1" style="font-size: 0.65rem;">@item.AcademicTitle</span>
                                                }
                                                @if (item.Gender.HasValue)
                                                {
                                                    if (item.Gender.Value)
                                                    {
                                                        <i class="fas fa-mars text-primary ml-1" title="Nam"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-venus text-danger ml-1" title="Nữ"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Dept != null)
                                        {
                                            <span class="badge badge-success badge-loai">@item.Dept.DeptName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa xếp khoa</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="font-weight-bold" style="color: #4facfe;">@item.JobTitle</span>
                                    </td>
                                    <td>@item.Specialty</td>
                                    <td>
                                        <div style="font-size: 0.85rem;">
                                            <div><i class="fas fa-phone-alt text-success mr-1"></i> @item.Phone</div>
                                            <div><i class="fas fa-envelope text-primary mr-1"></i> @item.Email</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Details" asp-route-id="@item.EmpId" class="btn btn-sm btn-gradient-info btn-sm-gradient mx-1" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                            <a asp-action="Edit" asp-route-id="@item.EmpId" class="btn btn-sm btn-gradient btn-sm-gradient mx-1" title="Sửa"><i class="fas fa-edit"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.EmpId" class="btn btn-sm btn-gradient-danger btn-sm-gradient mx-1" title="Xóa"><i class="fas fa-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-user-md"></i></div>
                    <h5>Chưa có nhân viên nào</h5>
                    <p>Hãy thêm nhân viên đầu tiên vào hệ thống</p>
                    <a asp-action="Create" class="btn btn-gradient">
                        <i class="fas fa-plus mr-1"></i> Thêm nhân viên mới
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="toast-custom">
        <div class="toast show" role="alert">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle mr-2"></i>
                <strong class="mr-auto">Thành công</strong>
                <button type="button" class="ml-2 mb-1 close text-white" data-dismiss="toast"><span>&times;</span></button>
            </div>
            <div class="toast-body">
                <i class="fas fa-check text-success mr-2"></i>@TempData["Success"]
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            setTimeout(function() { $('.toast').toast('hide'); }, 4000);
        });
    </script>
}
