@model IEnumerable<HTTTBenhVien.Models.Employee>
@{
    ViewData["Title"] = "Quản lý nhân sự";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Thêm nhân viên
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <form method="get" class="form-inline">
            <input type="text" name="search" class="form-control form-control-sm mr-2" style="width:250px;" placeholder="Tìm tên, SĐT..." value="@ViewBag.Search" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i></button>
            <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary ml-1"><i class="fas fa-redo"></i></a>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Họ tên</th>
                        <th>Chức danh</th>
                        <th>Chuyên khoa</th>
                        <th>Khoa</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Tài khoản</th>
                        <th width="100">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var e in Model)
                        {
                            var roleText = e.Account?.RoleName switch
                            {
                                "Admin" => "Admin",
                                "BacSi" => "Bác sĩ",
                                "LeTan" => "Lễ tân",
                                "KeToan" => "Kế toán",
                                "DuocSi" => "Dược sĩ",
                                _ => "Staff"
                            };
                            var roleClass = e.Account?.RoleName switch
                            {
                                "Admin" => "badge-danger",
                                "BacSi" => "badge-primary",
                                "LeTan" => "badge-info",
                                "KeToan" => "badge-warning",
                                "DuocSi" => "badge-success",
                                _ => "badge-secondary"
                            };
                            <tr>
                                <td>@i</td>
                                <td><strong>@e.FullName</strong></td>
                                <td>@e.JobTitle</td>
                                <td>@e.Specialty</td>
                                <td>@e.Dept?.DeptName</td>
                                <td>@e.Email</td>
                                <td>@e.Phone</td>
                                <td>
                                    @if (e.Account != null)
                                    {
                                        <span class="badge @roleClass">@roleText</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = e.EmpId })" class="btn btn-warning btn-sm"><i class="fas fa-edit fa-xs"></i></a>
                                    <a href="@Url.Action("Delete", new { id = e.EmpId })" class="btn btn-danger btn-sm" onclick="return confirm('Xóa nhân viên này?')"><i class="fas fa-trash fa-xs"></i></a>
                                </td>
                            </tr>
                            i++;
                        }
                        if (!Model.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
