@model HTTTBenhVien.Models.Employee
@{
    ViewData["Title"] = Model.EmpId > 0 ? "Sửa nhân viên" : "Thêm nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-user-tie mr-1"></i> Thông tin nhân viên</h6>
            </div>
            <div class="card-body">
                @{
                    var isEdit = Model.EmpId > 0;
                }
                @if (isEdit)
                {
                    <form method="post" asp-action="Edit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="EmpId" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Họ tên <span class="text-danger">*</span></label>
                                    <input type="text" asp-for="FullName" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Chức danh</label>
                                    <input type="text" asp-for="JobTitle" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Chuyên khoa</label>
                                    <input type="text" asp-for="Specialty" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Khoa</label>
                                    <select asp-for="DeptId" class="form-control">
                                        <option value="">-- Chọn khoa --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Email</label>
                                    <input type="email" asp-for="Email" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Số điện thoại</label>
                                    <input type="text" asp-for="Phone" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Địa chỉ</label>
                            <input type="text" asp-for="Address" class="form-control" />
                        </div>
                        <div class="text-right mt-3">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                        </div>
                    </form>
                }
                else
                {
                    <form method="post" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Họ tên <span class="text-danger">*</span></label>
                                    <input type="text" asp-for="FullName" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Chức danh</label>
                                    <input type="text" asp-for="JobTitle" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Chuyên khoa</label>
                                    <input type="text" asp-for="Specialty" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Khoa</label>
                                    <select asp-for="DeptId" class="form-control">
                                        <option value="">-- Chọn khoa --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Email</label>
                                    <input type="email" asp-for="Email" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="font-weight-bold">Số điện thoại</label>
                                    <input type="text" asp-for="Phone" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="text-right mt-3">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
