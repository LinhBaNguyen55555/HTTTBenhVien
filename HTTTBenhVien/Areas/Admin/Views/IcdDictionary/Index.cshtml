@model IEnumerable<HTTTBenhVien.Models.IcdDictionary>

@{
    ViewData["Title"] = "Từ điển mã bệnh (ICD-10)";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header { background: linear-gradient(135deg, #4e73df, #224abe); color: white; padding: 2rem; border-radius: 1rem; margin-bottom: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    .page-title { font-weight: 800; font-size: 1.75rem; margin-bottom: 0.5rem; }
    .page-subtitle { color: rgba(255,255,255,0.8); font-size: 1rem; margin-bottom: 0; }
    
    .data-card { background: white; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); overflow: hidden; border: none; }
    .data-card-header { background: #f8f9fc; border-bottom: 1px solid #e3e6f0; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    
    .table-hover tbody tr:hover { background-color: rgba(78, 115, 223, 0.05); transform: translateY(-1px); transition: all 0.2s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .table th { border-top: none; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.05em; color: #858796; }
    .table td { vertical-align: middle; }
    
    .icd-code-badge { background: #e8eaef; color: #4e73df; font-weight: 700; padding: 0.4rem 0.8rem; border-radius: 0.5rem; display: inline-block; font-family: monospace; font-size: 0.9rem; }
    
    .btn-action { width: 35px; height: 35px; padding: 0; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; margin: 0 2px; transition: all 0.2s; }
    .btn-action:hover { transform: scale(1.15); }
    
    .status-badge { padding: 0.4rem 0.8rem; border-radius: 50rem; font-size: 0.8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem; }
    .status-active { background-color: rgba(28, 200, 138, 0.1); color: #1cc88a; }
    .status-inactive { background-color: rgba(231, 74, 59, 0.1); color: #e74a3b; }
    
    .filter-container { background: white; border-radius: 1rem; padding: 1.5rem; margin-bottom: 2rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 10px; border-left: 5px solid #1cc88a;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 10px; border-left: 5px solid #e74a3b;">
            <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-title"><i class="fas fa-book-medical mr-3"></i>Từ điển mã bệnh ICD-10</h1>
                <p class="page-subtitle">Quản lý và tra cứu danh mục mã bệnh theo tiêu chuẩn quốc tế</p>
            </div>
            <div class="col-md-4 text-md-right mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-light text-primary font-weight-bold px-4 py-2" style="border-radius: 50rem;">
                    <i class="fas fa-plus-circle mr-2"></i> Thêm mã bệnh mới
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-container">
        <form asp-action="Index" method="get">
            <div class="row align-items-end">
                <div class="col-md-5 mb-3 mb-md-0">
                    <label class="font-weight-bold text-gray-700 small">Tìm kiếm mã hoặc tên bệnh</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-search text-gray-500"></i></span>
                        </div>
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-light border-left-0" placeholder="Nhập từ khóa...">
                    </div>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <label class="font-weight-bold text-gray-700 small">Lọc theo chương</label>
                    <select name="chapterFilter" class="form-control bg-light">
                        <option value="">-- Tất cả các chương --</option>
                        @if (ViewBag.Chapters != null)
                        {
                            foreach (var chapter in ViewBag.Chapters)
                            {
                                if (ViewData["ChapterFilter"]?.ToString() == chapter)
                                {
                                    <option value="@chapter" selected>@chapter</option>
                                }
                                else
                                {
                                    <option value="@chapter">@chapter</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary btn-block" style="border-radius: 0.5rem;">
                        <i class="fas fa-filter mr-2"></i> Lọc dữ liệu
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="data-card mb-5">
        <div class="data-card-header">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list mr-2"></i>Danh sách mã bệnh (@Model.Count())</h6>
            @if (ViewData["CurrentFilter"] != null || ViewData["ChapterFilter"] != null)
            {
                <a asp-action="Index" class="btn btn-sm btn-secondary" style="border-radius: 50rem;">
                    <i class="fas fa-sync-alt mr-1"></i> Bỏ lọc
                </a>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th width="15%" class="pl-4">Mã ICD</th>
                        <th width="35%">Tên bệnh</th>
                        <th width="25%">Chương/Nhóm</th>
                        <th width="15%" class="text-center">Trạng thái</th>
                        <th width="10%" class="text-center pr-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="pl-4">
                                <span class="icd-code-badge">@item.IcdCode</span>
                            </td>
                            <td>
                                <span class="font-weight-bold text-gray-800">@item.DiseaseName</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Chapter))
                                {
                                    <span class="badge badge-light border text-gray-700 px-2 py-1" style="font-size: 0.85rem;"><i class="fas fa-bookmark mr-1 text-primary"></i>@item.Chapter</span>
                                }
                                else
                                {
                                    <span class="text-muted font-italic">Chưa phân loại</span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleStatus" asp-route-id="@item.IcdCode" method="post" style="display: inline;">
                                    <button type="submit" class="border-0 bg-transparent p-0" title="Nhấn để đổi trạng thái">
                                        @if (item.IsActive == true)
                                        {
                                            <span class="status-badge status-active"><i class="fas fa-check-circle"></i> Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive"><i class="fas fa-ban"></i> Đã khóa</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="text-center pr-4">
                                <a asp-action="Edit" asp-route-id="@item.IcdCode" class="btn btn-info btn-action shadow-sm" title="Sửa">
                                    <i class="fas fa-pen fa-sm"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.IcdCode" class="btn btn-danger btn-action shadow-sm" title="Xóa">
                                    <i class="fas fa-trash fa-sm"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <img src="~/admin/img/undraw_empty.svg" alt="No data" style="width: 120px; opacity: 0.5; margin-bottom: 1rem;" />
                                <h5 class="text-gray-500">Không tìm thấy mã bệnh nào</h5>
                                <p class="text-muted">Thử thay đổi từ khóa tìm kiếm hoặc bỏ lọc.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
