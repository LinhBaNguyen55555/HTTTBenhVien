@model HTTTBenhVien.Models.IcdDictionary

@{
    ViewData["Title"] = "Xóa mã bệnh";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    
    bool canDelete = true;
    if (Model.MedicalRecords != null && Model.MedicalRecords.Any())
    {
        canDelete = false;
    }
}

<style>
    .delete-card { background: white; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); border: none; overflow: hidden; }
    .delete-card-header { background: linear-gradient(135deg, #e74a3b, #c0392b); color: white; padding: 1.5rem; }
    .delete-card-title { font-weight: 700; margin: 0; font-size: 1.25rem; }
    .delete-card-body { padding: 2.5rem 2rem; }
    
    .info-label { color: #858796; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.25rem; }
    .info-value { color: #3a3b45; font-size: 1.1rem; font-weight: 600; margin-bottom: 1.5rem; }
    
    .btn-action { border-radius: 50rem; padding: 0.5rem 1.5rem; font-weight: 600; letter-spacing: 0.05em; transition: all 0.2s; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    
    .warning-box { background-color: rgba(246, 194, 62, 0.1); border-left: 4px solid #f6c23e; padding: 1rem 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem; }
    .danger-box { background-color: rgba(231, 74, 59, 0.1); border-left: 4px solid #e74a3b; padding: 1rem 1.5rem; border-radius: 0.5rem; margin-bottom: 2rem; }
</style>

<div class="container-fluid mb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item"><a asp-action="Index">Từ điển mã bệnh</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xóa mã @Model.IcdCode</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="delete-card">
                <div class="delete-card-header">
                    <h5 class="delete-card-title"><i class="fas fa-exclamation-triangle mr-2"></i>Xác nhận xóa mã bệnh</h5>
                </div>
                <div class="delete-card-body">
                    
                    @if (canDelete)
                    {
                        <div class="warning-box">
                            <h6 class="font-weight-bold text-warning mb-1"><i class="fas fa-exclamation-circle mr-1"></i> Cảnh báo!</h6>
                            <p class="mb-0 text-gray-700">Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa mã bệnh dưới đây khỏi hệ thống?</p>
                        </div>
                    }
                    else
                    {
                        <div class="danger-box">
                            <h6 class="font-weight-bold text-danger mb-2"><i class="fas fa-ban mr-1"></i> Không thể xóa mã bệnh này!</h6>
                            <p class="mb-0 text-gray-700">
                                Mã bệnh <strong>@Model.IcdCode</strong> đang được sử dụng trong <strong>@Model.MedicalRecords.Count()</strong> hồ sơ bệnh án. 
                                <br/>Để đảm bảo tính toàn vẹn dữ liệu, bạn chỉ có thể <strong>Khóa (Vô hiệu hóa)</strong> mã bệnh này thay vì xóa.
                            </p>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-4">
                            <div class="info-label">Mã ICD</div>
                            <div class="info-value text-primary"><span class="badge badge-light border px-2 py-1" style="font-family: monospace; font-size: 1rem;">@Model.IcdCode</span></div>
                        </div>
                        <div class="col-md-8">
                            <div class="info-label">Tên bệnh</div>
                            <div class="info-value">@Model.DiseaseName</div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-label">Chương / Nhóm bệnh</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.Chapter) ? "Chưa phân loại" : Model.Chapter)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-label">Trạng thái hiện tại</div>
                            <div class="info-value">
                                @if (Model.IsActive == true)
                                {
                                    <span class="text-success"><i class="fas fa-check-circle mr-1"></i> Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fas fa-ban mr-1"></i> Đã khóa</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="mt-4 mb-4">

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IcdCode" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-light btn-action text-gray-700 border">
                                <i class="fas fa-arrow-left mr-2"></i> Trở về danh sách
                            </a>
                            
                            @if (canDelete)
                            {
                                <button type="submit" class="btn btn-danger btn-action">
                                    <i class="fas fa-trash-alt mr-2"></i> Xác nhận Xóa
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger btn-action" disabled style="opacity: 0.5; cursor: not-allowed;">
                                    <i class="fas fa-trash-alt mr-2"></i> Xác nhận Xóa
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
