@model HTTTBenhVien.Models.RecordService
@{
    ViewData["Title"] = "Cập nhật Chỉ định CLS";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .card-header-gradient { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
        <div class="card-header card-header-gradient py-3">
            <h6 class="m-0 font-weight-bold"><i class="fas fa-edit mr-2"></i>Cập nhật chỉ định #@Model.RsId</h6>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="RsId" />

                <h5 class="border-bottom pb-2 mb-4" style="color: #f5576c;"><i class="fas fa-link mr-2"></i>Liên kết dữ liệu</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="RecordId" class="font-weight-bold">Bệnh án <span class="text-danger">*</span></label>
                            <select asp-for="RecordId" class="form-control" asp-items="ViewBag.RecordId" required>
                                <option value="">-- Chọn Bệnh án --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="ServiceId" class="font-weight-bold">Dịch vụ CLS <span class="text-danger">*</span></label>
                            <select asp-for="ServiceId" class="form-control" asp-items="ViewBag.ServiceId" required>
                                <option value="">-- Chọn Dịch vụ --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="DoctorId" class="font-weight-bold">Bác sĩ thực hiện <span class="text-danger">*</span></label>
                            <select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorId" required>
                                <option value="">-- Chọn Bác sĩ --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <h5 class="border-bottom pb-2 mt-4 mb-4" style="color: #f5576c;"><i class="fas fa-clipboard-check mr-2"></i>Thông tin thực hiện</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="ExecuteDate" class="font-weight-bold">Ngày thực hiện</label>
                            <input asp-for="ExecuteDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="Status" class="font-weight-bold">Trạng thái</label>
                            <select asp-for="Status" class="form-control">
                                <option value="Chờ thực hiện">Chờ thực hiện</option>
                                <option value="Đang thực hiện">Đang thực hiện</option>
                                <option value="Đã có kết quả">Đã có kết quả</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label asp-for="ResultImages" class="font-weight-bold">Link ảnh kết quả</label>
                            <input asp-for="ResultImages" class="form-control" placeholder="URL hình ảnh" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group mb-3">
                            <label asp-for="ResultValue" class="font-weight-bold">Kết quả xét nghiệm / Mô tả kết quả</label>
                            <textarea asp-for="ResultValue" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                </div>

                <hr class="mt-4 mb-4" />
                <div class="text-center">
                    <button type="submit" class="btn px-5 py-2 mr-3" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border: none; color: white; font-weight: 600;">
                        <i class="fas fa-save mr-2"></i> Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-5 py-2">
                        <i class="fas fa-arrow-left mr-2"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
