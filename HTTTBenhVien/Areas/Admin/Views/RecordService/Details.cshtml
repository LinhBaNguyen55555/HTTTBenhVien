@model HTTTBenhVien.Models.RecordService
@{
    ViewData["Title"] = "Chi tiết Chỉ định CLS";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card { border-radius: 1rem; box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08); border: none; overflow: hidden; }
    .detail-header { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 2rem; position: relative; }
    .detail-body { padding: 2rem; }
    .detail-row { display: flex; padding: 0.85rem 0; border-bottom: 1px solid #f0f2f5; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 35%; color: #6c757d; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .detail-value { width: 65%; color: #2d3748; font-weight: 500; }
    .bg-icon { position: absolute; right: 2rem; top: 50%; transform: translateY(-50%); font-size: 8rem; opacity: 0.1; }
    .result-box { background: #f8f9fe; border-radius: 0.75rem; padding: 1.5rem; border-left: 4px solid #f5576c; margin-top: 1rem; }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card detail-card">
                <div class="detail-header">
                    <i class="fas fa-vials bg-icon"></i>
                    <div style="position: relative; z-index: 1;">
                        <h2 class="mb-2 font-weight-bold">Chỉ định CLS #@Model.RsId</h2>
                        <p class="mb-0" style="opacity: 0.9;">Dịch vụ: <strong>@(Model.Service?.ServiceName ?? "N/A")</strong></p>
                    </div>
                </div>

                <div class="detail-body">
                    <div class="text-center mb-4">
                        @switch (Model.Status)
                        {
                            case "Chờ thực hiện":
                                <span class="badge badge-warning px-4 py-2" style="font-size: 0.95rem;"><i class="fas fa-hourglass-half mr-2"></i>Chờ thực hiện</span>
                                break;
                            case "Đang thực hiện":
                                <span class="badge badge-info text-white px-4 py-2" style="font-size: 0.95rem;"><i class="fas fa-spinner mr-2"></i>Đang thực hiện</span>
                                break;
                            case "Đã có kết quả":
                                <span class="badge badge-success text-white px-4 py-2" style="font-size: 0.95rem;"><i class="fas fa-check-circle mr-2"></i>Đã có kết quả</span>
                                break;
                            default:
                                <span class="badge badge-secondary px-4 py-2" style="font-size: 0.95rem;">@Model.Status</span>
                                break;
                        }
                    </div>

                    <h5 class="border-bottom pb-2 mb-3" style="color: #f5576c;"><i class="fas fa-link mr-2"></i>Thông tin liên kết</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user-injured text-primary"></i> Bệnh nhân</div>
                        <div class="detail-value font-weight-bold">@(Model.Record?.Patient?.FullName ?? "N/A")</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-file-medical text-info"></i> Mã bệnh án</div>
                        <div class="detail-value"><span class="badge badge-light border px-3 py-1">BA #@Model.RecordId</span></div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-medkit text-danger"></i> Dịch vụ</div>
                        <div class="detail-value font-weight-bold" style="color: #f5576c;">@(Model.Service?.ServiceName ?? "N/A")</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user-md text-success"></i> BS thực hiện</div>
                        <div class="detail-value text-primary font-weight-bold">@(Model.Doctor?.FullName ?? "N/A")</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="far fa-calendar-alt text-warning"></i> Ngày thực hiện</div>
                        <div class="detail-value">@(Model.ExecuteDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thực hiện")</div>
                    </div>

                    <h5 class="border-bottom pb-2 mt-4 mb-3" style="color: #f5576c;"><i class="fas fa-flask mr-2"></i>Kết quả</h5>
                    <div class="result-box">
                        @if (!string.IsNullOrEmpty(Model.ResultValue))
                        {
                            <p style="white-space: pre-line; margin: 0;">@Model.ResultValue</p>
                        }
                        else
                        {
                            <p class="text-muted font-italic mb-0"><i class="fas fa-info-circle mr-1"></i> Chưa có kết quả. Vui lòng cập nhật sau khi thực hiện dịch vụ.</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ResultImages))
                    {
                        <div class="mt-3">
                            <h6 class="font-weight-bold"><i class="fas fa-images text-primary mr-1"></i> Hình ảnh kết quả:</h6>
                            <a href="@Model.ResultImages" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-external-link-alt mr-1"></i> Xem hình ảnh
                            </a>
                        </div>
                    }

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.RsId" class="btn px-4 py-2 mr-2" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); border: none; color: white; font-weight: 600;">
                            <i class="fas fa-edit mr-1"></i> Cập nhật kết quả
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
