@model HTTTBenhVien.Models.RecordService
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Phiếu Kết Quả #@Model.RsId</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Times New Roman', serif; font-size: 14px; color: #333; padding: 20px; }
        .print-container { max-width: 800px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #0891b2; padding-bottom: 15px; }
        .header h2 { color: #0891b2; margin-bottom: 5px; }
        .header h3 { font-size: 18px; color: #333; text-transform: uppercase; letter-spacing: 1px; }
        .header p { color: #666; font-size: 13px; }
        .info-section { display: flex; justify-content: space-between; margin-bottom: 20px; }
        .info-section .col { width: 48%; }
        .info-row { margin-bottom: 5px; }
        .info-row label { font-weight: bold; min-width: 140px; display: inline-block; }
        .result-box { border: 2px solid #0891b2; border-radius: 8px; padding: 20px; margin-bottom: 20px; min-height: 200px; background-color: #f0fdfa; }
        .result-box h4 { color: #0891b2; margin-bottom: 10px; border-bottom: 1px dashed #0891b2; padding-bottom: 8px; }
        .result-box pre { white-space: pre-wrap; font-family: 'Times New Roman', serif; font-size: 14px; line-height: 1.6; }
        .signature-section { display: flex; justify-content: space-between; margin-top: 40px; text-align: center; }
        .signature-section .sig { width: 45%; }
        .signature-section .sig p:first-child { font-weight: bold; }
        .signature-section .sig p:last-child { margin-top: 60px; font-style: italic; }
        .btn-actions { text-align: center; margin-top: 20px; }
        .btn-actions button { padding: 10px 30px; font-size: 14px; cursor: pointer; margin: 0 5px; border-radius: 5px; border: none; }
        .btn-print { background-color: #0891b2; color: white; }
        .btn-close { background-color: #999; color: white; }
        @@media print { .btn-actions { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    <div class="print-container">
        <div class="header">
            <h2>🏥 BỆNH VIỆN VINHUNI HIS</h2>
            <p>Địa chỉ: 123 Nguyễn Văn Linh, TP. Vinh, Nghệ An | ĐT: 0238.123.4567</p>
            <h3>PHIẾU KẾT QUẢ CẬN LÂM SÀNG</h3>
            <p>Số: <strong>#@Model.RsId</strong> | Ngày trả: <strong>@(Model.ExecuteDate?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</strong></p>
        </div>

        <div class="info-section">
            <div class="col">
                <div class="info-row"><label>Bệnh nhân:</label> <strong>@Model.Record?.Patient?.FullName</strong></div>
                <div class="info-row"><label>Mã bệnh nhân:</label> @Model.Record?.Patient?.PatientCode</div>
                <div class="info-row"><label>Điện thoại:</label> @Model.Record?.Patient?.Phone</div>
            </div>
            <div class="col">
                <div class="info-row"><label>Dịch vụ thực hiện:</label> <strong>@Model.Service?.ServiceName</strong></div>
                <div class="info-row"><label>BS chỉ định:</label> @Model.Doctor?.FullName</div>
                <div class="info-row"><label>Mã hồ sơ:</label> BA#@Model.RecordId</div>
            </div>
        </div>

        <div class="result-box">
            <h4>📋 KẾT QUẢ</h4>
            <pre>@(Model.ResultValue ?? "Chưa có kết quả")</pre>
        </div>

        @if (!string.IsNullOrEmpty(Model.ResultImages))
        {
            <div style="margin-bottom: 20px;">
                <strong>🖼️ Hình ảnh kết quả:</strong>
                <p><a href="@Model.ResultImages" target="_blank">@Model.ResultImages</a></p>
            </div>
        }

        <div class="signature-section">
            <div class="sig">
                <p>Bác sĩ chỉ định</p>
                <p>(Ký, ghi rõ họ tên)</p>
            </div>
            <div class="sig">
                <p>Kỹ thuật viên thực hiện</p>
                <p>(Ký, ghi rõ họ tên)</p>
            </div>
        </div>

        <div class="btn-actions">
            <button class="btn-print" onclick="window.print()">🖨️ In phiếu</button>
            <button class="btn-close" onclick="window.close()">✖ Đóng</button>
        </div>
    </div>
</body>
</html>
