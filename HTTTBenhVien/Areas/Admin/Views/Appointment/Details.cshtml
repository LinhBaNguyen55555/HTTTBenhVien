@model HTTTBenhVien.Models.Appointment
@{
    ViewData["Title"] = "Chi tiết Lịch hẹn";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .detail-card { border-radius: 1rem; box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08); border: none; overflow: hidden; }
    .detail-header { background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); color: white; padding: 2rem; position: relative; }
    .detail-body { padding: 2rem; }
    .detail-row { display: flex; padding: 1rem 0; border-bottom: 1px solid #f0f2f5; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { width: 35%; color: #6c757d; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .detail-value { width: 65%; color: #2d3748; font-weight: 500; }
    .header-content { position: relative; z-index: 1; }
    .bg-icon { position: absolute; right: 2rem; top: 50%; transform: translateY(-50%); font-size: 8rem; opacity: 0.1; }
    .badge-status { padding: 0.5rem 1rem; border-radius: 2rem; font-weight: 600; font-size: 0.9rem; }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card detail-card">
                <div class="detail-header text-center">
                    <i class="fas fa-calendar-check bg-icon"></i>
                    <div class="header-content">
                        <h2 class="mb-2 font-weight-bold">Lịch hẹn khám bệnh</h2>
                        <p class="mb-0 text-white" style="font-size: 1.1rem; opacity: 0.9;">
                            Mã số: <strong>#@Model.AppId</strong> - Tạo ngày: @(Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                        </p>
                    </div>
                </div>
                
                <div class="detail-body">
                    <div class="text-center mb-4">
                        @switch (Model.Status)
                        {
                            case "New":
                                <span class="badge badge-info badge-status text-white" style="background-color: #4facfe;"><i class="fas fa-star mr-2"></i>Trạng thái: Mới đặt</span>
                                break;
                            case "Confirmed":
                                <span class="badge badge-primary badge-status text-white" style="background-color: #11998e;"><i class="fas fa-check mr-2"></i>Trạng thái: Đã xác nhận</span>
                                break;
                            case "Completed":
                                <span class="badge badge-success badge-status text-white" style="background-color: #28a745;"><i class="fas fa-check-double mr-2"></i>Trạng thái: Đã hoàn thành</span>
                                break;
                            case "Cancelled":
                                <span class="badge badge-danger badge-status text-white" style="background-color: #eb3349;"><i class="fas fa-times mr-2"></i>Trạng thái: Đã hủy</span>
                                break;
                            default:
                                <span class="badge badge-secondary badge-status">@Model.Status</span>
                                break;
                        }
                    </div>

                    <h5 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-clock mr-2"></i>Thời gian khám</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="far fa-calendar-alt text-primary"></i> Ngày khám</div>
                        <div class="detail-value font-weight-bold text-dark" style="font-size: 1.1rem;">@(Model.AppDate?.ToString("dd/MM/yyyy") ?? "Chưa có")</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="far fa-clock text-warning"></i> Khung giờ</div>
                        <div class="detail-value text-danger font-weight-bold">@(string.IsNullOrEmpty(Model.TimeSlot) ? "Chưa chọn" : Model.TimeSlot)</div>
                    </div>

                    <h5 class="text-primary border-bottom pb-2 mt-4 mb-3"><i class="fas fa-users mr-2"></i>Thông tin đối tác</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user-injured text-success"></i> Bệnh nhân</div>
                        <div class="detail-value">
                            @if (Model.Patient != null)
                            {
                                <strong>@Model.Patient.FullName</strong> 
                                <span class="text-muted ml-2">(@(Model.Patient.Gender ? "Nam" : "Nữ") - @(Model.Patient.Phone))</span>
                            }
                            else
                            {
                                <span class="text-danger">Lỗi dữ liệu bệnh nhân</span>
                            }
                        </div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-user-md text-info"></i> Bác sĩ phụ trách</div>
                        <div class="detail-value">
                            @if (Model.Doctor != null)
                            {
                                <strong class="text-primary">@Model.Doctor.FullName</strong>
                                <span class="badge badge-light border ml-2">@Model.Doctor.Specialty</span>
                            }
                            else
                            {
                                <span class="text-muted font-italic">Chưa phân công bác sĩ</span>
                            }
                        </div>
                    </div>

                    <h5 class="text-primary border-bottom pb-2 mt-4 mb-3"><i class="fas fa-stethoscope mr-2"></i>Nội dung khám</h5>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-notes-medical text-danger"></i> Lý do khám</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Reason) ? "Không có" : Model.Reason)</div>
                    </div>
                    <div class="detail-row">
                        <div class="detail-label"><i class="fas fa-comment-medical text-warning"></i> Ghi chú</div>
                        <div class="detail-value">@(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú" : Model.Notes)</div>
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.AppId" class="btn btn-primary px-4 py-2 mr-2" style="background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); border: none; color: white;">
                            <i class="fas fa-edit mr-1"></i> Cập nhật trạng thái
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
