@model IEnumerable<HTTTBenhVien.Models.Department>
@{
    ViewData["Title"] = "Quản lý khoa - phòng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Thêm khoa mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="row mb-4">
    @{
        var grouped = Model.GroupBy(d => d.DeptType);
        foreach (var group in grouped)
        {
            <div class="col-lg-6 mb-4">
                <div class="card shadow">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-building mr-1"></i> @group.Key</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Tên khoa</th>
                                    <th>Vị trí</th>
                                    <th>Bác sĩ</th>
                                    <th width="80">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in group)
                                {
                                    <tr>
                                        <td><strong>@dept.DeptName</strong></td>
                                        <td>@dept.Location</td>
                                        <td>@(dept.Employees?.Count ?? 0)</td>
                                        <td>
                                            <a href="@Url.Action("Edit", new { id = dept.DeptId })" class="btn btn-warning btn-sm"><i class="fas fa-edit fa-xs"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>
