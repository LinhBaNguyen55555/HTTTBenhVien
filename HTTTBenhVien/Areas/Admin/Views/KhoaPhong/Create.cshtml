@model HTTTBenhVien.Models.Department
@{
    ViewData["Title"] = Model.DeptId > 0 ? "Sửa khoa" : "Thêm khoa mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-building mr-1"></i> Thông tin khoa</h6>
            </div>
            <div class="card-body">
                @if (Model.DeptId > 0)
                {
                    <form method="post" asp-action="Edit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DeptId" />
                        <div class="form-group">
                            <label class="font-weight-bold">Tên khoa <span class="text-danger">*</span></label>
                            <input type="text" asp-for="DeptName" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Loại khoa</label>
                            <select asp-for="DeptType" class="form-control">
                                <option value="Lâm sàng">Lâm sàng</option>
                                <option value="Cận lâm sàng">Cận lâm sàng</option>
                                <option value="Hành chính">Hành chính</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Vị trí</label>
                            <input type="text" asp-for="Location" class="form-control" placeholder="VD: Tầng 2 - Nhà A" />
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                        </div>
                    </form>
                }
                else
                {
                    <form method="post" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label class="font-weight-bold">Tên khoa <span class="text-danger">*</span></label>
                            <input type="text" asp-for="DeptName" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Loại khoa</label>
                            <select asp-for="DeptType" class="form-control">
                                <option value="Lâm sàng">Lâm sàng</option>
                                <option value="Cận lâm sàng">Cận lâm sàng</option>
                                <option value="Hành chính">Hành chính</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="font-weight-bold">Vị trí</label>
                            <input type="text" asp-for="Location" class="form-control" />
                        </div>
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
