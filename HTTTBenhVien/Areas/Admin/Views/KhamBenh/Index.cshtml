@model IEnumerable<HTTTBenhVien.Models.Appointment>
@{
    ViewData["Title"] = "Phòng khám";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách bệnh nhân đang chờ khám hôm nay</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Giờ</th>
                        <th>Mã BN</th>
                        <th>Bệnh nhân</th>
                        <th>Giới tính</th>
                        <th>Năm sinh</th>
                        <th>SĐT</th>
                        <th>Bác sĩ</th>
                        <th>Lý do</th>
                        <th width="100">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var a in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td><strong>@a.TimeSlot</strong></td>
                                <td><code>@a.Patient?.PatientCode</code></td>
                                <td><strong>@a.Patient?.FullName</strong></td>
                                <td>@a.Patient?.Gender</td>
                                <td>@a.Patient?.Dob?.ToString("yyyy")</td>
                                <td>@a.Patient?.Phone</td>
                                <td>@a.Doctor?.FullName</td>
                                <td class="text-truncate" style="max-width:150px;">@a.Reason</td>
                                <td>
                                    <a href="@Url.Action("Create", new { appointmentId = a.AppId })" class="btn btn-primary btn-sm" title="Bắt đầu khám">
                                        <i class="fas fa-stethoscope fa-xs"></i> Khám
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                        if (!Model.Any())
                        {
                            <tr><td colspan="10" class="text-center text-muted py-4">Không có bệnh nhân nào đang chờ khám</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
