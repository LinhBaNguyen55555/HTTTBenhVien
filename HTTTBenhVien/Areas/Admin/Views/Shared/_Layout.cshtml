                        </div>
                    </li>

                    <div class="topbar-divider d-none d-sm-block"></div>

                    <li class="nav-item dropdown no-arrow">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="mr-2 d-none d-lg-inline text-gray-600 small font-weight-bold">
                                @User.Identity?.Name
                            </span>
                            <div class="user-avatar avatar-primary">
                                @((User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U"))
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                             aria-labelledby="userDropdown">
                            <a class="dropdown-item" href="@Url.Action("Profile", "Account", new { area = "Admin" })">
                                <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                Hồ sơ cá nhân
                            </a>
                            <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account", new { area = "Admin" })">
                                <i class="fas fa-key fa-sm fa-fw mr-2 text-gray-400"></i>
                                Đổi mật khẩu
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-danger" href="#" data-toggle="modal" data-target="#logoutModal">
                                <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                Đăng xuất
                            </a>
                        </div>
                    </li>

                </ul>
            </nav>

            <div class="container-fluid">
                @RenderBody()
            </div>

            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; VinhuniHIS @DateTime.Now.Year — Hệ thống Quản lý Thông tin Bệnh viện</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"><i class="fas fa-sign-out-alt mr-2 text-primary"></i>Xác nhận đăng xuất</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="text-center">
                        <i class="fas fa-question-circle fa-3x text-warning mb-3"></i>
                        <p>Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal"><i class="fas fa-times mr-1"></i>Hủy</button>
                    <a class="btn btn-primary" href="@Url.Action("Logout", "Account", new { area = "Admin" })"><i class="fas fa-sign-out-alt mr-1"></i>Đăng xuất</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle mr-2 text-danger"></i>Xác nhận xóa</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p id="confirmDeleteMsg">Bạn có chắc chắn muốn xóa mục này? Hành động này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal"><i class="fas fa-times mr-1"></i>Hủy</button>
                    <a class="btn btn-danger" id="confirmDeleteBtn" href="#"><i class="fas fa-trash mr-1"></i>Xóa</a>
                </div>
            </div>
        </div>
    </div>

    <div id="toast-container"></div>

    <script src="~/admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/admin/js/sb-admin-2.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function() {
            // DataTable defaults
            if ($('#dataTable').length) {
                $('#dataTable').DataTable({
                    "language": {
                        "lengthMenu": "Hiển thị _MENU_ dòng",
                        "zeroRecords": "Không tìm thấy dữ liệu",
                        "info": "Trang _PAGE_ / _PAGES_",
                        "infoEmpty": "Không có dữ liệu",
                        "search": "Tìm kiếm:",
                        "paginate": {
                            "first": "Đầu",
                            "last": "Cuối",
                            "next": "Sau",
                            "previous": "Trước"
                        }
                    },
                    "order": [[0, 'asc']],
                    "pageLength": 25,
                    "responsive": true
                });
            }

            // Toast notifications from TempData
            @if (TempData["Success"] != null)
            {
                <text>toastr.success('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["Success"]!.ToString()))', 'Thành công');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>toastr.error('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(TempData["Error"]!.ToString()))', 'Lỗi');</text>
            }

            // Confirm delete
            $('a[href*="Delete"], a[href*="Xoa"]').each(function() {
                if (!$(this).data('noprompt')) {
                    $(this).on('click', function(e) {
                        e.preventDefault();
                        var href = $(this).attr('href');
                        var msg = $(this).data('msg') || 'Bạn có chắc chắn muốn xóa mục này? Hành động này không thể hoàn tác.';
                        $('#confirmDeleteMsg').text(msg);
                        $('#confirmDeleteBtn').attr('href', href);
                        $('#confirmDeleteModal').modal('show');
                    });
                }
            });

            // Smooth scroll
            $('.scroll-to-top').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate({ scrollTop: 0 }, 300);
            });
        });
    </script>

</body>

</html>
