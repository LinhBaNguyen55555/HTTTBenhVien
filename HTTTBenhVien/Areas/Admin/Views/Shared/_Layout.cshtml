<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="VinhuniHIS - Hệ thống Quản lý Thông tin Bệnh viện">
    <title>@ViewData["Title"] - VinhuniHIS</title>
    <link href="~/admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="~/admin/css/sb-admin-2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    @* Responsive CSS must be in a separate style tag *@
    <style>
        @@media (max-width: 768px) {
            .container-fluid { padding: 12px 15px; }
            .stat-card .stat-value { font-size: 20px; }
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
    <style>
        :root {
            --sidebar-bg: #1a5276;
            --sidebar-hover: #2471a3;
            --sidebar-active: #2e86c1;
            --topbar-bg: #ffffff;
            --brand-primary: #175cdd;
            --success: #1cc88a;
            --danger: #e74a3b;
            --warning: #f6c23e;
            --info: #36b9cc;
        }
        body { font-family: 'Nunito', sans-serif; background: #f0f4f8; }
        #accordionSidebar { background: var(--sidebar-bg); }
        .sidebar-brand { padding: 12px 10px; text-decoration: none; }
        .sidebar-brand-icon i { font-size: 22px; color: #85c1e9; }
        .sidebar-brand-text { font-size: 14px; font-weight: 800; color: #fff; }
        @@media (min-width: 768px) { .sidebar-brand-text { display: none; } }
        .nav-item .nav-link { padding: 11px 18px; font-size: 13.5px; color: #d5e6f1; border-radius: 8px; margin: 2px 10px; transition: all 0.25s ease; }
        .nav-item .nav-link:hover { background: var(--sidebar-hover); color: #fff; transform: translateX(4px); }
        .nav-item .nav-link.active { background: var(--sidebar-active); color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.2); }
        .nav-item .nav-link i { margin-right: 10px; width: 20px; text-align: center; }
        .sidebar-heading { padding: 8px 20px 4px; color: #85c1e9; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .sidebar-divider { border-top: 1px solid rgba(255,255,255,0.12); margin: 4px 15px; }
        .topbar { background: var(--topbar-bg) !important; box-shadow: 0 2px 12px rgba(0,0,0,0.08) !important; }
        .navbar-search .form-control { border-radius: 20px; font-size: 14px; }
        .topbar-divider { border-right: 1px solid #e9ecef; }
        .dropdown-list { min-width: 300px; }
        .dropdown-list .dropdown-item { padding: 10px 15px; font-size: 13px; border-bottom: 1px solid #f0f0f0; transition: background 0.15s; }
        .dropdown-list .dropdown-item:hover { background: #f8f9fc; }
        .dropdown-list .dropdown-item:last-child { border-bottom: none; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
        .card:hover { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
        .card-header { border-radius: 12px 12px 0 0 !important; padding: 14px 20px; font-weight: 700; }
        .btn-primary { background: #175cdd; border-color: #175cdd; }
        .btn-primary:hover { background: #1448b8; border-color: #1448b8; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(23,92,221,0.3); }
        .btn-success { background: var(--success); border-color: var(--success); }
        .btn-success:hover { background: #17a673; border-color: #17a673; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(28,200,138,0.3); }
        .btn-danger { background: var(--danger); border-color: var(--danger); }
        .btn-danger:hover { background: #be3a2f; border-color: #be3a2f; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(231,74,59,0.3); }
        .btn-warning { background: var(--warning); border-color: var(--warning); color: #444; }
        .btn-warning:hover { background: #dda20a; border-color: #dda20a; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(246,194,62,0.3); }
        .btn-secondary { background: #858796; border-color: #858796; }
        .btn-secondary:hover { background: #717384; border-color: #717384; }
        .btn-info { background: var(--info); border-color: var(--info); }
        .btn-info:hover { background: #2c9faf; border-color: #2c9faf; transform: translateY(-1px); }
        .btn-sm { padding: 5px 10px; font-size: 12px; border-radius: 6px; transition: all 0.2s; }
        .sidebar-card { display: none; }
        .text-primary { color: #175cdd !important; }
        .bg-gradient-primary { background: var(--sidebar-bg); }
        .dropdown-toggle::after { display: none; }
        .table thead th { border-top: none; font-size: 12px; font-weight: 700; text-transform: uppercase; color: #555; background: #f8f9fc; }
        .table td { vertical-align: middle; font-size: 14px; border-color: #edf0f4; }
        .table-hover tbody tr:hover { background: #f8f9fc !important; }
        .badge { font-size: 11px; padding: 4px 9px; border-radius: 6px; font-weight: 600; }
        .alert { border-radius: 10px; border: none; }
        .alert-success { background: #d4edda; color: #155724; }
        .alert-danger { background: #f8d7da; color: #721c24; }
        .alert-warning { background: #fff3cd; color: #856404; }
        .alert-info { background: #d1ecf1; color: #0c5460; }
        .form-control, .form-select { border-radius: 8px; font-size: 14px; padding: 9px 14px; border: 1.5px solid #dce0e7; transition: border-color 0.2s, box-shadow 0.2s; }
        .form-control:focus, .form-select:focus { border-color: #175cdd; box-shadow: 0 0 0 3px rgba(23,92,221,0.1); }
        .form-label { font-weight: 600; color: #444; font-size: 13px; }
        .container-fluid { padding: 20px 25px; }
        .page-item.active .page-link { background: #175cdd; border-color: #175cdd; }
        .page-link { color: #175cdd; border-radius: 6px; margin: 0 2px; transition: all 0.2s; }
        .page-link:hover { background: #f0f4f8; border-color: #175cdd; color: #175cdd; }
        .scroll-to-top { background: #175cdd; }
        .scroll-to-top:hover { background: #1448b8; }

        /* Breadcrumb */
        .breadcrumb-section { padding: 0 25px 12px; }
        .breadcrumb { background: transparent; padding: 0; margin: 0; font-size: 13px; }
        .breadcrumb-item a { color: #175cdd; text-decoration: none; }
        .breadcrumb-item a:hover { text-decoration: underline; }
        .breadcrumb-item.active { color: #6c757d; }
        .breadcrumb-item + .breadcrumb-item::before { color: #adb5bd; }

        /* Stat cards */
        .stat-card { border-radius: 12px; padding: 20px; background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: all 0.25s; border-left: 4px solid; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); }
        .stat-card.primary { border-left-color: #175cdd; }
        .stat-card.success { border-left-color: #1cc88a; }
        .stat-card.danger { border-left-color: #e74a3b; }
        .stat-card.warning { border-left-color: #f6c23e; }
        .stat-card.info { border-left-color: #36b9cc; }
        .stat-card .stat-icon { width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
        .stat-card .stat-icon.primary { background: rgba(23,92,221,0.1); color: #175cdd; }
        .stat-card .stat-icon.success { background: rgba(28,200,138,0.1); color: #1cc88a; }
        .stat-card .stat-icon.danger { background: rgba(231,74,59,0.1); color: #e74a3b; }
        .stat-card .stat-icon.warning { background: rgba(246,194,62,0.1); color: #f6c23e; }
        .stat-card .stat-icon.info { background: rgba(54,185,200,0.1); color: #36b9cc; }
        .stat-card .stat-value { font-size: 26px; font-weight: 800; color: #2d3748; line-height: 1.2; }
        .stat-card .stat-label { font-size: 13px; color: #718096; font-weight: 600; }

        /* Toast */
        #toast-container { position: fixed; top: 20px; right: 20px; z-index: 9999; }
        .toast { border-radius: 10px; box-shadow: 0 8px 30px rgba(0,0,0,0.15); }
        .toast-success { background: #1cc88a !important; border-color: #17a673 !important; }
        .toast-error { background: #e74a3b !important; border-color: #be3a2f !important; }
        .toast-warning { background: #f6c23e !important; border-color: #dda20a !important; }
        .toast-info { background: #36b9cc !important; border-color: #2c9faf !important; }

        /* Modal */
        .modal-header { border-radius: 12px 12px 0 0; background: #f8f9fc; border-bottom: 1px solid #edf0f4; }
        .modal-content { border-radius: 12px; border: none; box-shadow: 0 15px 50px rgba(0,0,0,0.2); }
        .modal-footer { border-top: 1px solid #edf0f4; }

        /* Loading */
        .page-loading { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.9); z-index: 9998; display: flex; align-items: center; justify-content: center; }
        .spinner { width: 40px; height: 40px; border: 3px solid #edf0f4; border-top-color: #175cdd; border-radius: 50%; }

        /* User avatar */
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; color: #fff; }
        .avatar-primary { background: #175cdd; }
        .avatar-success { background: #1cc88a; }
        .avatar-danger { background: #e74a3b; }
        .avatar-warning { background: #f6c23e; color: #444; }
        .avatar-info { background: #36b9cc; }

        /* Notification dot */
        .notif-dot { width: 8px; height: 8px; background: #e74a3b; border-radius: 50%; position: absolute; top: 8px; right: 8px; }

        /* Table actions */
        .action-btn { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; transition: all 0.2s; margin: 0 2px; }
        .action-btn:hover { transform: scale(1.1); }

        /* Collapse items */
        .collapse-item { border-radius: 6px; padding: 8px 12px; font-size: 13px; transition: all 0.2s; margin: 2px 8px; width: calc(100% - 16px); color: #3a4b5c; }
        .collapse-item:hover { background: #eef2f7; color: #175cdd; }

        /* Footer */
        footer.sticky-footer { border-top: 1px solid #edf0f4; }
        footer .copyright { color: #718096; font-size: 13px; }
    </style>
</head>

