<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>@ViewData["Title"] - Admin His</title>

    <!-- Custom fonts for this template-->
    <link href="~/admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/admin/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/admin/css/admin-custom.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-hospital"></i>
                </div>
                <div class="sidebar-brand-text mx-3">VinhUni His</div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0">

            <!-- Nav Item - Dashboard -->
            @if (!User.IsInRole("BacSi") && !User.IsInRole("Doctor") && !User.IsInRole("Bác sĩ") && !User.IsInRole("Thu ngân") && !User.IsInRole("Kế toán") && !User.IsInRole("ThuNgan") && !User.IsInRole("KeToan") && !User.IsInRole("Cashier") && !User.IsInRole("DuocSi") && !User.IsInRole("Dược sĩ") && !User.IsInRole("Pharmacist") && !User.IsInRole("KyThuat") && !User.IsInRole("Kỹ thuật") && !User.IsInRole("Technician") && !User.IsInRole("CanLamSang"))
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                        <i class="fas fa-fw fa-tachometer-alt"></i>
                        <span>Báo cáo tổng quan</span>
                    </a>
                </li>
            }

            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            @if (User.IsInRole("BacSi") || User.IsInRole("Doctor") || User.IsInRole("Bác sĩ"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading" style="color: #f8f9fc; font-weight: bold; letter-spacing: 0.5px;">KHÔNG GIAN BÁC SĨ</div>

                <li class="nav-item @(currentController == "DoctorWorkspace" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "DoctorWorkspace", new { area = "Admin" })">
                        <i class="fas fa-fw fa-stethoscope"></i>
                        <span>Khám trong ngày</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "DoctorSchedule" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Personal", "DoctorSchedule", new { area = "Admin" })">
                        <i class="fas fa-fw fa-calendar-alt"></i>
                        <span>Lịch trực của tôi</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "Patient" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Patient", new { area = "Admin" })">
                        <i class="fas fa-fw fa-user-injured"></i>
                        <span>Bệnh nhân của tôi</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "Appointment" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Appointment", new { area = "Admin" })">
                        <i class="fas fa-fw fa-calendar-check"></i>
                        <span>Lịch khám của tôi</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "MedicalRecord" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "MedicalRecord", new { area = "Admin" })">
                        <i class="fas fa-fw fa-file-medical"></i>
                        <span>Hồ sơ bệnh án</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "RecordService" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "RecordService", new { area = "Admin" })">
                        <i class="fas fa-fw fa-vials"></i>
                        <span>Chỉ định CLS</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "Prescription" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Prescription", new { area = "Admin" })">
                        <i class="fas fa-fw fa-prescription-bottle-alt"></i>
                        <span>Đơn thuốc đã kê</span>
                    </a>
                </li>
            }
            @if (User.IsInRole("Lễ tân") || User.IsInRole("LeTan") || User.IsInRole("Receptionist"))
            {
                <!-- ═══════ LỄ TÂN ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading" style="color: #f8f9fc; font-weight: bold; letter-spacing: 0.5px;">TIẾP ĐÓN</div>

                <li class="nav-item @(currentController == "ReceptionWorkspace" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "ReceptionWorkspace", new { area = "Admin" })">
                        <i class="fas fa-fw fa-concierge-bell"></i>
                        <span>Quầy tiếp đón</span>
                    </a>
                </li>
                
                <li class="nav-item @(currentController == "Patient" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Patient", new { area = "Admin" })">
                        <i class="fas fa-fw fa-users"></i>
                        <span>Danh sách bệnh nhân</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "DoctorSchedule" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })">
                        <i class="fas fa-fw fa-calendar-check"></i>
                        <span>Lịch làm việc Bác sĩ</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Thu ngân") || User.IsInRole("Kế toán") || User.IsInRole("ThuNgan") || User.IsInRole("KeToan") || User.IsInRole("Cashier"))
            {
                <!-- ═══════ THU NGÂN ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading" style="color: #f8f9fc; font-weight: bold; letter-spacing: 0.5px;">TÀI CHÍNH</div>

                <li class="nav-item @(currentController == "CashierWorkspace" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "CashierWorkspace", new { area = "Admin" })">
                        <i class="fas fa-fw fa-cash-register"></i>
                        <span>Quầy thanh toán hôm nay</span>
                    </a>
                </li>
                
                <li class="nav-item @(currentController == "FinancialReport" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "FinancialReport", new { area = "Admin" })">
                        <i class="fas fa-fw fa-chart-line"></i>
                        <span>Báo cáo doanh thu</span>
                    </a>
                </li>
                
                <li class="nav-item @(currentController == "Invoice" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Invoice", new { area = "Admin" })">
                        <i class="fas fa-fw fa-file-invoice-dollar"></i>
                        <span>Tra cứu toàn bộ hóa đơn</span>
                    </a>
                </li>
                
                <li class="nav-item @(currentController == "Patient" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Patient", new { area = "Admin" })">
                        <i class="fas fa-fw fa-users"></i>
                        <span>Danh sách bệnh nhân</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("DuocSi") || User.IsInRole("Dược sĩ") || User.IsInRole("Pharmacist"))
            {
                <!-- ═══════ DƯỢC & VẬT TƯ ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading" style="color: #f8f9fc; font-weight: bold; letter-spacing: 0.5px;">DƯỢC & VẬT TƯ</div>

                <li class="nav-item @(currentController == "PharmacyWorkspace" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "PharmacyWorkspace", new { area = "Admin" })">
                        <i class="fas fa-fw fa-pills"></i>
                        <span>Quầy cấp phát thuốc</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "Medicine" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Medicine", new { area = "Admin" })">
                        <i class="fas fa-fw fa-capsules"></i>
                        <span>Quản lý kho thuốc</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "MedicalSupply" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "MedicalSupply", new { area = "Admin" })">
                        <i class="fas fa-fw fa-syringe"></i>
                        <span>Quản lý vật tư y tế</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "Prescription" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "Prescription", new { area = "Admin" })">
                        <i class="fas fa-fw fa-file-prescription"></i>
                        <span>Tra cứu đơn thuốc</span>
                    </a>
                </li>

            }

            @if (User.IsInRole("KyThuat") || User.IsInRole("Kỹ thuật") || User.IsInRole("Technician") || User.IsInRole("CanLamSang"))
            {
                <!-- ═══════ CẬN LÂM SÀNG ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading" style="color: #f8f9fc; font-weight: bold; letter-spacing: 0.5px;">CẬN LÂM SÀNG</div>

                <li class="nav-item @(currentController == "LabWorkspace" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "LabWorkspace", new { area = "Admin" })">
                        <i class="fas fa-fw fa-microscope"></i>
                        <span>Xét nghiệm & CĐHA</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "RecordService" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "RecordService", new { area = "Admin" })">
                        <i class="fas fa-fw fa-vials"></i>
                        <span>Tra cứu phiếu dịch vụ</span>
                    </a>
                </li>

                <li class="nav-item @(currentController == "MedicalService" ? "active" : "")">
                    <a class="nav-link pb-1" href="@Url.Action("Index", "MedicalService", new { area = "Admin" })">
                        <i class="fas fa-fw fa-list-alt"></i>
                        <span>Danh mục dịch vụ</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin"))
            {
                <!-- ═══════ ADMIN: HỆ THỐNG ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Hệ thống</div>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Account", new { area = "Admin" })">
                        <i class="fas fa-users-cog"></i>
                        <span>Tài khoản nhân viên</span>
                    </a>
                </li>

                <!-- ═══════ ADMIN: CƠ CẤU & DANH MỤC ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Cơ cấu &amp; Danh mục</div>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Department", new { area = "Admin" })">
                        <i class="fas fa-hospital"></i>
                        <span>Khoa</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Room", new { area = "Admin" })">
                        <i class="fas fa-door-open"></i>
                        <span>Phòng</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Bed", new { area = "Admin" })">
                        <i class="fas fa-bed"></i>
                        <span>Giường</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "MedicalService", new { area = "Admin" })">
                        <i class="fas fa-hand-holding-medical"></i>
                        <span>Dịch vụ y tế</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "IcdDictionary", new { area = "Admin" })">
                        <i class="fas fa-book-medical"></i>
                        <span>Từ điển ICD-10</span>
                    </a>
                </li>

                <!-- ═══════ ADMIN: NHÂN SỰ ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Nhân sự &amp; Bệnh nhân</div>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Employee", new { area = "Admin" })">
                        <i class="fas fa-user-md"></i>
                        <span>Nhân viên</span>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Lịch làm việc Bác sĩ</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("LeTan") || User.IsInRole("Receptionist") || User.IsInRole("Nurse"))
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Patient", new { area = "Admin" })">
                        <i class="fas fa-procedures"></i>
                        <span>Bệnh nhân</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("LeTan") || User.IsInRole("Receptionist") || User.IsInRole("Nurse"))
            {
                <!-- ═══════ NGHIỆP VỤ Y TẾ ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Nghiệp vụ y tế</div>
                
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Appointment", new { area = "Admin" })">
                        <i class="fas fa-calendar-check"></i>
                        <span>Lịch khám</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "MedicalRecord", new { area = "Admin" })">
                        <i class="fas fa-file-medical"></i>
                        <span>Hồ sơ bệnh án</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "RecordService", new { area = "Admin" })">
                        <i class="fas fa-vials"></i>
                        <span>Chỉ định CLS</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Prescription", new { area = "Admin" })">
                        <i class="fas fa-prescription-bottle-alt"></i>
                        <span>Đơn thuốc</span>
                    </a>
                </li>
            }

            <!-- ═══════ HẬU CẦN & TÀI CHÍNH ═══════ -->
            @if (User.IsInRole("Admin") || User.IsInRole("DuocSi") || User.IsInRole("LeTan") || User.IsInRole("Receptionist"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Hậu cần &amp; Tài chính</div>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("DuocSi"))
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Medicine", new { area = "Admin" })">
                        <i class="fas fa-capsules"></i>
                        <span>Kho thuốc</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "MedicalSupply", new { area = "Admin" })">
                        <i class="fas fa-boxes"></i>
                        <span>Vật tư y tế</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin") || User.IsInRole("LeTan") || User.IsInRole("Receptionist"))
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Invoice", new { area = "Admin" })">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <span>Hóa đơn</span>
                    </a>
                </li>
            }

            @if (User.IsInRole("Admin"))
            {
                <!-- ═══════ ADMIN: NỘI DUNG ═══════ -->
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Nội dung &amp; Phản hồi</div>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Article", new { area = "Admin" })">
                        <i class="fas fa-newspaper"></i>
                        <span>Bài viết</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Contact", new { area = "Admin" })">
                        <i class="fas fa-envelope-open-text"></i>
                        <span>Liên hệ</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "WebMenu", new { area = "Admin" })">
                        <i class="fas fa-sitemap"></i>
                        <span>Menu Website</span>
                    </a>
                </li>
            }

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler (Sidebar) -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>

        </ul>
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">

                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity?.Name</span>
                                <img class="img-profile rounded-circle"
                                    src="~/admin/img/undraw_profile.svg">
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="@Url.Action("Profile", "Account", new { area = "Admin" })">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Hồ sơ cá nhân
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Đăng xuất
                                </a>
                            </div>
                        </li>

                    </ul>

                </nav>
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">
                    @RenderBody()
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; VinhUni HIS 2026</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Xác nhận đăng xuất</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy</button>
                    <form method="post" action="@Url.Action("Logout", "Account", new { area = "Admin" })" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Đăng xuất</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/admin/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/admin/js/sb-admin-2.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
