<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>SB Admin 2 - Dashboard</title>

    <!-- Custom fonts for this template-->
    <link href="~/admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/admin/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        body { font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="index.html">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-laugh-wink"></i>
                </div>
                <div class="sidebar-brand-text mx-3">VinhUni-His</div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0">

            <!-- Nav Item - Dashboard -->
            <li class="nav-item active">
                <a class="nav-link" href="index.html">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Heading -->
            <div class="sidebar-heading">
                Quản lý
            </div>

            <!-- Nav Item - Khoa -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Department", new { area = "Admin" })">
                    <i class="fas fa-hospital"></i>
                    <span>Quản lý khoa</span>
                </a>
            </li>

            <!-- Nav Item - Phong -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Room", new { area = "Admin" })">
                    <i class="fas fa-door-open"></i>
                    <span>Quản lý phòng</span>
                </a>
            </li>

            <!-- Nav Item - Giuong -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Bed", new { area = "Admin" })">
                    <i class="fas fa-bed"></i>
                    <span>Quản lý giường</span>
                </a>
            </li>

            <!-- Nav Item - WebMenu -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "WebMenu", new { area = "Admin" })">
                    <i class="fas fa-sitemap"></i>
                    <span>Cấu hình Web Menu</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Heading -->
            <div class="sidebar-heading">
                Quản lý
            </div>

            <!-- Nav Item - Nhan Vien -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Employee", new { area = "Admin" })">
                    <i class="fas fa-user-md"></i>
                    <span>Nhân viên</span>
                </a>
            </li>

            <!-- Nav Item - Benh Nhan -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Patient", new { area = "Admin" })">
                    <i class="fas fa-procedures"></i>
                    <span>Bệnh nhân</span>
                </a>
            </li>

            <!-- Nav Item - Lich Kham -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Appointment", new { area = "Admin" })">
                    <i class="fas fa-calendar-check"></i>
                    <span>Lịch khám</span>
                </a>
            </li>

            <!-- Nav Item - Kho Duoc -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Medicine", new { area = "Admin" })">
                    <i class="fas fa-capsules"></i>
                    <span>Kho thuốc</span>
                </a>
            </li>

            <!-- Nav Item - Kham Benh -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "KhamBenh", new { area = "Admin" })">
                    <i class="fas fa-stethoscope"></i>
                    <span>Khám bệnh</span>
                </a>
            </li>

            <!-- Nav Item - Ho So Benh An -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "MedicalRecord", new { area = "Admin" })">
                    <i class="fas fa-file-medical"></i>
                    <span>Hồ sơ bệnh án</span>
                </a>
            </li>

            <!-- Nav Item - Dich Vu Y Te -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "MedicalService", new { area = "Admin" })">
                    <i class="fas fa-hand-holding-medical"></i>
                    <span>Dịch vụ y tế</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Heading -->
            <div class="sidebar-heading">
                Nghiệp vụ
            </div>

            <!-- Nav Item - Tiep Nhan -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "TiepNhan", new { area = "Admin" })">
                    <i class="fas fa-user-plus"></i>
                    <span>Tiếp nhận</span>
                </a>
            </li>

            <!-- Nav Item - Chi Dinh CLS -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "RecordService", new { area = "Admin" })">
                    <i class="fas fa-vials"></i>
                    <span>Chỉ định CLS</span>
                </a>
            </li>

            <!-- Nav Item - Don Thuoc -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Prescription", new { area = "Admin" })">
                    <i class="fas fa-prescription-bottle-alt"></i>
                    <span>Đơn thuốc</span>
                </a>
            </li>

            <!-- Nav Item - Hoa Don -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Invoice", new { area = "Admin" })">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <span>Hóa đơn</span>
                </a>
            </li>


            <!-- Divider -->
            <hr class="sidebar-divider">

            <!-- Heading -->
            <div class="sidebar-heading">
                Nội dung
            </div>

            <!-- Nav Item - Bai Viet -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Article", new { area = "Admin" })">
                    <i class="fas fa-newspaper"></i>
                    <span>Bài viết</span>
                </a>
            </li>

            <!-- Nav Item - Web Menu -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "WebMenu", new { area = "Admin" })">
                    <i class="fas fa-bars"></i>
                    <span>Menu Website</span>
                </a>
            </li>

            <!-- Nav Item - Lien He -->
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "Contact", new { area = "Admin" })">
                    <i class="fas fa-envelope-open-text"></i>
                    <span>Liên hệ</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler (Sidebar) -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>

            <!-- Sidebar Message -->
            <div class="sidebar-card d-none d-lg-flex">
                <img class="sidebar-card-illustration mb-2" src="~/admin/img/undraw_rocket.svg" alt="...">
                <p class="text-center mb-2"><strong>SB Admin Pro</strong> is packed with premium features, components, and more!</p>
                <a class="btn btn-success btn-sm" href="https://startbootstrap.com/theme/sb-admin-pro">Upgrade to Pro!</a>
            </div>

        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

        @RenderBody()
            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Your Website 2021</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/admin/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/admin/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="~/admin/vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/admin/js/demo/chart-area-demo.js"></script>
    <script src="~/admin/js/demo/chart-pie-demo.js"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>
