@model IEnumerable<HTTTBenhVien.Models.Article>
@{
    ViewData["Title"] = "Quản lý Bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
        .card-ajax { border: none; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); overflow: hidden; }
    .card-header-ajax { background: white; border-bottom: 2px solid #f8f9fe; padding: 1.25rem 1.5rem; font-weight: 600; color: #667eea; }
    .btn-gradient { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 0.5rem; transition: all 0.3s ease; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4); color: white; }
    .btn-gradient-info { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none; color: white; }
    .btn-gradient-danger { background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none; color: white; }
    .btn-sm-gradient { padding: 0.375rem 0.75rem; font-size: 0.875rem; border-radius: 0.375rem; }
    .empty-state { padding: 3rem; text-align: center; }
    .empty-state-icon { font-size: 4rem; color: #d1d3e0; margin-bottom: 1rem; }
    .stat-card { background: white; border-radius: 1rem; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1); }
    .stat-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-info h4 { font-weight: 700; margin: 0; color: #2d3748; font-size: 1.5rem; }
    .stat-info p { margin: 0; color: #a0aec0; font-size: 0.85rem; }
    .article-card { background: white; border-radius: 0.75rem; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: all 0.3s ease; border: 1px solid #f0f2f8; }
    .article-card:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(102, 126, 234, 0.15); }
    .article-thumb { width: 100%; height: 160px; object-fit: cover; }
    .article-thumb-placeholder { width: 100%; height: 160px; background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%); display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #667eea; }
    .article-body { padding: 1rem; }
    .article-title { font-weight: 700; color: #2d3748; font-size: 0.95rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.66rem; }
    .article-summary { color: #a0aec0; font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.2rem; margin-top: 0.5rem; }
    .article-meta { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-top: 1px solid #f0f2f8; font-size: 0.75rem; }
    .cat-badge { padding: 0.25rem 0.6rem; border-radius: 1rem; font-size: 0.7rem; font-weight: 600; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 4px; }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <h1 class="h3 mb-4 text-gray-800 font-weight-bold">Danh sách bài viết</h1>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%); color: #667eea;"><i class="fas fa-file-alt"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count()</h4>
                    <p>Tổng bài viết</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(17, 153, 142, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%); color: #11998e;"><i class="fas fa-globe"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(a => a.Status == "Published")</h4>
                    <p>Đã xuất bản</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(246, 211, 101, 0.15) 0%, rgba(253, 160, 133, 0.15) 100%); color: #fda085;"><i class="fas fa-pencil-alt"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(a => a.Status == "Draft")</h4>
                    <p>Bản nháp</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(0, 242, 254, 0.15) 100%); color: #4facfe;"><i class="fas fa-eye"></i></div>
                <div class="stat-info">
                    <h4>@Model.Sum(a => a.ViewCount ?? 0)</h4>
                    <p>Tổng lượt xem</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ajax mb-4">
        <div class="card-header card-header-ajax d-flex justify-content-between align-items-center">
            <span><i class="fas fa-th-large mr-2"></i>Danh sách bài viết</span>
            <div class="d-flex align-items-center">
                <form asp-action="Index" method="get" class="form-inline mr-3 mb-0">
                    <select name="categoryFilter" class="form-control form-control-sm mr-2" style="border-radius: 20px;">
                        <option value="">Tất cả danh mục</option>
                        <option value="Tin tức" selected="@(ViewData["CategoryFilter"]?.ToString() == "Tin tức")">Tin tức</option>
                        <option value="Sức khỏe" selected="@(ViewData["CategoryFilter"]?.ToString() == "Sức khỏe")">Sức khỏe</option>
                        <option value="Hoạt động" selected="@(ViewData["CategoryFilter"]?.ToString() == "Hoạt động")">Hoạt động</option>
                        <option value="Tuyển dụng" selected="@(ViewData["CategoryFilter"]?.ToString() == "Tuyển dụng")">Tuyển dụng</option>
                    </select>
                    <select name="statusFilter" class="form-control form-control-sm mr-2" style="border-radius: 20px;">
                        <option value="">Tất cả TT</option>
                        <option value="Published" selected="@(ViewData["StatusFilter"]?.ToString() == "Published")">Đã XB</option>
                        <option value="Draft" selected="@(ViewData["StatusFilter"]?.ToString() == "Draft")">Nháp</option>
                    </select>
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tiêu đề..." style="border-radius: 20px 0 0 20px;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn" style="border-radius: 0 20px 20px 0; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white;"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </form>
                <a asp-action="Create" class="btn btn-sm btn-gradient">
                    <i class="fas fa-plus mr-1"></i> Viết bài
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                            <div class="article-card">
                                @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                {
                                    <img src="@item.ThumbnailUrl" class="article-thumb" alt="@item.Title">
                                }
                                else
                                {
                                    <div class="article-thumb-placeholder"><i class="fas fa-image"></i></div>
                                }
                                <div class="article-body">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        @{
                                            var catColor = item.Category switch
                                            {
                                                "Tin tức" => "background: #e8edfc; color: #667eea;",
                                                "Sức khỏe" => "background: #e6f7f1; color: #11998e;",
                                                "Hoạt động" => "background: #fff3e6; color: #e67e22;",
                                                "Tuyển dụng" => "background: #fce4ec; color: #e91e63;",
                                                _ => "background: #f5f5f5; color: #666;"
                                            };
                                        }
                                        <span class="cat-badge" style="@catColor">@item.Category</span>
                                        @if (item.Status == "Published")
                                        {
                                            <span style="font-size: 0.7rem; color: #11998e;"><span class="status-dot" style="background: #11998e;"></span>Đã XB</span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 0.7rem; color: #a0aec0;"><span class="status-dot" style="background: #fda085;"></span>Nháp</span>
                                        }
                                    </div>
                                    <div class="article-title">@item.Title</div>
                                    <div class="article-summary">@(string.IsNullOrEmpty(item.Summary) ? "Chưa có mô tả" : item.Summary)</div>
                                </div>
                                <div class="article-meta">
                                    <div>
                                        <i class="far fa-calendar-alt text-muted mr-1"></i>@(item.PublishDate?.ToString("dd/MM/yy") ?? "N/A")
                                        <span class="ml-2"><i class="far fa-eye text-muted mr-1"></i>@(item.ViewCount ?? 0)</span>
                                    </div>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.ArticleId" class="btn btn-sm btn-gradient-info btn-sm-gradient text-white" title="Xem"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.ArticleId" class="btn btn-sm btn-gradient btn-sm-gradient text-white" title="Sửa"><i class="fas fa-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.ArticleId" class="btn btn-sm btn-gradient-danger btn-sm-gradient text-white" title="Xóa"><i class="fas fa-trash"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-newspaper empty-state-icon"></i>
                    <h5 class="text-muted font-weight-bold">Chưa có bài viết nào</h5>
                    <p class="text-muted mb-4">Viết bài mới để chia sẻ thông tin</p>
                    <a asp-action="Create" class="btn btn-gradient px-4"><i class="fas fa-plus mr-2"></i>Viết bài</a>
                </div>
            }
        </div>
    </div>
</div>
