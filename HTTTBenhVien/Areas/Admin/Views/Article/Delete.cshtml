@model HTTTBenhVien.Models.Article
@{
    ViewData["Title"] = "Xóa Bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow mb-4" style="border-radius: 1rem; border: none; overflow: hidden;">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); color: white;">
                    <h6 class="m-0 font-weight-bold text-center"><i class="fas fa-exclamation-triangle mr-2"></i>Xác nhận xóa bài viết</h6>
                </div>
                <div class="card-body p-5 text-center">
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <img src="@Model.ThumbnailUrl" style="width: 100%; max-height: 180px; object-fit: cover; border-radius: 0.75rem; margin-bottom: 1.5rem;" alt="@Model.Title">
                    }
                    else
                    {
                        <div class="mb-4" style="font-size: 4rem; color: #eb3349;">
                            <i class="fas fa-newspaper"></i>
                        </div>
                    }

                    <h4 class="font-weight-bold text-gray-800 mb-2">@Model.Title</h4>
                    <p class="text-muted mb-1"><strong>Danh mục:</strong> @Model.Category</p>
                    <p class="text-muted mb-1"><strong>Tác giả:</strong> @(Model.Author?.FullName ?? "N/A")</p>
                    <p class="text-muted mb-1"><strong>Ngày đăng:</strong> @(Model.PublishDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                    <p class="text-muted mb-4"><strong>Lượt xem:</strong> @(Model.ViewCount ?? 0)</p>

                    <div class="alert alert-danger" role="alert">
                        <strong>Cảnh báo:</strong> Bài viết sẽ bị xóa vĩnh viễn và không thể khôi phục.
                    </div>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="ArticleId" />
                        <button type="submit" class="btn btn-danger px-4 py-2 mr-2" style="border-radius: 0.5rem; background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none;">
                            <i class="fas fa-trash-alt mr-2"></i> Xác nhận Xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: 0.5rem;">
                            Hủy bỏ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
