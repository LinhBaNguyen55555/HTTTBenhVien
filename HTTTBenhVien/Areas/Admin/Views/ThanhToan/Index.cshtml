@model IEnumerable<HTTTBenhVien.Models.Invoice>
@{
    ViewData["Title"] = "Thanh toán viện phí";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Doanh thu hôm nay</div>
                <div class="h5 mb-0 font-weight-bold text-success">@((ViewBag.TodayRevenue ?? 0m).ToString("N0")) đ</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng hóa đơn</div>
                <div class="h5 mb-0 font-weight-bold">@ViewBag.Total</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách hóa đơn</h6>
        <form method="get">
            <input type="text" name="search" class="form-control form-control-sm d-inline-block" style="width:250px;" placeholder="Tìm tên bệnh nhân..." value="@ViewBag.Search" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i></button>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Mã hóa đơn</th>
                        <th>Ngày thanh toán</th>
                        <th>Bệnh nhân</th>
                        <th>Tổng tiền</th>
                        <th>BHYT chi trả</th>
                        <th>BN thanh toán</th>
                        <th>Trạng thái</th>
                        <th width="100">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var inv in Model)
                        {
                            var statusClass = inv.Status == "DaThanhToan" ? "badge-success" : "badge-secondary";
                            var total = inv.InvoiceDetails?.Sum(d => d.UnitPrice * d.Quantity) ?? 0;
                            <tr>
                                <td>@i</td>
                                <td><code>HD-@(inv.InvoiceId.ToString("D6"))</code></td>
                                <td>@inv.PaymentDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><strong>@inv.Patient?.FullName</strong></td>
                                <td>@total.ToString("N0") đ</td>
                                <td>@((inv.BhytAmount ?? 0).ToString("N0")) đ</td>
                                <td class="text-primary font-weight-bold">@((inv.PatientAmount ?? 0).ToString("N0")) đ</td>
                                <td><span class="badge @statusClass">@(inv.Status == "DaThanhToan" ? "Đã thanh toán" : inv.Status)</span></td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = inv.InvoiceId })" class="btn btn-info btn-sm" title="Chi tiết"><i class="fas fa-eye fa-xs"></i></a>
                                    <a href="@Url.Action("Print", new { id = inv.InvoiceId })" class="btn btn-secondary btn-sm" title="In" target="_blank"><i class="fas fa-print fa-xs"></i></a>
                                </td>
                            </tr>
                            i++;
                        }
                        if (!Model.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
