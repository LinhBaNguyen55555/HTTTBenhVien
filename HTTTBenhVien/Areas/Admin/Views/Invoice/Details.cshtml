@model HTTTBenhVien.Models.Invoice
@{
    ViewData["Title"] = "Chi tiết Hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .invoice-card { border-radius: 1rem; box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08); border: none; overflow: hidden; }
    .invoice-header { background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); color: white; padding: 2rem; position: relative; }
    .invoice-body { padding: 2rem; }
    .bg-icon { position: absolute; right: 2rem; top: 50%; transform: translateY(-50%); font-size: 8rem; opacity: 0.1; }
    .info-row { display: flex; padding: 0.7rem 0; border-bottom: 1px solid #f0f2f5; }
    .info-row:last-child { border-bottom: none; }
    .info-label { width: 35%; color: #6c757d; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .info-value { width: 65%; color: #2d3748; font-weight: 500; }
    .item-table thead th { background: #fef9f2; color: #e67e22; font-weight: 600; font-size: 0.82rem; text-transform: uppercase; border: none; padding: 0.85rem; }
    .item-table tbody td { padding: 0.85rem; border-color: #f0f2f8; vertical-align: middle; }
    .item-table tbody tr:hover { background: #fef9f2; }
    .summary-box { background: linear-gradient(135deg, rgba(246, 211, 101, 0.08) 0%, rgba(253, 160, 133, 0.08) 100%); border-radius: 0.75rem; padding: 1.5rem; border: 1px solid #fde8d0; }
    .summary-row { display: flex; justify-content: space-between; padding: 0.5rem 0; }
    .summary-total { border-top: 3px solid #e67e22; padding-top: 0.75rem; margin-top: 0.5rem; font-size: 1.2rem; }
    .item-type-badge { padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.72rem; font-weight: 600; }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card invoice-card">
                <div class="invoice-header">
                    <i class="fas fa-file-invoice-dollar bg-icon"></i>
                    <div style="position: relative; z-index: 1;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h2 class="mb-1 font-weight-bold">HÓA ĐƠN #@Model.InvoiceId</h2>
                                <p class="mb-0" style="opacity: 0.9;">
                                    Ngày lập: <strong>@(Model.PaymentDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</strong>
                                </p>
                            </div>
                            <div>
                                @switch (Model.Status)
                                {
                                    case "ChuaThanhToan":
                                        <span class="badge badge-warning px-4 py-2" style="font-size: 1rem;"><i class="fas fa-clock mr-1"></i>Chưa thanh toán</span>
                                        break;
                                    case "DaThanhToan":
                                        <span class="badge badge-success px-4 py-2" style="font-size: 1rem;"><i class="fas fa-check-double mr-1"></i>Đã thanh toán</span>
                                        break;
                                    case "Huy":
                                        <span class="badge badge-secondary px-4 py-2" style="font-size: 1rem;"><i class="fas fa-ban mr-1"></i>Đã hủy</span>
                                        break;
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="invoice-body">
                    <h5 class="border-bottom pb-2 mb-3" style="color: #e67e22;"><i class="fas fa-user-injured mr-2"></i>Thông tin</h5>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label"><i class="fas fa-user text-primary"></i> Bệnh nhân</div>
                                <div class="info-value font-weight-bold">@(Model.Patient?.FullName ?? "N/A")</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label"><i class="fas fa-file-medical text-info"></i> Bệnh án</div>
                                <div class="info-value">@(Model.RecordId.HasValue ? "BA #" + Model.RecordId : "Không liên kết")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label"><i class="fas fa-credit-card text-success"></i> Hình thức TT</div>
                                <div class="info-value">@(Model.PaymentMethod ?? "N/A")</div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="info-row">
                                    <div class="info-label"><i class="fas fa-sticky-note text-warning"></i> Ghi chú</div>
                                    <div class="info-value font-italic">@Model.Notes</div>
                                </div>
                            }
                        </div>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3" style="color: #e67e22;"><i class="fas fa-receipt mr-2"></i>Chi tiết khoản mục (@Model.InvoiceDetails.Count mục)</h5>

                    @if (Model.InvoiceDetails.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table item-table mb-0">
                                <thead>
                                    <tr>
                                        <th width="5%">#</th>
                                        <th width="12%">Loại</th>
                                        <th width="35%">Tên khoản mục</th>
                                        <th width="12%" class="text-center">Số lượng</th>
                                        <th width="15%" class="text-right">Đơn giá</th>
                                        <th width="18%" class="text-right">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int stt = 1; }
                                    @foreach (var d in Model.InvoiceDetails)
                                    {
                                        var lineTotal = (d.UnitPrice ?? 0) * (d.Quantity ?? 0);
                                        <tr>
                                            <td><span class="badge badge-light border">@stt</span></td>
                                            <td>
                                                @switch (d.ItemType)
                                                {
                                                    case "Tiền khám":
                                                        <span class="item-type-badge" style="background: #e8f5e9; color: #2e7d32;">🩺 Tiền khám</span>
                                                        break;
                                                    case "Dịch vụ":
                                                        <span class="item-type-badge" style="background: #e8edfc; color: #4e54c8;">🏥 Dịch vụ</span>
                                                        break;
                                                    case "Thuốc":
                                                        <span class="item-type-badge" style="background: #e6f7f1; color: #11998e;">💊 Thuốc</span>
                                                        break;
                                                    case "Giường":
                                                        <span class="item-type-badge" style="background: #fce4ec; color: #e91e63;">🛏️ Giường</span>
                                                        break;
                                                    default:
                                                        <span class="item-type-badge" style="background: #f5f5f5; color: #666;">📋 @d.ItemType</span>
                                                        break;
                                                }
                                            </td>
                                            <td><strong class="text-dark">@d.ItemName</strong></td>
                                            <td class="text-center font-weight-bold">@d.Quantity</td>
                                            <td class="text-right">@((d.UnitPrice ?? 0).ToString("N0"))đ</td>
                                            <td class="text-right font-weight-bold" style="color: #e67e22;">@lineTotal.ToString("N0")đ</td>
                                        </tr>
                                        stt++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div class="summary-box">
                                <div class="summary-row">
                                    <span class="text-muted font-weight-bold">Tổng cộng:</span>
                                    <span class="font-weight-bold">@((Model.TotalAmount ?? 0).ToString("N0"))đ</span>
                                </div>
                                <div class="summary-row">
                                    <span class="text-muted font-weight-bold"><i class="fas fa-shield-alt text-info mr-1"></i>BHYT chi trả:</span>
                                    <span class="text-info font-weight-bold">- @((Model.BhytAmount ?? 0).ToString("N0"))đ</span>
                                </div>
                                <div class="summary-row">
                                    <span class="text-muted font-weight-bold"><i class="fas fa-percent text-success mr-1"></i>Chiết khấu:</span>
                                    <span class="text-success font-weight-bold">- @((Model.DiscountAmount ?? 0).ToString("N0"))đ</span>
                                </div>
                                <div class="summary-row summary-total">
                                    <span class="font-weight-bold" style="color: #e67e22;"><i class="fas fa-money-bill-wave mr-1"></i>BỆNH NHÂN TRẢ:</span>
                                    <span class="font-weight-bold" style="color: #eb3349; font-size: 1.3rem;">@((Model.PatientAmount ?? 0).ToString("N0"))đ</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 text-center">
                        <a asp-action="Edit" asp-route-id="@Model.InvoiceId" class="btn px-4 py-2 mr-2" style="background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); border: none; color: white; font-weight: 600;">
                            <i class="fas fa-edit mr-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            <i class="fas fa-arrow-left mr-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
