@model IEnumerable<HTTTBenhVien.Models.Contact>
@{
    ViewData["Title"] = "Quản lý Liên hệ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header-gradient {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        color: white; padding: 2rem; border-radius: 1rem; margin-bottom: 1.5rem;
        box-shadow: 0 10px 30px rgba(250, 112, 154, 0.3);
    }
    .card-ajax { border: none; border-radius: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15); overflow: hidden; }
    .card-header-ajax { background: white; border-bottom: 2px solid #f8f9fe; padding: 1.25rem 1.5rem; font-weight: 600; color: #fa709a; }
    .btn-gradient { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); border: none; color: white; font-weight: 600; padding: 0.625rem 1.25rem; border-radius: 0.5rem; transition: all 0.3s ease; }
    .btn-gradient:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(250, 112, 154, 0.4); color: white; }
    .btn-gradient-info { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none; color: white; }
    .btn-gradient-danger { background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); border: none; color: white; }
    .btn-sm-gradient { padding: 0.375rem 0.75rem; font-size: 0.875rem; border-radius: 0.375rem; }
    .table-ajax thead th { background: #f8f9fc; color: #fa709a; font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; border: none; padding: 0.9rem; }
    .table-ajax tbody td { vertical-align: middle; padding: 0.9rem; border-color: #f0f2f8; }
    .table-ajax tbody tr:hover { background: #fff5f8; }
    .badge-loai { padding: 0.4rem 0.7rem; border-radius: 0.35rem; font-size: 0.78rem; font-weight: 600; }
    .empty-state { padding: 3rem; text-align: center; }
    .empty-state-icon { font-size: 4rem; color: #d1d3e0; margin-bottom: 1rem; }
    .stat-card { background: white; border-radius: 1rem; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1); }
    .stat-icon { width: 3.5rem; height: 3.5rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .stat-info h4 { font-weight: 700; margin: 0; color: #2d3748; font-size: 1.5rem; }
    .stat-info p { margin: 0; color: #a0aec0; font-size: 0.85rem; }
    .msg-preview { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.85rem; color: #6c757d; }
    .unread-dot { width: 10px; height: 10px; border-radius: 50%; background: #fa709a; display: inline-block; animation: pulse 1.5s infinite; }
    @@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
</style>

<div class="container-fluid">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        </div>
    }

    <div class="page-header-gradient">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="fas fa-envelope-open-text"></i> Quản lý Liên hệ</h1>
                <p>Tiếp nhận và xử lý phản hồi từ bệnh nhân, khách hàng</p>
            </div>
            <div class="d-none d-md-block">
                <i class="fas fa-headset" style="font-size: 4rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(250, 112, 154, 0.15) 0%, rgba(254, 225, 64, 0.15) 100%); color: #fa709a;"><i class="fas fa-envelope"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count()</h4>
                    <p>Tổng liên hệ</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(246, 211, 101, 0.15) 0%, rgba(253, 160, 133, 0.15) 100%); color: #fda085;"><i class="fas fa-clock"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(c => c.Status == "ChuaXuLy" || c.Status == null)</h4>
                    <p>Chưa xử lý</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="background: linear-gradient(135deg, rgba(17, 153, 142, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%); color: #11998e;"><i class="fas fa-check-double"></i></div>
                <div class="stat-info">
                    <h4>@Model.Count(c => c.Status == "DaXuLy")</h4>
                    <p>Đã xử lý</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ajax mb-4">
        <div class="card-header card-header-ajax d-flex justify-content-between align-items-center">
            <span><i class="fas fa-inbox mr-2"></i>Hộp thư liên hệ</span>
            <div class="d-flex align-items-center">
                <form asp-action="Index" method="get" class="form-inline mr-3 mb-0">
                    <select name="statusFilter" class="form-control form-control-sm mr-2" style="border-radius: 20px;">
                        <option value="">Tất cả</option>
                        <option value="ChuaXuLy" selected="@(ViewData["StatusFilter"]?.ToString() == "ChuaXuLy")">Chưa xử lý</option>
                        <option value="DangXuLy" selected="@(ViewData["StatusFilter"]?.ToString() == "DangXuLy")">Đang xử lý</option>
                        <option value="DaXuLy" selected="@(ViewData["StatusFilter"]?.ToString() == "DaXuLy")">Đã xử lý</option>
                    </select>
                    <div class="input-group input-group-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tên, email, SĐT..." style="border-radius: 20px 0 0 20px;" />
                        <div class="input-group-append">
                            <button type="submit" class="btn" style="border-radius: 0 20px 20px 0; background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); border: none; color: white;"><i class="fas fa-search"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-ajax mb-0">
                        <thead>
                            <tr>
                                <th width="3%"></th>
                                <th width="15%"><i class="fas fa-user mr-1"></i> Người gửi</th>
                                <th width="15%"><i class="fas fa-at mr-1"></i> Liên hệ</th>
                                <th width="15%"><i class="fas fa-tag mr-1"></i> Chủ đề</th>
                                <th width="22%"><i class="fas fa-comment mr-1"></i> Nội dung</th>
                                <th width="10%"><i class="fas fa-calendar mr-1"></i> Ngày gửi</th>
                                <th width="8%" class="text-center"><i class="fas fa-flag mr-1"></i> TT</th>
                                <th width="12%" class="text-center"><i class="fas fa-cog mr-1"></i> Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var isNew = item.Status == "ChuaXuLy" || item.Status == null;
                                <tr style="@(isNew ? "background: #fff9fb; font-weight: 500;" : "")">
                                    <td class="text-center">
                                        @if (isNew)
                                        {
                                            <span class="unread-dot" title="Chưa xử lý"></span>
                                        }
                                    </td>
                                    <td><strong class="text-dark">@item.FullName</strong></td>
                                    <td>
                                        <div style="font-size: 0.82rem;">
                                            <div><i class="fas fa-phone-alt text-success mr-1"></i>@item.Phone</div>
                                            @if (!string.IsNullOrEmpty(item.Email))
                                            {
                                                <div><i class="fas fa-envelope text-info mr-1"></i>@item.Email</div>
                                            }
                                        </div>
                                    </td>
                                    <td><span class="font-weight-bold" style="color: #fa709a;">@item.Subject</span></td>
                                    <td><div class="msg-preview">@item.MessageContent</div></td>
                                    <td><span style="font-size: 0.85rem;">@(item.SubmitDate?.ToString("dd/MM/yy HH:mm") ?? "N/A")</span></td>
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case "ChuaXuLy":
                                            case null:
                                                <span class="badge badge-danger badge-loai"><i class="fas fa-exclamation mr-1"></i>Mới</span>
                                                break;
                                            case "DangXuLy":
                                                <span class="badge badge-warning badge-loai"><i class="fas fa-spinner mr-1"></i>Đang XL</span>
                                                break;
                                            case "DaXuLy":
                                                <span class="badge badge-success badge-loai text-white"><i class="fas fa-check mr-1"></i>Xong</span>
                                                break;
                                            default:
                                                <span class="badge badge-light badge-loai">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Details" asp-route-id="@item.ContactId" class="btn btn-sm btn-gradient-info btn-sm-gradient text-white" title="Xem & Xử lý"><i class="fas fa-eye"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.ContactId" class="btn btn-sm btn-gradient-danger btn-sm-gradient text-white" title="Xóa"><i class="fas fa-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-inbox empty-state-icon"></i>
                    <h5 class="text-muted font-weight-bold">Chưa có liên hệ nào</h5>
                    <p class="text-muted mb-4">Hộp thư đang trống</p>
                </div>
            }
        </div>
    </div>
</div>
