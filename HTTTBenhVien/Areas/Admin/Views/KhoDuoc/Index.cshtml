@model IEnumerable<HTTTBenhVien.Models.Medicine>
@{
    ViewData["Title"] = "Quản lý kho dược";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Thêm thuốc mới
    </a>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Thuốc sắp hết</div>
                <div class="h5 mb-0 font-weight-bold">@ViewBag.LowStock</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Sắp hết hạn</div>
                <div class="h5 mb-0 font-weight-bold">@ViewBag.Expiring</div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách thuốc (@ViewBag.Total)</h6>
        <a href="@Url.Action("BaoCaoTon")" class="btn btn-info btn-sm">
            <i class="fas fa-chart-bar"></i> Báo cáo tồn kho
        </a>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <input type="text" name="search" class="form-control form-control-sm d-inline-block" style="width:300px;" placeholder="Tìm tên thuốc, mã thuốc..." value="@ViewBag.Search" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i></button>
            <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary"><i class="fas fa-redo"></i></a>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>STT</th>
                        <th>Tên thuốc</th>
                        <th>Mã thuốc</th>
                        <th>Đơn vị</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Hạn dùng</th>
                        <th>Trạng thái</th>
                        <th width="120">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var m in Model)
                        {
                            var isLowStock = m.StockQuantity < 100;
                            var isExpiring = m.ExpiryDate != null && m.ExpiryDate <= DateTime.Now.AddDays(30);
                            <tr>
                                <td>@i</td>
                                <td><strong>@m.MedicineName</strong></td>
                                <td><code>@m.MedicineCode</code></td>
                                <td>@m.Unit</td>
                                <td>@m.Price.ToString("N0") đ</td>
                                <td class="@(isLowStock ? "text-danger font-weight-bold" : "")">@m.StockQuantity</td>
                                <td class="@(isExpiring ? "text-danger" : "")">@(m.ExpiryDate?.ToString("dd/MM/yyyy") ?? "")</td>
                                <td>
                                    @if (isLowStock)
                                    {
                                        <span class="badge badge-danger">Sắp hết</span>
                                    }
                                    else if (isExpiring)
                                    {
                                        <span class="badge badge-warning">Sắp hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Còn hàng</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = m.MedicineId })" class="btn btn-warning btn-sm" title="Sửa"><i class="fas fa-edit fa-xs"></i></a>
                                    <a href="@Url.Action("Delete", new { id = m.MedicineId })" class="btn btn-danger btn-sm" title="Xóa" onclick="return confirm('Xóa thuốc này?')"><i class="fas fa-trash fa-xs"></i></a>
                                </td>
                            </tr>
                            i++;
                        }
                        if (!Model.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
