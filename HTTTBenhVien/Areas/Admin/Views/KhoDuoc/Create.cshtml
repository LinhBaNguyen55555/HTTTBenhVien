@model HTTTBenhVien.Models.Medicine
@{
    ViewData["Title"] = "Thêm thuốc mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-pills mr-1"></i> Thông tin thuốc</h6>
            </div>
            <div class="card-body">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Tên thuốc <span class="text-danger">*</span></label>
                                <input type="text" asp-for="MedicineName" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Mã thuốc</label>
                                <input type="text" asp-for="MedicineCode" class="form-control" placeholder="VD: THU001" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="font-weight-bold">Đơn vị</label>
                                <input type="text" asp-for="Unit" class="form-control" placeholder="VD: Viên, Chai, Ống" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="font-weight-bold">Giá bán (VNĐ)</label>
                                <input type="number" asp-for="Price" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="font-weight-bold">Tồn kho</label>
                                <input type="number" asp-for="StockQuantity" class="form-control" value="0" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Hạn dùng</label>
                                <input type="date" asp-for="ExpiryDate" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold">Hoạt chất</label>
                                <input type="text" asp-for="ActiveIngredient" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Mô tả / Cách dùng</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="text-right mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu thuốc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
