@model HTTTBenhVien.Models.MedicalRecord
@{
    ViewData["Title"] = "Chi tiết hồ sơ bệnh án";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">
    <div class="record-details-wrapper" style="padding-top: 110px; background-color: #f8f9fa; min-height: 100vh;">
        <!-- Header area -->
        <div class="record-header py-5 text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);">
            <div class="container text-center">
                <h2 class="fw-bold mb-1 text-white"><i class="fas fa-file-medical-alt me-2 text-white"></i>Chi tiết hồ sơ bệnh án</h2>
                <p class="text-white-50 mb-0 text-white">Ngày khám: @(Model.VisitDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A") | Mã BA: @Model.RecordId</p>
            </div>
        </div>

        <div class="container my-5 pb-5">
            <!-- Back Button -->
            <div class="mb-4">
                <a asp-action="MedicalHistory" asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm bg-white">
                    <i class="fas fa-arrow-left me-2"></i> Quay lại danh sách bệnh lịch
                </a>
            </div>

            <div class="row g-4">
                <!-- Patient Sidebar / Details -->
                <div class="col-lg-4">
                    <!-- Patient Quick Info -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-primary text-white py-3 px-4">
                            <h5 class="card-title mb-0 fw-bold text-white"><i class="fas fa-user-injured me-2 text-white"></i>Thông tin bệnh nhân</h5>
                        </div>
                        <div class="card-body p-4 bg-white">
                            <div class="text-center mb-4">
                                <div class="avatar-container d-inline-block rounded-circle bg-soft-primary p-3 mb-2" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; background-color: #e7f1ff; color: #0d6efd; margin: 0 auto;">
                                    <i class="fas fa-user-alt fs-1"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">@Model.Patient.FullName</h5>
                                <span class="badge bg-secondary rounded-pill">Mã BN: @Model.Patient.PatientCode</span>
                            </div>

                            <ul class="list-unstyled mb-0">
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Ngày sinh:</span>
                                    <span class="fw-bold text-dark">@(Model.Patient.Dob?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                                </li>
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Giới tính:</span>
                                    <span class="fw-bold text-dark">@(Model.Patient.Gender ? "Nam" : "Nữ")</span>
                                </li>
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Số điện thoại:</span>
                                    <span class="fw-bold text-dark">@Model.Patient.Phone</span>
                                </li>
                                @if (!string.IsNullOrEmpty(Model.Patient.BhytCode))
                                {
                                    <li class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="text-muted">Mã thẻ BHYT:</span>
                                        <span class="fw-bold text-success">@Model.Patient.BhytCode</span>
                                    </li>
                                }
                                @if (!string.IsNullOrEmpty(Model.Patient.CitizenId))
                                {
                                    <li class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="text-muted">Số CCCD:</span>
                                        <span class="fw-bold text-dark">@Model.Patient.CitizenId</span>
                                    </li>
                                }
                                <li class="d-flex justify-content-between py-2 border-bottom">
                                    <span class="text-muted">Địa chỉ:</span>
                                    <span class="fw-bold text-dark text-end ms-3" style="font-size: 0.9rem;">@(Model.Patient.Address ?? "Chưa cập nhật")</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Vital Signs Card -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-danger text-white py-3 px-4">
                            <h5 class="card-title mb-0 fw-bold text-white"><i class="fas fa-heartbeat me-2 text-white"></i>Chỉ số sinh tồn</h5>
                        </div>
                        <div class="card-body p-4 bg-white">
                            <div class="row g-3 text-center">
                                <div class="col-6">
                                    <div class="vital-item p-3 rounded-3 bg-light" style="border-left: 4px solid #dc3545;">
                                        <small class="text-muted d-block uppercase mb-1" style="font-size: 0.75rem; font-weight: bold;">Huyết áp</small>
                                        <strong class="fs-5 text-dark">@(string.IsNullOrEmpty(Model.BloodPressure) ? "--/--" : Model.BloodPressure)</strong>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">mmHg</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="vital-item p-3 rounded-3 bg-light" style="border-left: 4px solid #ffc107;">
                                        <small class="text-muted d-block uppercase mb-1" style="font-size: 0.75rem; font-weight: bold;">Nhịp tim</small>
                                        <strong class="fs-5 text-dark">@(Model.PulseRate?.ToString() ?? "--")</strong>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">lần/phút</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="vital-item p-3 rounded-3 bg-light" style="border-left: 4px solid #198754;">
                                        <small class="text-muted d-block uppercase mb-1" style="font-size: 0.75rem; font-weight: bold;">Thân nhiệt</small>
                                        <strong class="fs-5 text-dark">@(Model.Temperature?.ToString("0.0") ?? "--")</strong>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">°C</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="vital-item p-3 rounded-3 bg-light" style="border-left: 4px solid #0d6efd;">
                                        <small class="text-muted d-block uppercase mb-1" style="font-size: 0.75rem; font-weight: bold;">SpO2</small>
                                        <strong class="fs-5 text-dark">@(Model.SpO2?.ToString() ?? "--")</strong>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">%</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="vital-item p-3 rounded-3 bg-light" style="border-left: 4px solid #6f42c1;">
                                        <small class="text-muted d-block uppercase mb-1" style="font-size: 0.75rem; font-weight: bold;">Chiều cao</small>
                                        <strong class="fs-5 text-dark">@(Model.Height?.ToString() ?? "--")</strong>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">cm</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="vital-item p-3 rounded-3 bg-light" style="border-left: 4px solid #fd7e14;">
                                        <small class="text-muted d-block uppercase mb-1" style="font-size: 0.75rem; font-weight: bold;">Cân nặng</small>
                                        <strong class="fs-5 text-dark">@(Model.Weight?.ToString("0.0") ?? "--")</strong>
                                        <small class="text-muted d-block" style="font-size: 0.7rem;">kg</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Details Area -->
                <div class="col-lg-8">
                    <!-- Medical Record Info -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-stethoscope text-primary me-2"></i>Kết quả khám lâm sàng</h5>
                            <span class="badge bg-light text-primary border border-primary px-3 py-2 rounded-pill">Khám: @(Model.RecordType ?? "Thường")</span>
                        </div>
                        <div class="card-body p-4 bg-white">
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 bg-light border-0 h-100">
                                        <label class="text-muted fw-bold mb-1" style="font-size: 0.85rem;"><i class="fas fa-user-md me-1 text-primary"></i> Bác sĩ phụ trách</label>
                                        <div class="fw-bold text-dark fs-6">@Model.Doctor.FullName</div>
                                        <div class="text-muted" style="font-size: 0.85rem;">@Model.Doctor.Specialty</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 bg-light border-0 h-100">
                                        <label class="text-muted fw-bold mb-1" style="font-size: 0.85rem;"><i class="fas fa-disease me-1 text-danger"></i> Chẩn đoán ICD-10</label>
                                        <div class="fw-bold text-danger fs-6">@Model.IcdCode - @Model.IcdCodeNavigation?.DiseaseName</div>
                                        <div class="text-muted" style="font-size: 0.85rem;">Phân loại y khoa chuẩn quốc tế</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3 border-bottom pb-3">
                                <label class="text-muted fw-bold d-block mb-1"><i class="fas fa-notes-medical text-warning me-1"></i> Triệu chứng lâm sàng</label>
                                <div class="text-dark whitespace-pre" style="white-space: pre-line; line-height: 1.6;">@(Model.Symptoms ?? "Không ghi nhận")</div>
                            </div>

                            <div class="mb-3 border-bottom pb-3">
                                <label class="text-muted fw-bold d-block mb-1"><i class="fas fa-clipboard-check text-success me-1"></i> Kết luận & Hướng điều trị</label>
                                <div class="text-dark fw-bold" style="white-space: pre-line; line-height: 1.6;">@(Model.Conclusion ?? "Chưa có kết luận")</div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="mb-0">
                                    <label class="text-muted fw-bold d-block mb-1"><i class="fas fa-comment-medical text-info me-1"></i> Ghi chú dặn dò</label>
                                    <div class="text-muted bg-light p-3 rounded-3 border-start border-info border-3" style="white-space: pre-line; line-height: 1.6;">@Model.Notes</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Prescriptions Card -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                        <div class="card-header bg-success text-white py-3 px-4 border-bottom">
                            <h5 class="mb-0 fw-bold text-white"><i class="fas fa-pills me-2 text-white"></i>Đơn thuốc điều trị</h5>
                        </div>
                        <div class="card-body p-4 bg-white">
                            @if (Model.Prescriptions != null && Model.Prescriptions.Any())
                            {
                                foreach (var pres in Model.Prescriptions)
                                {
                                    <div class="mb-4 last-mb-0 border p-3 rounded-4 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                            <div>
                                                <span class="badge bg-success rounded-pill px-3 py-2">Đơn thuốc số: @pres.PrescriptionId</span>
                                                <span class="text-muted ms-2" style="font-size: 0.85rem;">Ngày kê đơn: @(pres.CreateDate?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                            </div>
                                            <div>
                                                <span class="badge bg-soft-success text-success border border-success px-3 py-2 rounded-pill">
                                                    @(pres.Status == "DaCapPhat" ? "Đã cấp phát thuốc" : (pres.Status == "ChoCapPhat" ? "Chờ cấp phát" : "Đã hủy"))
                                                </span>
                                            </div>
                                        </div>

                                        @if (pres.PrescriptionDetails != null && pres.PrescriptionDetails.Any())
                                        {
                                            <div class="table-responsive bg-white rounded-3 overflow-hidden shadow-sm">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-success text-dark">
                                                        <tr>
                                                            <th class="px-3" style="width: 50px;">#</th>
                                                            <th>Tên thuốc / Hoạt chất</th>
                                                            <th class="text-center" style="width: 100px;">Số lượng</th>
                                                            <th>Cách dùng & Liều lượng</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            int idx = 1;
                                                        }
                                                        @foreach (var detail in pres.PrescriptionDetails)
                                                        {
                                                            <tr>
                                                                <td class="text-center px-3 fw-bold">@(idx++)</td>
                                                                <td>
                                                                    <div class="fw-bold text-dark">@detail.Medicine.MedicineName</div>
                                                                    @if (!string.IsNullOrEmpty(detail.Medicine.ActiveIngredient))
                                                                    {
                                                                        <small class="text-muted">Hoạt chất: @detail.Medicine.ActiveIngredient</small>
                                                                    }
                                                                </td>
                                                                <td class="text-center fw-bold text-primary">@detail.Quantity @detail.Medicine.Unit</td>
                                                                <td class="text-dark" style="font-size: 0.95rem;">@detail.Dosage</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted text-center py-3">Đơn thuốc này chưa có chi tiết danh mục thuốc.</div>
                                        }

                                        @if (!string.IsNullOrEmpty(pres.Note))
                                        {
                                            <div class="mt-3 p-2 bg-white rounded-3 border-start border-success border-3">
                                                <small class="text-muted d-block fw-bold mb-1">Ghi chú đơn thuốc:</small>
                                                <span class="text-dark" style="font-size: 0.9rem;">@pres.Note</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5 bg-light rounded-4 text-muted">
                                    <i class="fas fa-notes-medical fs-1 mb-3 d-block"></i>
                                    Không có đơn thuốc đi kèm trong lượt khám này.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Subclinical Services Card -->
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-info text-white py-3 px-4 border-bottom">
                            <h5 class="mb-0 fw-bold text-white"><i class="fas fa-vials me-2 text-white"></i>Kết quả xét nghiệm & Cận lâm sàng</h5>
                        </div>
                        <div class="card-body p-4 bg-white">
                            @if (Model.RecordServices != null && Model.RecordServices.Any())
                            {
                                <div class="row g-4">
                                    @foreach (var rs in Model.RecordServices)
                                    {
                                        <div class="col-12">
                                            <div class="border rounded-4 p-4 bg-light shadow-sm">
                                                <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-3 flex-wrap gap-2">
                                                    <div>
                                                        <h5 class="fw-bold text-dark mb-1">@rs.Service.ServiceName</h5>
                                                        <small class="text-muted d-block"><i class="fas fa-user-md me-1"></i>Thực hiện: <strong>@rs.Doctor.FullName</strong> | Ngày: @(rs.ExecuteDate?.ToString("dd/MM/yyyy") ?? "N/A")</small>
                                                    </div>
                                                    <div>
                                                        <span class="badge bg-soft-info text-info border border-info px-3 py-2 rounded-pill">
                                                            @(rs.Status == "DaThucHien" ? "Đã thực hiện" : (rs.Status == "ChoThucHien" ? "Đang chờ" : "Đã hủy"))
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="text-muted fw-bold d-block mb-1" style="font-size: 0.85rem;"><i class="fas fa-diagnoses text-primary me-1"></i> Kết luận / Chỉ số kết quả</label>
                                                    <div class="p-3 bg-white rounded-3 border text-dark fs-6" style="min-height: 60px; line-height: 1.6; white-space: pre-line;">
                                                        @(rs.ResultValue ?? "Đang cập nhật hoặc không có kết quả chi tiết")
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(rs.ResultImages))
                                                {
                                                    <div>
                                                        <label class="text-muted fw-bold d-block mb-2" style="font-size: 0.85rem;"><i class="fas fa-images text-danger me-1"></i> Hình ảnh chẩn đoán</label>
                                                        <div class="row g-3">
                                                            @foreach (var img in rs.ResultImages.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                                            {
                                                                <div class="col-md-4 col-sm-6">
                                                                    <div class="card h-100 shadow-sm border-0 overflow-hidden rounded-3">
                                                                        <img src="@img" class="card-img-top result-diagnostic-img" style="height: 150px; object-fit: cover; cursor: zoom-in;" alt="Hình ảnh kết quả cận lâm sàng" onclick="window.open('@img', '_blank')">
                                                                        <div class="card-footer bg-transparent py-2 text-center">
                                                                            <small class="text-muted"><i class="fas fa-search-plus me-1"></i>Xem ảnh lớn</small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 bg-light rounded-4 text-muted">
                                    <i class="fas fa-procedures fs-1 mb-3 d-block"></i>
                                    Không có chỉ định cận lâm sàng hay xét nghiệm nào cho lượt khám này.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .bg-soft-primary { background-color: #e7f1ff; color: #0d6efd; }
    .bg-soft-success { background-color: #eafbea; color: #28a745; }
    .bg-soft-info { background-color: #e8f7fa; color: #0dcaf0; }
    .last-mb-0:last-child { margin-bottom: 0 !important; }
    .result-diagnostic-img {
        transition: transform 0.2s;
    }
    .result-diagnostic-img:hover {
        transform: scale(1.05);
    }
</style>
