@model IEnumerable<HTTTBenhVien.Models.MedicalRecord>
@{
    ViewData["Title"] = "Lịch sử khám bệnh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">
<div class="profile-page-wrapper" style="padding-top: 110px;">
<div class="profile-header py-5" style="background: linear-gradient(45deg, #0d6efd, #00d2ff);">
    <div class="container text-center">
        <h2 class="text-white">Lịch sử khám bệnh</h2>
        <p class="text-white-50">Theo dõi hành trình chăm sóc sức khỏe của bạn</p>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-3">
            <div class="profile-nav card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="list-group list-group-flush">
                    <a asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="fas fa-columns me-2"></i> Tổng quan
                    </a>
                    <a asp-action="MedicalHistory" class="list-group-item list-group-item-action active">
                        <i class="fas fa-history me-2"></i> Lịch sử khám bệnh
                    </a>
                    <a asp-controller="Booking" asp-action="Index" class="list-group-item list-group-item-action">
                        <i class="fas fa-calendar-plus me-2"></i> Đặt lịch khám mới
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3">Ngày khám</th>
                                <th>Chẩn đoán</th>
                                <th>Bác sĩ</th>
                                <th class="text-end px-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="fas fa-folder-open fs-1 mb-3 d-block"></i>
                                            Bạn chưa có lịch sử khám bệnh nào.
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="px-4 fw-bold">@(item.VisitDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                        <td>
                                            <span class="d-block text-primary fw-bold">@item.IcdCodeNavigation?.DiseaseName</span>
                                            <small class="text-muted">Mã ICD: @item.IcdCode</small>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="ms-2">
                                                    <div class="fw-bold">@item.Doctor?.FullName</div>
                                                    <small class="text-muted">@item.Doctor?.Specialty</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end px-4">
                                            <a asp-action="RecordDetails" asp-route-id="@item.RecordId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</main>
