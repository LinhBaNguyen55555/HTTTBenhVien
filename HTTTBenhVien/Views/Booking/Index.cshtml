@model HTTTBenhVien.Models.Appointment
@{
    ViewData["Title"] = "Đặt lịch khám";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <section class="section">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="section-title">
                        <h2>Đặt lịch khám online</h2>
                        <p>Điền thông tin bên dưới để đặt lịch khám tại bệnh viện</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="close" data-dismiss="alert">&times;</button>
                        </div>
                    }

                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <form method="post" asp-action="Index" id="bookingForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="BookingType" id="BookingType" value="self" />
                                <input type="hidden" name="SelectedRelativeId" id="SelectedRelativeId" value="" />

                                <!-- Booking Type Selector (Cards) -->
                                <div class="booking-type-selector mb-4">
                                    <label class="form-label fw-bold mb-3 d-block"><i class="fas fa-hospital-user text-primary me-2"></i>Bạn muốn đặt lịch khám cho ai?</label>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="card booking-type-card active shadow-sm h-100 border-2" data-type="self" style="cursor: pointer; border-color: #0d6efd; transition: all 0.2s;">
                                                <div class="card-body d-flex align-items-center p-3">
                                                    <div class="icon-box text-primary rounded-circle p-3 me-3" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #e7f1ff;">
                                                        <i class="fas fa-user-check fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-1 fw-bold">Đặt lịch khám cho chính mình</h6>
                                                        <small class="text-muted" style="font-size: 0.8rem;">Sử dụng thông tin tài khoản của bạn</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card booking-type-card shadow-sm h-100 border-2" data-type="relative" style="cursor: pointer; border-color: #f1f3f5; transition: all 0.2s;">
                                                <div class="card-body d-flex align-items-center p-3">
                                                    <div class="icon-box text-success rounded-circle p-3 me-3" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #eafbea;">
                                                        <i class="fas fa-users fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-1 fw-bold">Đặt lịch khám cho người thân</h6>
                                                        <small class="text-muted" style="font-size: 0.8rem;">Nhập hoặc chọn người thân của bạn</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Relative Selection Dropdown -->
                                <div class="form-group mb-4 d-none" id="relativeSelectGroup">
                                    <label class="form-label fw-bold"><i class="fas fa-user-friends text-success me-2"></i>Chọn người thân đã lưu</label>
                                    <select id="relativeSelect" class="form-select border-2">
                                        <option value="">-- Thêm người thân mới --</option>
                                        @if (ViewBag.Relatives != null)
                                        {
                                            foreach (var rel in (IEnumerable<HTTTBenhVien.Models.Patient>)ViewBag.Relatives)
                                            {
                                                <option value="@rel.PatientId" 
                                                        data-fullname="@rel.FullName" 
                                                        data-phone="@rel.Phone" 
                                                        data-email="@rel.Email"
                                                        data-dob="@(rel.Dob?.ToString("yyyy-MM-dd"))"
                                                        data-gender="@(rel.Gender.ToString().ToLower())"
                                                        data-citizenid="@rel.CitizenId"
                                                        data-bhyt="@rel.BhytCode"
                                                        data-address="@rel.Address"
                                                        data-occupation="@rel.Occupation"
                                                        data-workplace="@rel.WorkplaceOrSchool">@rel.FullName - @rel.Phone</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap border-top pt-4">
                                    <h5 class="mb-2 fw-bold text-dark"><i class="fas fa-address-card me-2 text-primary"></i> Thông tin hành chính bệnh nhân</h5>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Họ tên bệnh nhân <span class="text-danger">*</span></label>
                                            <input type="text" asp-for="Patient.FullName" class="form-control shadow-sm" placeholder="Nhập họ tên đầy đủ" required>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                            <input type="tel" asp-for="Patient.Phone" class="form-control shadow-sm" placeholder="0xxx xxx xxx" required>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" asp-for="Patient.Email" class="form-control shadow-sm" placeholder="email@example.com">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Ngày sinh</label>
                                            <input type="date" asp-for="Patient.Dob" class="form-control shadow-sm">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Giới tính</label>
                                            <select asp-for="Patient.Gender" class="form-control shadow-sm">
                                                <option value="true">Nam</option>
                                                <option value="false">Nữ</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Số CCCD / CMND</label>
                                            <input type="text" asp-for="Patient.CitizenId" class="form-control shadow-sm" placeholder="VD: 0123456789xx">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Mã thẻ BHYT</label>
                                            <input type="text" asp-for="Patient.BhytCode" class="form-control shadow-sm" placeholder="VD: GD4950...">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Địa chỉ thường trú</label>
                                            <input type="text" asp-for="Patient.Address" class="form-control shadow-sm" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/TP">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Nghề nghiệp</label>
                                            <input type="text" asp-for="Patient.Occupation" class="form-control shadow-sm" placeholder="VD: Sinh viên...">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Nơi làm việc / Trường</label>
                                            <input type="text" asp-for="Patient.WorkplaceOrSchool" class="form-control shadow-sm" placeholder="Tên cơ quan/trường">
                                        </div>
                                    </div>
                                </div>

                                <h5 class="mb-3 mt-4"><i class="fas fa-calendar me-2 text-primary"></i> Thông tin lịch khám</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Chuyên khoa <span class="text-danger">*</span></label>
                                            <select id="deptSelect" class="form-select" required>
                                                <option value="">-- Chọn chuyên khoa --</option>
                                                @if (ViewBag.Departments != null)
                                                {
                                                    foreach (var dept in (IEnumerable<HTTTBenhVien.Models.Department>)ViewBag.Departments)
                                                    {
                                                        <option value="@dept.DeptId">@dept.DeptName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Bác sĩ <span class="text-danger">*</span></label>
                                            <select asp-for="DoctorId" id="doctorSelect" class="form-select" required>
                                                <option value="">-- Chọn bác sĩ --</option>
                                                @if (ViewBag.Doctors != null)
                                                {
                                                    foreach (var doctor in (IEnumerable<HTTTBenhVien.Models.Employee>)ViewBag.Doctors)
                                                    {
                                                        <option value="@doctor.EmpId" data-dept="@doctor.DeptId">@doctor.FullName - @doctor.Specialty</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Ngày khám <span class="text-danger">*</span></label>
                                            <input type="date" asp-for="AppDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Giờ khám <span class="text-danger">*</span></label>
                                            <select asp-for="TimeSlot" class="form-select" required>
                                                <option value="">-- Chọn giờ --</option>
                                                <option value="07:00">07:00 - 08:00</option>
                                                <option value="08:00">08:00 - 09:00</option>
                                                <option value="09:00">09:00 - 10:00</option>
                                                <option value="10:00">10:00 - 11:00</option>
                                                <option value="11:00">11:00 - 12:00</option>
                                                <option value="13:00">13:00 - 14:00</option>
                                                <option value="14:00">14:00 - 15:00</option>
                                                <option value="15:00">15:00 - 16:00</option>
                                                <option value="16:00">16:00 - 17:00</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group mb-3">
                                    <label class="form-label">Lý do khám</label>
                                    <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Mô tả triệu chứng hoặc lý do khám..."></textarea>
                                </div>

                                @if (TempData["Error"] != null)
                                {
                                    <div class="alert alert-danger">@TempData["Error"]</div>
                                }

                                <div class="text-center mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        <i class="fas fa-calendar-check me-2"></i> Xác nhận đặt lịch
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Lưu ý:</strong> Sau khi đặt lịch, nhân viên bệnh viện sẽ liên hệ xác nhận trong vòng 30 phút. Nếu chưa nhận được cuộc gọi, vui lòng gọi hotline <strong>1900 1234</strong>.
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

<style>
    .section-title h2 {
        margin-top: 68px;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Lưu lại tất cả option của bác sĩ ban đầu
            var allDoctorOptions = $('#doctorSelect option:not([value=""])').clone();

            $('#deptSelect').change(function() {
                var selectedDeptId = $(this).val();
                
                // Reset select bác sĩ
                $('#doctorSelect').empty();
                $('#doctorSelect').append('<option value="">-- Chọn bác sĩ --</option>');
                
                if (selectedDeptId) {
                    // Lọc và thêm lại các bác sĩ thuộc chuyên khoa đã chọn
                    var filteredDoctors = allDoctorOptions.filter('[data-dept="' + selectedDeptId + '"]');
                    $('#doctorSelect').append(filteredDoctors);
                } else {
                    // Nếu không chọn chuyên khoa nào, hiển thị lại tất cả bác sĩ
                    $('#doctorSelect').append(allDoctorOptions);
                }
            });

            // Lọc các khung giờ khám đã trôi qua đối với ngày hôm nay
            function filterTimeSlots() {
                var selectedDateStr = $('#AppDate').val();
                if (!selectedDateStr) return;

                var selectedParts = selectedDateStr.split('-');
                var selectedDate = new Date(selectedParts[0], selectedParts[1] - 1, selectedParts[2]);
                selectedDate.setHours(0, 0, 0, 0);

                var today = new Date();
                today.setHours(0, 0, 0, 0);

                var currentTime = new Date();
                var currentHours = currentTime.getHours();
                var currentMinutes = currentTime.getMinutes();

                $('#TimeSlot option').each(function() {
                    var optionVal = $(this).val();
                    if (optionVal === "") return; // Bỏ qua placeholder

                    var parts = optionVal.split(':');
                    var slotHour = parseInt(parts[0], 10);
                    var slotMinute = parseInt(parts[1], 10);

                    if (selectedDate.getTime() === today.getTime()) {
                        // Nếu giờ của slot đã bắt đầu hoặc đã qua so với giờ hiện tại
                        if (slotHour < currentHours || (slotHour === currentHours && slotMinute <= currentMinutes)) {
                            $(this).prop('disabled', true).hide();
                        } else {
                            $(this).prop('disabled', false).show();
                        }
                    } else {
                        // Hiển thị lại tất cả slot cho ngày tương lai
                        $(this).prop('disabled', false).show();
                    }
                });

                // Nếu slot đang chọn bị disabled hoặc ẩn, reset selection
                var selectedOption = $('#TimeSlot option:selected');
                if (selectedOption.is(':disabled') || selectedOption.css('display') === 'none') {
                    $('#TimeSlot').val('');
                }
            }

            // Gọi lọc khi thay đổi ngày hoặc ngay khi load trang
            $('#AppDate').change(filterTimeSlots);
            filterTimeSlots();

            // --- Xử lý Đặt lịch khám cho Chính mình / Người thân ---
            
            // Lưu lại thông tin gốc của tài khoản chính (được load sẵn từ server)
            var mainAccountData = {
                fullName: $('#Patient_FullName').val() || '',
                phone: $('#Patient_Phone').val() || '',
                email: $('#Patient_Email').val() || '',
                dob: $('#Patient_Dob').val() || '',
                gender: $('#Patient_Gender').val() || 'true',
                citizenId: $('#Patient_CitizenId').val() || '',
                bhytCode: $('#Patient_BhytCode').val() || '',
                address: $('#Patient_Address').val() || '',
                occupation: $('#Patient_Occupation').val() || '',
                workplaceOrSchool: $('#Patient_WorkplaceOrSchool').val() || ''
            };

            function setFieldsReadOnly(isReadOnly) {
                var fields = [
                    '#Patient_FullName', '#Patient_Phone', '#Patient_Email', 
                    '#Patient_Dob', '#Patient_CitizenId', '#Patient_BhytCode', 
                    '#Patient_Address', '#Patient_Occupation', '#Patient_WorkplaceOrSchool'
                ];
                fields.forEach(function(selector) {
                    if (isReadOnly) {
                        $(selector).attr('readonly', true).css('background-color', '#f8f9fa');
                    } else {
                        $(selector).removeAttr('readonly').css('background-color', '');
                    }
                });

                // Xử lý select Giới tính
                if (isReadOnly) {
                    $('#Patient_Gender').css({
                        'pointer-events': 'none',
                        'background-color': '#f8f9fa'
                    });
                } else {
                    $('#Patient_Gender').css({
                        'pointer-events': '',
                        'background-color': ''
                    });
                }
            }

            // Thiết lập mặc định ban đầu là Đặt cho chính mình
            setFieldsReadOnly(true);

            $('.booking-type-card').click(function() {
                var type = $(this).data('type');
                
                // Cập nhật giao diện card hoạt động
                $('.booking-type-card').removeClass('active').css('border-color', '#f1f3f5');
                $(this).addClass('active');
                if (type === 'self') {
                    $(this).css('border-color', '#0d6efd');
                    $('#BookingType').val('self');
                    $('#SelectedRelativeId').val(''); // Reset selected relative ID when booking for self
                    $('#relativeSelectGroup').addClass('d-none');
                    
                    // Điền lại thông tin chính mình và khóa lại
                    fillPatientFields(mainAccountData);
                    setFieldsReadOnly(true);
                } else {
                    $(this).css('border-color', '#198754'); // Màu xanh lá cho người thân
                    $('#BookingType').val('relative');
                    $('#relativeSelectGroup').removeClass('d-none');
                    
                    // Mở khóa các trường để chỉnh sửa hoặc nhập mới
                    setFieldsReadOnly(false);
                    
                    // Kích hoạt thay đổi dropdown người thân để cập nhật trường dữ liệu
                    $('#relativeSelect').trigger('change');
                }
            });

            // Xử lý khi chọn dropdown người thân đã lưu
            $('#relativeSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var val = $(this).val();

                // Cập nhật SelectedRelativeId
                $('#SelectedRelativeId').val(val);

                if (val === "") {
                    // Thêm người thân mới -> Xóa sạch các trường để điền mới
                    var emptyData = {
                        fullName: '',
                        phone: '',
                        email: '',
                        dob: '',
                        gender: 'true',
                        citizenId: '',
                        bhytCode: '',
                        address: '',
                        occupation: '',
                        workplaceOrSchool: ''
                    };
                    fillPatientFields(emptyData);
                } else {
                    // Chọn người thân đã lưu -> Tự động điền dữ liệu
                    var relativeData = {
                        fullName: selectedOption.data('fullname') || '',
                        phone: selectedOption.data('phone') || '',
                        email: selectedOption.data('email') || '',
                        dob: selectedOption.data('dob') || '',
                        gender: selectedOption.data('gender') === 'false' ? 'false' : 'true',
                        citizenId: selectedOption.data('citizenid') || '',
                        bhytCode: selectedOption.data('bhyt') || '',
                        address: selectedOption.data('address') || '',
                        occupation: selectedOption.data('occupation') || '',
                        workplaceOrSchool: selectedOption.data('workplace') || ''
                    };
                    fillPatientFields(relativeData);
                }
            });

            function fillPatientFields(data) {
                $('#Patient_FullName').val(data.fullName);
                $('#Patient_Phone').val(data.phone);
                $('#Patient_Email').val(data.email);
                $('#Patient_Dob').val(data.dob);
                $('#Patient_Gender').val(data.gender);
                $('#Patient_CitizenId').val(data.citizenId);
                $('#Patient_BhytCode').val(data.bhytCode);
                $('#Patient_Address').val(data.address);
                $('#Patient_Occupation').val(data.occupation);
                $('#Patient_WorkplaceOrSchool').val(data.workplaceOrSchool);
            }
        });
    </script>
}
