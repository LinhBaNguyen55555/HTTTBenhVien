@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">
    <section class="screening-section section">
        <div class="container" data-aos="fade-up">
            <div class="header-box text-center mb-5 p-5 rounded-5 shadow-sm bg-white border-bottom border-primary border-5">
                <h1 class="text-primary mb-3">Tầm soát ung thư sớm</h1>
                <p class="lead text-muted mx-auto" style="max-width: 800px;">
                    Phát hiện sớm là chìa khóa vàng trong điều trị ung thư. Bệnh viện Đại học Vinh cung cấp các giải pháp tầm soát chuyên sâu, chính xác bằng công nghệ hiện đại nhất.
                </p>
                <div class="mt-4 d-flex justify-content-center gap-3">
                    <span class="badge bg-danger p-2 px-3 rounded-pill"><i class="bi bi-shield-fill-check me-1"></i> Chính xác 99%</span>
                    <span class="badge bg-info p-2 px-3 rounded-pill text-dark"><i class="bi bi-cpu-fill me-1"></i> Công nghệ AI</span>
                    <span class="badge bg-success p-2 px-3 rounded-pill"><i class="bi bi-people-fill me-1"></i> Chuyên gia đầu ngành</span>
                </div>
            </div>

            <div class="row g-4">
                <!-- Nam giới -->
                <div class="col-lg-6">
                    <div class="screening-card male h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="icon-box bg-primary text-white rounded-circle p-3 me-3">
                                    <i class="bi bi-gender-male fs-3"></i>
                                </div>
                                <h2 class="h3 mb-0 fw-bold">Dành cho Nam giới</h2>
                            </div>
                            <div class="service-list">
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Phổi (CT liều thấp)</span>
                                    <span class="fw-bold text-primary">1.800.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Gan (AFP + Siêu âm)</span>
                                    <span class="fw-bold text-primary">650.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Đại trực tràng</span>
                                    <span class="fw-bold text-primary">2.200.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Tuyến tiền liệt</span>
                                    <span class="fw-bold text-primary">850.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3">
                                    <span>Gói Tầm soát Toàn diện (Nam)</span>
                                    <span class="fw-bold text-danger">6.500.000đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nữ giới -->
                <div class="col-lg-6">
                    <div class="screening-card female h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="icon-box bg-pink text-white rounded-circle p-3 me-3">
                                    <i class="bi bi-gender-female fs-3"></i>
                                </div>
                                <h2 class="h3 mb-0 fw-bold">Dành cho Nữ giới</h2>
                            </div>
                            <div class="service-list">
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Vú (Nhũ ảnh + Siêu âm)</span>
                                    <span class="fw-bold text-primary">1.200.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Cổ tử cung (Thinprep)</span>
                                    <span class="fw-bold text-primary">950.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Tầm soát Ung thư Tuyến giáp</span>
                                    <span class="fw-bold text-primary">550.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <span>Xét nghiệm HPV định tuýp</span>
                                    <span class="fw-bold text-primary">1.100.000đ</span>
                                </div>
                                <div class="service-item d-flex justify-content-between align-items-center p-3">
                                    <span>Gói Tầm soát Toàn diện (Nữ)</span>
                                    <span class="fw-bold text-danger">7.200.000đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cta-banner mt-5 p-5 rounded-5 text-white shadow-lg d-flex align-items-center justify-content-between overflow-hidden position-relative">
                <div class="cta-content position-relative z-1">
                    <h2 class="fw-bold mb-3">Đừng để quá muộn!</h2>
                    <p class="mb-0 fs-5">Đăng ký tầm soát ngay hôm nay để bảo vệ tương lai của bạn và gia đình.</p>
                </div>
                <div class="cta-actions position-relative z-1">
                    <a href="@Url.Action("Index", "Booking")" class="btn btn-light btn-lg px-5 rounded-pill fw-bold text-primary shadow">Đặt lịch khám ngay</a>
                </div>
                <div class="banner-bg-decor"></div>
            </div>
        </div>
    </section>
</main>

<style>
    .screening-section {
        padding: 140px 0 100px;
        background-color: #fdfdfd;
    }

    .bg-pink { background-color: #e83e8c; }

    .screening-card {
        background: #fff;
        border-radius: 24px;
        transition: transform 0.3s ease;
    }

    .screening-card:hover {
        transform: translateY(-8px);
    }

    .screening-card.male { border-left: 6px solid #175cdd !important; }
    .screening-card.female { border-left: 6px solid #e83e8c !important; }

    .service-item span:first-child {
        color: #444;
        font-weight: 500;
    }

    .cta-banner {
        background: linear-gradient(135deg, #112344 0%, #175cdd 100%);
    }

    .banner-bg-decor {
        position: absolute;
        top: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
    }

    .banner-bg-decor::before {
        content: '';
        position: absolute;
        bottom: -100px;
        left: -300px;
        width: 400px;
        height: 400px;
        background: rgba(255,255,255,0.05);
        border-radius: 50%;
    }

    @@media (max-width: 768px) {
        .cta-banner {
            flex-direction: column;
            text-align: center;
            gap: 30px;
        }
    }
</style>
