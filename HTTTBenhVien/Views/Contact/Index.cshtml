@model HTTTBenhVien.Models.Contact
@{
    ViewData["Title"] = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <section class="section">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>Liên hệ</h2>
                <p>Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            }

            <div class="row">
                <div class="col-lg-4">
                    <div class="contact-info-card">
                        <div class="contact-item">
                            <div class="icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div>
                                <h5>Địa chỉ</h5>
                                <p>Số 192 Lê Duẩn, Phường Trường Vinh, Tỉnh Nghệ An</p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="icon"><i class="fas fa-phone-alt"></i></div>
                            <div>
                                <h5>Hotline</h5>
                                <p>1900 1234<br><small class="text-muted">Hỗ trợ 24/7</small></p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="icon"><i class="fas fa-envelope"></i></div>
                            <div>
                                <h5>Email</h5>
                                <p>benhvien@httt.vn</p>
                            </div>
                        </div>
                        <div class="contact-item">
                            <div class="icon"><i class="fas fa-clock"></i></div>
                            <div>
                                <h5>Giờ làm việc</h5>
                                <p>Thứ 2 - Thứ 6: 7:00 - 17:00<br>Thứ 7: 7:00 - 12:00<br>Chủ nhật: Nghỉ</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h4 class="mb-4"><i class="fas fa-paper-plane text-primary me-2"></i> Gửi tin nhắn</h4>
                            <form method="post" asp-action="Index">
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                                            <input type="text" asp-for="FullName" class="form-control" required placeholder="Nhập họ tên của bạn">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label">Email <span class="text-danger">*</span></label>
                                            <input type="email" asp-for="Email" class="form-control" required placeholder="email@example.com">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Số điện thoại</label>
                                    <input type="tel" asp-for="Phone" class="form-control" placeholder="0xxx xxx xxx">
                                </div>
                                <div class="form-group mb-3">
                                    <label class="form-label">Tiêu đề <span class="text-danger">*</span></label>
                                    <input type="text" asp-for="Subject" class="form-control" required placeholder="Nhập tiêu đề">
                                </div>
                                <div class="form-group mb-4">
                                    <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                                    <textarea asp-for="MessageContent" class="form-control" rows="5" required placeholder="Nhập nội dung tin nhắn..."></textarea>
                                </div>
                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        <i class="fas fa-paper-plane me-2"></i> Gửi tin nhắn
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="map-section mt-5">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3780.2644211136456!2d105.69233067464016!3d18.663389464764835!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3139ce6660d19597%3A0x94060851f5038b3a!2zMTkyIEzDqiBEdXhuLCBC4bq_biBUaOG7p3ksIFRow6gbmggcGjhu5EgVmluaCwgTmdow6rMgSBBbiwgVmnhu4d0IE5hbQ!5e0!3m2!1svi!2s!4v1715194500000!5m2!1svi!2s" width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>
<style>
    .section-title h2 {
        margin-top: 68px;
    }
</style>
