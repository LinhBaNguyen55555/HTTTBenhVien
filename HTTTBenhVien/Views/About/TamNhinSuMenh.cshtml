@{
    ViewData["Title"] = "Tầm nhìn & Sứ mệnh";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <section id="vision-mission" class="about section">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>Tầm nhìn & Sứ mệnh</h2>
                <p>Giá trị cốt lõi và định hướng phát triển</p>
            </div>

            <div class="row align-items-center mb-5">
                <div class="col-lg-6">
                    <div class="vision-box p-4 rounded-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="vision-icon me-3">
                                <i class="fas fa-eye fa-2x"></i>
                            </div>
                            <h3 class="mb-0">Tầm nhìn</h3>
                        </div>
                        <p class="mb-0 fs-5">Trở thành hệ thống y tế hàng đầu Việt Nam, mang đến dịch vụ chăm sóc sức khỏe toàn diện với chất lượng quốc tế.</p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="mission-box p-4 rounded-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="mission-icon me-3">
                                <i class="fas fa-bullseye fa-2x"></i>
                            </div>
                            <h3 class="mb-0">Sứ mệnh</h3>
                        </div>
                        <p class="mb-0 fs-5">Cung cấp dịch vụ y tế chất lượng cao, an toàn và hiệu quả cho mọi đối tượng. Xây dựng môi trường y tế chuyên nghiệp, thân thiện nơi bệnh nhân được tôn trọng và quan tâm.</p>
                    </div>
                </div>
            </div>

            <div class="section-title mt-5">
                <h3>Giá trị cốt lõi</h3>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="value-card p-4 text-center rounded-4 h-100">
                        <div class="value-icon mb-3">
                            <i class="fas fa-heart fa-2x"></i>
                        </div>
                        <h5>An toàn bệnh nhân</h5>
                        <p class="text-muted mb-0">Luôn đặt sự an toàn và lợi ích của bệnh nhân lên hàng đầu</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="value-card p-4 text-center rounded-4 h-100">
                        <div class="value-icon mb-3">
                            <i class="fas fa-award fa-2x"></i>
                        </div>
                        <h5>Chất lượng</h5>
                        <p class="text-muted mb-0">Không ngừng nâng cao chất lượng dịch vụ y tế</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="value-card p-4 text-center rounded-4 h-100">
                        <div class="value-icon mb-3">
                            <i class="fas fa-hands-helping fa-2x"></i>
                        </div>
                        <h5>Tận tâm</h5>
                        <p class="text-muted mb-0">Đội ngũ y bác sĩ tận tâm với nghề, yêu thương bệnh nhân</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="value-card p-4 text-center rounded-4 h-100">
                        <div class="value-icon mb-3">
                            <i class="fas fa-balance-scale fa-2x"></i>
                        </div>
                        <h5>Chính trực</h5>
                        <p class="text-muted mb-0">Hành xử trung thực, minh bạch trong mọi hoàn cảnh</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="value-card p-4 text-center rounded-4 h-100">
                        <div class="value-icon mb-3">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                        <h5>Hợp tác</h5>
                        <p class="text-muted mb-0">Làm việc theo tinh thần đồng đội, phối hợp liên khoa hiệu quả</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="value-card p-4 text-center rounded-4 h-100">
                        <div class="value-icon mb-3">
                            <i class="fas fa-lightbulb fa-2x"></i>
                        </div>
                        <h5>Đổi mới</h5>
                        <p class="text-muted mb-0">Cập nhật và ứng dụng các kỹ thuật y khoa tiên tiến</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h3>Cơ sở vật chất</h3>
                    <p>Tìm hiểu về hạ tầng và trang thiết bị hiện đại của bệnh viện.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="@Url.Action("CoSoVatChat", "GioiThieu")" class="btn btn-light btn-lg">Xem thêm</a>
                </div>
            </div>
        </div>
    </section>

</main>

