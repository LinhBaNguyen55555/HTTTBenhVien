@{
    ViewData["Title"] = "Cơ sở vật chất";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <section id="facilities" class="about section">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>Cơ sở vật chất</h2>
                <p>Hạ tầng hiện đại, trang thiết bị tiên tiến</p>
            </div>

            <div class="row align-items-center mb-5">
                <div class="col-lg-6">
                    <img src="~/assets/img/facilities/building.jpg" alt="Toàn cảnh bệnh viện" class="img-fluid rounded shadow" onerror="this.src='https://placehold.co/600x400?text=Toàn+cảnh+bệnh+viện'">
                </div>
                <div class="col-lg-6">
                    <h3>Tổng quan cơ sở vật chất</h3>
                    <p class="lead">Bệnh viện có tổng diện tích sử dụng hơn 10.000m² với các khu vực chức năng được quy hoạch khoa học, hiện đại.</p>
                    <ul class="facility-list">
                        <li><i class="fas fa-hospital-alt text-primary me-2"></i> Tổng số giường bệnh: 200 giường</li>
                        <li><i class="fas fa-door-open text-primary me-2"></i> 12 phòng mổ hiện đại</li>
                        <li><i class="fas fa-stethoscope text-primary me-2"></i> 50 phòng khám chuyên khoa</li>
                        <li><i class="fas fa-ambulance text-primary me-2"></i> 5 xe cấp cứu trang bị đầy đủ</li>
                        <li><i class="fas fa-parking text-primary me-2"></i> Bãi đỗ xe rộng rãi 2.000m²</li>
                    </ul>
                </div>
            </div>

            <div class="row g-4 mt-4">
                <div class="col-lg-4 col-md-6">
                    <div class="facility-card">
                        <div class="facility-icon">
                            <i class="fas fa-procedures"></i>
                        </div>
                        <h4>Khu điều trị</h4>
                        <p>8 khu điều trị với phòng bệnh 1-6 giường, điều hòa trung tâm, hệ thống call护士, tivi, wifi miễn phí.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="facility-card">
                        <div class="facility-icon">
                            <i class="fas fa-x-ray"></i>
                        </div>
                        <h4>Khu chẩn đoán</h4>
                        <p>Hệ thống MRI, CT Scanner, X-quang kỹ thuật số, siêu âm 4D, nội soi các loại.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="facility-card">
                        <div class="facility-icon">
                            <i class="fas fa-syringe"></i>
                        </div>
                        <h4>Phòng mổ</h4>
                        <p>12 phòng mổ vô trùng tiêu chuẩn quốc tế, trang bị robot phẫu thuật, hệ thống gây mê hiện đại.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="facility-card">
                        <div class="facility-icon">
                            <i class="fas fa-flask"></i>
                        </div>
                        <h4>Xét nghiệm</h4>
                        <p>Phòng xét nghiệm tự động hóa với hệ thống máy phân tích sinh hóa, huyết học hiện đại.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="facility-card">
                        <div class="facility-icon">
                            <i class="fas fa-utensils"></i>
                        </div>
                        <h4>Khu bếp</h4>
                        <p>Nhà bếp đạt chuẩn vệ sinh an toàn thực phẩm, cung cấp suất ăn dinh dưỡng cho bệnh nhân.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="facility-card">
                        <div class="facility-icon">
                            <i class="fas fa-tree"></i>
                        </div>
                        <h4>Cảnh quan</h4>
                        <p>Khu vườn cây xanh, khu nghỉ ngơi cho người nhà bệnh nhân, không gian thoáng mát.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="stats-section">
        <div class="container">
            <div class="row text-center">
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="stat-box">
                        <i class="fas fa-building fa-2x mb-3"></i>
                        <h2>10.000<span class="text-small">m²</span></h2>
                        <p>Tổng diện tích</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="stat-box">
                        <i class="fas fa-bed fa-2x mb-3"></i>
                        <h2>200</h2>
                        <p>Giường bệnh</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="stat-box">
                        <i class="fas fa-microscope fa-2x mb-3"></i>
                        <h2>50+</h2>
                        <p>Thiết bị y tế</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="stat-box">
                        <i class="fas fa-car fa-2x mb-3"></i>
                        <h2>2.000<span class="text-small">m²</span></h2>
                        <p>Bãi đỗ xe</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h3>Đặt lịch khám ngay</h3>
                    <p>Trải nghiệm dịch vụ y tế chất lượng cao tại bệnh viện của chúng tôi.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="@Url.Action("Index", "DatLich")" class="btn btn-light btn-lg">Đặt lịch khám</a>
                </div>
            </div>
        </div>
    </section>

</main>

