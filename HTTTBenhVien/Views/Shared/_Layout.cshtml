    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Patient"))
    {
        <script>
            (function() {
                var bellWrapper = document.getElementById('bellNotificationWrapper');
                var bellBtn = document.getElementById('bellNotificationBtn');
                var bellDropdown = document.getElementById('bellNotificationDropdown');
                var bellBadge = document.getElementById('bellNotificationBadge');
                var bellList = document.getElementById('bellNotificationList');
                var bellCountText = document.getElementById('bellNotificationCountText');

                if (!bellBtn || !bellDropdown) return;

                var currentNotifications = [];

                function getReadIds() {
                    try {
                        return JSON.parse(localStorage.getItem('read_notifications') || '[]');
                    } catch (e) {
                        return [];
                    }
                }

                function markAsRead(id) {
                    var readIds = getReadIds();
                    if (!readIds.includes(id)) {
                        readIds.push(id);
                        localStorage.setItem('read_notifications', JSON.stringify(readIds));
                    }
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return str.toString()
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#039;");
                }

                // Register event listeners immediately so that click works even if fetching fails
                bellBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var isHidden = bellDropdown.classList.contains('d-none');
                    if (isHidden) {
                        bellDropdown.classList.remove('d-none');
                    } else {
                        bellDropdown.classList.add('d-none');
                    }
                });

                document.addEventListener('click', function(e) {
                    if (!bellDropdown.contains(e.target) && !bellBtn.contains(e.target)) {
                        bellDropdown.classList.add('d-none');
                    }
                });

                function loadNotifications() {
                    fetch('/Profile/GetNotifications')
                        .then(function(response) {
                            if (!response.ok) {
                                throw new Error('HTTP error status ' + response.status);
                            }
                            return response.json();
                        })
                        .then(function(res) {
                            if (res && res.success && Array.isArray(res.data)) {
                                currentNotifications = res.data;
                                var readIds = getReadIds();
                                
                                // Count only UNREAD notifications for the badge
                                var unreadCount = 0;
                                currentNotifications.forEach(function(item) {
                                    if (!readIds.includes(item.appointmentId)) {
                                        unreadCount++;
                                    }
                                });
                                
                                // Update badge
                                if (unreadCount > 0) {
                                    bellBadge.textContent = unreadCount;
                                    bellBadge.classList.remove('d-none');
                                    bellBadge.classList.add('pulse-badge');
                                    bellCountText.textContent = unreadCount + " mới";
                                } else {
                                    bellBadge.classList.add('d-none');
                                    bellBadge.classList.remove('pulse-badge');
                                    bellCountText.textContent = "0 mới";
                                }

                                // Render items
                                if (currentNotifications.length > 0) {
                                    var html = '';
                                    currentNotifications.forEach(function(item, idx) {
                                        var pName = escapeHtml(item.patientName || '');
                                        var dName = escapeHtml(item.doctorName || 'Bác sĩ phòng khám');
                                        var appDate = escapeHtml(item.date || '');
                                        var appTime = escapeHtml(item.time || '');
                                        var isRead = readIds.includes(item.appointmentId);
                                        var readClass = isRead ? 'noti-read' : '';

                                        var iconStyle = isRead ? 'background-color: #f0f0f0; color: #6c757d;' : 'background-color: #eafbea; color: #28a745;';
                                        var checkIconClass = isRead ? 'fa-check text-secondary' : 'fa-check-circle text-success';
                                        var textClass = isRead ? 'text-secondary' : 'text-success fw-bold';
                                        var runIcon = isRead ? 'fa-check-double me-1' : 'fa-running me-1';
                                        var runText = isRead ? 'Đã xem chi tiết' : 'Đến thẳng phòng khám';

                                        html += `
                                        <div class="noti-item-custom p-3 border-bottom position-relative ${readClass}" data-index="${idx}">
                                            <div class="d-flex gap-3">
                                                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; ${iconStyle}">
                                                    <i class="fas ${checkIconClass} fa-lg"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.85rem;">Lịch hẹn được xác thực!</h6>
                                                    <p class="text-muted mb-1 small" style="line-height: 1.4; font-size: 0.78rem;">
                                                        Bệnh nhân <strong>${pName}</strong> có lịch khám vào <strong>${appDate}</strong> (${appTime}) đã được bộ phận tiếp nhận xác thực từ xa thành công.
                                                    </p>
                                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                                        <span class="${textClass}" style="font-size: 0.75rem;"><i class="fas ${runIcon}"></i>${runText}</span>
                                                        <span class="text-muted" style="font-size: 0.7rem;"><i class="far fa-clock me-1"></i>Hôm nay</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>`;
                                    });
                                    bellList.innerHTML = html;

                                    // Add click event to each item to view details
                                    bellList.querySelectorAll('.noti-item-custom').forEach(function(el) {
                                        el.addEventListener('click', function() {
                                            var idx = parseInt(this.getAttribute('data-index'), 10);
                                            var data = currentNotifications[idx];
                                            if (data) {
                                                // Fill detail modal
                                                document.getElementById('notiPatientName').textContent = data.patientName || '';
                                                document.getElementById('notiAppDate').textContent = data.date || '';
                                                document.getElementById('notiTimeSlot').textContent = data.time || '';
                                                document.getElementById('notiDoctorName').textContent = data.doctorName || 'Bác sĩ phòng khám';
                                                document.getElementById('notiDoctorRoomName').textContent = data.doctorName || 'Bác sĩ phòng khám';

                                                // Mark as read in localStorage
                                                markAsRead(data.appointmentId);

                                                // Open modal using Bootstrap API safely
                                                var modalEl = document.getElementById('notiDetailsModal');
                                                if (modalEl) {
                                                    var myModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                                                    myModal.show();
                                                }

                                                // Close dropdown
                                                bellDropdown.classList.add('d-none');

                                                // Re-load notifications to update styling & badge in real-time
                                                loadNotifications();
                                            }
                                        });
                                    });
                                } else {
                                    bellList.innerHTML = `
                                    <div class="p-4 text-center text-muted">
                                        <i class="fas fa-bell-slash fa-2x mb-2 text-gray-300"></i>
                                        <p class="mb-0 small">Bạn không có thông báo mới nào.</p>
                                    </div>`;
                                }
                            } else {
                                throw new Error('Invalid response format');
                            }
                        })
                        .catch(function(error) {
                            console.error('Error loading notifications:', error);
                            if (bellList) {
                                bellList.innerHTML = `
                                <div class="p-4 text-center text-danger">
                                    <i class="fas fa-exclamation-circle fa-2x mb-2"></i>
                                    <p class="mb-0 small">Lỗi tải thông báo.</p>
                                </div>`;
                            }
                        });
                }

                // Initial load
                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", loadNotifications);
                } else {
                    loadNotifications();
                }

                // Poll every 15s to be responsive
                setInterval(loadNotifications, 15000);
            })();
        </script>
    }

    @await Html.PartialAsync("_ChatbotWidget")
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
