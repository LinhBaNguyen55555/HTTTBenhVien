<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - VinhUniHospital</title>
    <meta name="description" content="Hệ thống Quản lý Thông tin Bệnh viện - Chăm sóc sức khỏe chuyên nghiệp">
    <meta name="keywords" content="bệnh viện, khám bệnh, đặt lịch khám, bác sĩ, chuyên khoa">

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
      rel="stylesheet">

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <link href="~/assets/css/main.css" rel="stylesheet">
    <link href="~/assets/css/_news_article.css" rel="stylesheet">
    <style>
        /* Styling for Topbar Notification Bell */
        #bellNotificationWrapper {
            display: inline-block;
        }
        #bellNotificationBtn {
            transition: color 0.3s, transform 0.2s;
            cursor: pointer;
        }
        #bellNotificationBtn:hover {
            color: #00d2ff !important;
            transform: scale(1.1);
        }
        #bellNotificationDropdown {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
            border: 1px solid rgba(0,0,0,0.08) !important;
            animation: dropdownFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        #bellNotificationDropdown:not(.d-none) {
            display: block !important;
        }
        @@keyframes dropdownFadeIn {
            from { opacity: 0; transform: translateY(10px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .noti-item-custom {
            transition: background-color 0.2s;
            cursor: pointer;
        }
        .noti-item-custom:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        .noti-item-custom.noti-read {
            opacity: 0.65;
            background-color: #fafafa;
        }
        .noti-item-custom.noti-read:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }
        .bg-soft-success {
            background-color: #eafbea;
            color: #28a745;
        }
        .animate-bell {
            display: inline-block;
        }
        #bellNotificationWrapper:hover .animate-bell {
            animation: topbarBellRing 0.8s ease-in-out;
        }
        @@keyframes topbarBellRing {
            0%, 100% { transform: rotate(0); }
            15% { transform: rotate(15deg); }
            30% { transform: rotate(-15deg); }
            45% { transform: rotate(10deg); }
            60% { transform: rotate(-10deg); }
            75% { transform: rotate(4deg); }
            90% { transform: rotate(-4deg); }
        }
        .pulse-badge {
            animation: badgePulse 2s infinite;
        }
        @@keyframes badgePulse {
            0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
            70% { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0); }
            100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
        }
    </style>
</head>

<body class="index-page">

