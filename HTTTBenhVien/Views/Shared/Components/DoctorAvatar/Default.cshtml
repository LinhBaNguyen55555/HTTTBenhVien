<img src="@Model.AvatarUrl"
     alt="@Model.FullName"
     class="@Model.CssClass"
     style="width: 200px; height: 200px; object-fit: cover; border-radius: 50%;"
     onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName)&size=200&background=0D8ABC&color=fff&font-size=0.4&bold=true';" />
